def choose (cancel : Bool) : NativeGoldBatchPcsProgram.Scheduler Unit := fun work _ _ =>
  .pure (if cancel then none else if positive : 0 < work.jobs.length then some ⟨0,positive⟩ else none,())
def tag : NativeGoldBatchPcsProgram.Outcome Unit → ℕ
  | .prior _ => 0
  | .completed _ completion => match completion.status with
    | .accepted _ => 1
    | .columns => 2
    | .claim .indexingUnavailable => 3
    | .claim (.claim .finish) => 4
    | .claim (.claim .claim) => 5
    | .suspended => 6

def authReplay (result : NativeGoldBatchPcsProgram.Outcome Unit × List Observation) : Option Bool := match result.1 with
  | .prior _ => none
  | .completed work _ => match work.jobs with
    | [] => none
    | job::_ => simulateQ (JointHashCache.project result.2).cache.toPartialImpl
        (NativeGoldColumnWorker.authentication work.geometry.height job.index work.root job.column)

def groupChecks (result : NativeGoldBatchPcsProgram.Outcome Unit × List Observation) : List Bool := match result.1 with
  | .prior _ => []
  | .completed work _ => match work.jobs with
    | [] => []
    | job::_ => work.groups.map (fun response => NativeGoldColumnChecks.check work.geometry work.width work.random response.1 work.test response.2 job.column.values.val job.index)

