+//@ charon-args=--monomorphize
+//@ charon-args=--inline-function crate::adjust --inline-function core::option::_::and_then
+//@ charon-args=--include core::option --include core::result
+// The selected helper must preserve mutation, early return and overflow abort.
+#[inline(never)]
+fn adjust(slot: &mut u32, increment: u32) -> Result<u32, ()> {
+    if increment == 0 {
+        return Err(());
+    }
+    let previous = *slot;
+    *slot = previous + increment;
+    Ok(previous)
+}
+
+pub fn twice(slot: &mut u32, left: u32, right: u32) -> Result<(u32, u32), ()> {
+    let first = adjust(slot, left)?;
+    let second = adjust(slot, right)?;
+    Ok((first, second))
+}
+
+// This is the hidden shared-region shape used by the constructor's closures.
+pub fn capture(value: Option<usize>, factor: &usize) -> Option<usize> {
+    value.and_then(|n| n.checked_mul(*factor))
+}
+
+// A no-op closure drop may disappear; a destructor with a write must remain.
+struct Tracked<'a>(&'a mut u32);
+impl Drop for Tracked<'_> {
+    fn drop(&mut self) { *self.0 += 1; }
+}
+pub fn capture_destructor(value: Option<u32>, counter: &mut u32) -> Option<u32> {
+    let tracked = Tracked(counter);
+    value.and_then(move |n| { let _borrow = &tracked; Some(n) })
+}
