+// The selected helper must preserve mutation, early return and overflow abort.
+#[inline(never)]
+fn adjust(slot: &mut u32, increment: u32) -> Result<u32, ()> {
+    if increment == 0 {
+        return Err(());
+    }
+    let previous = *slot;
+    *slot = previous + increment;
+    Ok(previous)
