+(* Aeneas runtime field types erase every lifetime, including 'static.
+   Charon's generic substitution erases region variables but preserves 'static. *)
+let type_decl_get_instantiated_field_etypes def opt_variant_id generics =
+  let erase =
+    object
+      inherit [_] map_ty
+      method! visit_region _ _ = RErased
+    end
+  in
+  List.map (erase#visit_ty ())
+    (type_decl_get_instantiated_field_types def opt_variant_id generics)
+
