+(** Symbolic execution requires signature lifetimes to be named. In particular,
+    full monomorphization may leave erased regions embedded in closure types.
+    Reject that unsupported input before interpreting any branch; do not infer
+    lifetime or alias relationships from erased annotations. *)
+let validate_signature_regions (_crate : crate) (f : fun_decl) : fun_decl =
+  if Config.backend () = Config.Lean then (
+    let visitor =
+      object
+        inherit [_] iter_ty
+
+        method! visit_RErased _ =
+          [%craise] f.item_meta.span
+            "Signature regions: erased lifetimes require lifetime-preserving \
+             extraction"
+
+        method! visit_RBody _ _ =
+          [%craise] f.item_meta.span
+            "Signature regions: body lifetimes are not valid signature \
+             parameters"
+      end
+    in
+    List.iter (visitor#visit_ty ()) f.signature.inputs;
+    visitor#visit_ty () f.signature.output);
+  f
+
+(* Word64 mappings are restricted to exact compiler intrinsic declarations,
+   including references stored in function-pointer constants. Other functions
+   and globals keep original source bindings in this mode. *)
+let validate_word64_intrinsics (crate : crate) (f : fun_decl) : fun_decl =
+  if not !Config.target_word64 then f
+  else
+    let mctx = NameMatcher.ctx_from_crate crate in
+    let selected decl =
+      List.find_opt
+        (fun name ->
+          NameMatcher.match_name mctx
+            {
+              map_vars_to_vars = true;
+              match_with_trait_decl_refs =
+                Config.match_patterns_with_trait_decl_refs;
+            }
+            (NameMatcher.parse_pattern ("core::intrinsics::" ^ name))
+            (strip_target_or_instantiated_suffix decl.item_meta.name))
+        [ "ctlz_nonzero"; "ctpop" ]
+    in
+    let validate decl =
+      match selected decl with
+      | None -> ()
+      | Some name ->
+          let valid =
+            match (List.rev decl.item_meta.name, decl.body) with
+            | PeInstantiated binder :: _, IntrinsicBody (actual, _) ->
+                actual = name
+                && !Config.monomorphic_builtin_shapes
+                && binder.binder_params = empty_generic_params
+                && binder.binder_value
+                   = {
+                       empty_generic_args with
+                       types = [ TLiteral (TUInt Usize) ];
+                     }
+                && decl.generics = empty_generic_params
+                && decl.signature.is_unsafe = (name = "ctlz_nonzero")
+                && decl.signature.abi = AbiRust
+                && (not decl.signature.is_variadic)
+                && decl.signature.inputs = [ TLiteral (TUInt Usize) ]
+                && decl.signature.output = TLiteral (TUInt U32)
+            | _ -> false
+          in
+          [%cassert] f.item_meta.span valid
+            "Word64 bit-count intrinsic requires an exact monomorphic \
+             usize-to-u32 compiler intrinsic and Rust ABI/safety"
+    in
+    validate f;
+    let visitor =
+      object
+        inherit [_] map_statement as super
+
+        method! visit_fn_ptr env ptr =
+          (match ptr.kind with
+          | FunId (FRegular id) -> (
+              match FunDeclId.Map.find_opt id crate.fun_decls with
+              | Some decl when selected decl <> None ->
+                  validate decl;
+                  [%cassert] f.item_meta.span
+                    (ptr.generics = empty_generic_args)
+                    "Word64 bit-count intrinsic reference must have no \
+                     remaining generic arguments"
+              | _ -> ())
+          | _ -> ());
+          super#visit_fn_ptr env ptr
+      end
+    in
+    match f.body with
+    | StructuredBody body ->
+        {
+          f with
+          body =
+            StructuredBody { body with body = visitor#visit_block () body.body };
+        }
+    | _ -> f
+
+(** Slice word64 admits only the original monomorphic slice-length lang item;
+    typed array conversions and unsupported builtin ranges remain rejected. *)
+let validate_word64_slices (crate : crate) (f : fun_decl) : fun_decl =
+  if not !Config.word64_slices then f
+  else
+    let mctx = NameMatcher.ctx_from_crate crate in
+    let selected decl =
+      NameMatcher.match_name mctx
+        {
+          map_vars_to_vars = true;
+          match_with_trait_decl_refs =
+            Config.match_patterns_with_trait_decl_refs;
+        }
+        (NameMatcher.parse_pattern "core::slice::{[u8]}::len")
+        (strip_target_or_instantiated_suffix decl.item_meta.name)
+    in
+    let validate decl =
+      if selected decl then
+        [%cassert] decl.item_meta.span
+          (decl.item_meta.lang_item = Some "slice_len_fn"
+          && List.length decl.generics.regions = 1
+          && decl.generics.types = []
+          && decl.generics.const_generics = []
+          && decl.generics.trait_clauses = []
+          && (not decl.signature.is_unsafe)
+          && (not decl.signature.is_variadic)
+          && decl.signature.abi = AbiRust
+          && decl.signature.output = TLiteral (TUInt Usize)
+          &&
+          match decl.signature.inputs with
+          | [ TRef (_, TSlice (TLiteral (TUInt U8)), RShared) ] -> true
+          | _ -> false)
+          "Word64 slice length requires the original monomorphic slice_len_fn \
+           shared signature and Rust ABI"
+    in
+    validate f;
+    let visitor =
+      object
+        inherit [_] map_statement as super
+
+        method! visit_fn_ptr env ptr =
+          (match ptr.kind with
+          | FunId (FRegular id) -> (
+              match FunDeclId.Map.find_opt id crate.fun_decls with
+              | Some decl when selected decl ->
+                  validate decl;
+                  [%cassert] f.item_meta.span
+                    (List.length ptr.generics.regions = 1
+                    && ptr.generics.types = []
+                    && ptr.generics.const_generics = []
+                    && ptr.generics.trait_refs = [])
+                    "Word64 slice length reference must have no remaining \
+                     type/const/trait arguments"
+              | _ -> ())
+          | FunId
+              (FBuiltin
+                 ( ArrayToSliceShared | ArrayToSliceMut
+                 | Index { is_array = true; _ } )) ->
+              [%craise] f.item_meta.span
+                "Word64 slice profile does not support array builtins"
+          | _ -> ());
+          super#visit_fn_ptr env ptr
+      end
+    in
+    match f.body with
+    | StructuredBody body ->
+        {
+          f with
+          body =
+            StructuredBody { body with body = visitor#visit_block () body.body };
+        }
+    | _ -> f
+
+(* The Lean ctlz_nonzero runtime currently models only usize. Validate every
+   direct function reference, including function-pointer constants, before the
+   generic intrinsic declaration is treated as a builtin. *)
+
+let validate_ctlz_nonzero (crate : crate) (f : fun_decl) : fun_decl =
+  if Config.backend () <> Config.Lean then f
+  else
+    let pat = NameMatcher.parse_pattern "core::intrinsics::ctlz_nonzero" in
+    let mctx = NameMatcher.ctx_from_crate crate in
+    let matches =
+      NameMatcher.match_name mctx
+        {
+          map_vars_to_vars = true;
+          match_with_trait_decl_refs =
+            Config.match_patterns_with_trait_decl_refs;
+        }
+        pat
+    in
+    let visitor =
+      object
+        inherit [_] map_statement as super
+
+        method! visit_fn_ptr env ptr =
+          (match ptr.kind with
+          | FunId (FRegular id) -> (
+              match FunDeclId.Map.find_opt id crate.fun_decls with
+              | Some decl
+                when matches
+                       (strip_target_or_instantiated_suffix decl.item_meta.name)
+                ->
+                  let valid =
+                    match List.rev decl.item_meta.name with
+                    | PeInstantiated binder :: _ ->
+                        !Config.monomorphic_builtin_shapes
+                        && binder.binder_params = empty_generic_params
+                        && binder.binder_value
+                           = {
+                               empty_generic_args with
+                               types = [ TLiteral (TUInt Usize) ];
+                             }
+                        && decl.generics = empty_generic_params
+                        && ptr.generics = empty_generic_args
+                        && decl.signature.is_unsafe
+                        && decl.signature.abi = AbiRust
+                        && (not decl.signature.is_variadic)
+                        && decl.signature.inputs = [ TLiteral (TUInt Usize) ]
+                        && decl.signature.output = TLiteral (TUInt U32)
+                    | _ -> ptr.generics.types = [ TLiteral (TUInt Usize) ]
+                  in
+                  [%cassert] f.item_meta.span valid
+                    "ctlz_nonzero: only concrete usize instantiations are \
+                     modeled"
+              | _ -> ())
+          | _ -> ());
+          super#visit_fn_ptr env ptr
+      end
+    in
+    match f.body with
+    | StructuredBody body ->
+        {
+          f with
+          body =
+            StructuredBody { body with body = visitor#visit_block () body.body };
+        }
+    | _ -> f
+
+(** Check each original pointer-parts call, then elaborate its concrete data and
+    metadata types into the interpreter signature. No new source body or
+    callback is introduced. Unknown pointee metadata remains unsupported. *)
+let elaborate_pointer_parts (crate : crate) (f : fun_decl) : fun_decl =
+  let rec metadata_type span ty =
+    let from_kind = function
+      | NoMetadata -> mk_unit_ty
+      | Length -> TLiteral (TUInt Usize)
+      | VTable _ | InheritFrom _ ->
+          [%craise] span "Unsupported pointer-parts metadata kind"
+    in
+    match ty with
+    | TSlice _ | TAdt { id = TBuiltin TStr; _ } -> TLiteral (TUInt Usize)
+    | TLiteral _ | TRef _ | TRawPtr _ | TArray _ | TNever -> mk_unit_ty
+    | TAdt { id = TTuple; generics } -> (
+        match List.rev generics.types with
+        | [] -> mk_unit_ty
+        | last :: _ -> metadata_type span last)
+    | TAdt { id = TAdtId id; generics } ->
+        let decl = TypeDeclId.Map.find id crate.type_decls in
+        [%cassert] span
+          (generics = empty_generic_args && decl.generics = empty_generic_params)
+          "Pointer-parts require a closed pointee declaration";
+        from_kind decl.ptr_metadata
+    | _ -> [%craise] span "Unsupported pointer-parts pointee"
+  in
+  let visitor =
+    object
+      inherit [_] map_statement as super
+
+      method! visit_statement env st =
+        let st = super#visit_statement env st in
+        match st.kind with
+        | Call
+            ( ({
+                 func =
+                   FnOpRegular
+                     ({ kind = FunId (FBuiltin (PtrFromParts mut)); generics }
+                      as func);
+                 args;
+                 dest;
+               } as call),
+              unwind ) ->
+            [%cassert] st.span
+              !Config.provenance_pointers
+              "Pointer-parts require provenance pointers";
+            [%cassert] st.span
+              (generics.regions = [ RErased ]
+              && generics.const_generics = []
+              && generics.trait_refs = [])
+              "Pointer-parts require the original builtin arguments";
+            let target =
+              match generics.types with
+              | [ target ] -> target
+              | _ ->
+                  [%craise] st.span "Pointer-parts require one original pointee"
+            in
+            [%cassert] st.span
+              (dest.ty = TRawPtr (target, mut))
+              "Pointer-parts destination disagrees with pointee/mutability";
+            let operand_ty = function
+              | Move p | Copy p -> p.ty
+              | Constant c -> c.ty
+            in
+            let data, metadata =
+              match args with
+              | [ data; metadata ] -> (operand_ty data, operand_ty metadata)
+              | _ -> [%craise] st.span "Pointer-parts require data and metadata"
+            in
+            let data_target =
+              match data with
+              | TRawPtr (ty, _) -> ty
+              | _ ->
+                  [%craise] st.span
+                    "Pointer-parts data must be a thin raw pointer"
+            in
+            [%cassert] st.span
+              (metadata_type st.span data_target = mk_unit_ty)
+              "Pointer-parts data must be a thin raw pointer";
+            [%cassert] st.span
+              (metadata = metadata_type st.span target)
+              "Pointer-parts metadata disagrees with pointee";
+            let generics =
+              { empty_generic_args with types = [ target; data; metadata ] }
+            in
+            {
+              st with
+              kind =
+                Call
+                  ( { call with func = FnOpRegular { func with generics } },
+                    unwind );
+            }
+        | _ -> st
+    end
+  in
+  match f.body with
+  | StructuredBody body ->
+      {
+        f with
+        body =
+          StructuredBody { body with body = visitor#visit_block () body.body };
+      }
+  | _ -> f
+
+(** A transparent single-field scalar-pattern wrapper has exactly its field's
+    representation. Decompose only the outward transmute, retaining the range
+    type until the checked projection to its scalar base. *)
+let decompose_range_transmutes (crate : crate) (f : fun_decl) : fun_decl =
+  if not !Config.monomorphic_builtin_shapes then f
+  else
+    let visitor =
+      object
+        inherit [_] map_statement as super
+
+        method! visit_rvalue env rv =
+          match rv with
+          | UnaryOp
+              ( Cast
+                  (CastTransmute
+                     ((TAdt { id = TAdtId id; generics } as src), dst)),
+                op ) -> (
+              let decl = TypeDeclId.Map.find id crate.type_decls in
+              let field =
+                match decl.kind with
+                | Struct [ field ] -> Some field
+                | _ -> None
+              in
+              match field with
+              | Some field -> (
+                  match field.field_ty with
+                  | TPattern (base, pattern)
+                    when base = dst
+                         && not (TypesAnalysis.is_nonnull_pointer base pattern)
+                    ->
+                      let scalar_kind, _, _ =
+                        TypesAnalysis.unsigned_range_bounds
+                          (Some f.item_meta.span) base pattern
+                      in
+                      [%cassert] f.item_meta.span
+                        (generics = empty_generic_args
+                        && decl.generics = empty_generic_params)
+                        "Range transmute requires a closed wrapper";
+                      [%cassert] f.item_meta.span
+                        (match (decl.layout, crate.target_information) with
+                        | [ (target, layout) ], [ (actual, info) ] -> (
+                            let bytes = if scalar_kind = U32 then 4 else 8 in
+                            target = actual
+                            && info.target_pointer_size = 8
+                            && info.is_little_endian && layout.size = Some bytes
+                            && layout.align = Some bytes
+                            && layout.repr.transparent
+                            && (not layout.uninhabited)
+                            && layout.repr.align_modif = None
+                            &&
+                            match layout.variant_layouts with
+                            | [ Some variant ] ->
+                                variant.field_offsets = [ 0 ]
+                                && not variant.uninhabited
+                            | _ -> false)
+                        | _ -> false)
+                        "Range transmute requires a transparent zero-offset \
+                         field";
+                      let project (place : place) =
+                        [%sanity_check] f.item_meta.span (place.ty = src);
+                        {
+                          kind =
+                            PlaceProjection
+                              (place, Field (ProjAdt (id, None), FieldId.zero));
+                          ty = field.field_ty;
+                        }
+                      in
+                      let op =
+                        match op with
+                        | Move place -> Move (project place)
+                        | Copy place -> Copy (project place)
+                        | Constant _ ->
+                            [%craise] f.item_meta.span
+                              "Constant wrapper transmute is unsupported"
+                      in
+                      UnaryOp (Cast (CastTransmute (field.field_ty, dst)), op)
+                  | _ -> super#visit_rvalue env rv)
+              | None -> super#visit_rvalue env rv)
+          | _ -> super#visit_rvalue env rv
+      end
+    in
+    match f.body with
+    | StructuredBody body ->
+        {
+          f with
+          body =
+            StructuredBody { body with body = visitor#visit_block () body.body };
+        }
+    | _ -> f
+
+(** Decompose an outward transmute of a closed transparent non-null pointer
+    carrier only after checking its target layout. Keep the non-null field until
+    its proof-erasing projection; use the existing raw cast for mutability. *)
+let decompose_nonnull_transmutes (crate : crate) (f : fun_decl) : fun_decl =
+  if not !Config.provenance_pointers then f
+  else
+    match f.body with
+    | StructuredBody body ->
+        let new_locals = ref [] in
+        let _, gen =
+          LocalId.mk_stateful_generator_starting_at_id
+            (LocalId.of_int (List.length body.locals.locals))
+        in
+        let visitor =
+          object
+            inherit [_] map_statement as super
+
+            method! visit_block env block =
+              let convert st =
+                let st = super#visit_statement env st in
+                match st.kind with
+                | Assign
+                    ( dest,
+                      UnaryOp
+                        ( Cast
+                            (CastTransmute
+                               ( (TAdt { id = TAdtId id; generics } as src),
+                                 (TRawPtr (TLiteral _, _) as dst) )),
+                          op ) ) -> (
+                    let decl = TypeDeclId.Map.find id crate.type_decls in
+                    match decl.kind with
+                    | Struct
+                        [
+                          {
+                            field_ty =
+                              TPattern
+                                ((TRawPtr (TLiteral _, _) as base), NotNull) as
+                              field_ty;
+                            _;
+                          };
+                        ] ->
+                        [%cassert] st.span
+                          (generics = empty_generic_args
+                          && decl.generics = empty_generic_params)
+                          "Non-null carrier requires a closed declaration";
+                        [%cassert] st.span
+                          (match (decl.layout, crate.target_information) with
+                          | [ (target, layout) ], [ (actual, info) ] -> (
+                              target = actual
+                              && info.target_pointer_size = 8
+                              && info.is_little_endian && layout.size = Some 8
+                              && layout.align = Some 8
+                              && layout.repr.transparent
+                              && (not layout.uninhabited)
+                              && layout.repr.align_modif = None
+                              && layout.discriminator
+                                 = Some (Known VariantId.zero)
+                              &&
+                              match layout.variant_layouts with
+                              | [ Some variant ] ->
+                                  variant.field_offsets = [ 0 ]
+                                  && (not variant.uninhabited)
+                                  && variant.tagger = []
+                              | _ -> false)
+                          | _ -> false)
+                          "Non-null carrier requires a checked transparent \
+                           pointer layout";
+                        let project (place : place) =
+                          [%sanity_check] st.span (place.ty = src);
+                          {
+                            kind =
+                              PlaceProjection
+                                (place, Field (ProjAdt (id, None), FieldId.zero));
+                            ty = field_ty;
+                          }
+                        in
+                        let op =
+                          match op with
+                          | Move p -> Move (project p)
+                          | Copy p -> Copy (project p)
+                          | Constant _ ->
+                              [%craise] st.span
+                                "Constant non-null carrier is unsupported"
+                        in
+                        let index = gen () in
+                        new_locals :=
+                          {
+                            index;
+                            local_ty = base;
+                            name = None;
+                            span = st.span;
+                          }
+                          :: !new_locals;
+                        let temporary =
+                          { kind = PlaceLocal index; ty = base }
+                        in
+                        let statement kind = { st with kind } in
+                        [
+                          statement (StorageLive index);
+                          statement
+                            (Assign
+                               ( temporary,
+                                 UnaryOp
+                                   (Cast (CastTransmute (field_ty, base)), op)
+                               ));
+                          statement
+                            (Assign
+                               ( dest,
+                                 if base = dst then Use (Move temporary, NoRetag)
+                                 else
+                                   UnaryOp
+                                     ( Cast (CastRawPtr (base, dst)),
+                                       Move temporary ) ));
+                          statement (StorageDead index);
+                        ]
+                    | _ -> [ st ])
+                | _ -> [ st ]
+              in
+              {
+                block with
+                statements = List.concat_map convert block.statements;
+              }
+          end
+        in
+        let block = visitor#visit_block () body.body in
+        {
+          f with
+          body =
+            StructuredBody
+              {
+                body with
+                body = block;
+                locals =
+                  {
+                    body.locals with
+                    locals = body.locals.locals @ List.rev !new_locals;
+                  };
+              };
+        }
+    | _ -> f
+
+(** Convert checked fieldless unsigned enum and transparent range carriers.
+    Stored tags, source discriminants and the discriminator must agree; range
+    construction uses checked literals only. Invalid representations stay
+    undefined. *)
