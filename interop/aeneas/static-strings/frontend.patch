+  (* Lean string literals contain UTF-8 directly. Escape ASCII syntax/control
+     bytes using Lean conventions; retain other backend conventions. *)
+  let escape c =
+    if backend () <> Lean then Char.escaped c
+    else
+      match c with
+      | '"' -> "\\\""
+      | '\\' -> "\\\\"
+      | '\n' -> "\\n"
+      | '\r' -> "\\r"
+      | '\t' -> "\\t"
+      | c when Char.code c < 32 || Char.code c = 127 ->
+          Printf.sprintf "\\u%04x" (Char.code c)
+      | c -> String.make 1 c
+  in
+  let s = String.concat "" (List.map escape chars) in
   let s = "\"" ^ s ^ "\"" in
 
