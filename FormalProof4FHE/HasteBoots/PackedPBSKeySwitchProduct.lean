omit [DecidableEq Digest] [SampleableType Digest] in
/-- Each product digit factor is the same evaluation root as its final NTT. -/
theorem digit_evaluation_root (finalFamily : PackedPBSOriginalReferences.Family finalD) (index : Fin finalD) :
    KeySwitchPaddedProduct.roots finalFamily (.inl (index,false)) =
      KeySwitchPaddedNTT.roots finalFamily (Fin.castSucc index) true := rfl

omit [DecidableEq Digest] [SampleableType Digest] in
/-- The product output is the evaluation result from the last final NTT. -/
theorem result_evaluation_root (finalFamily : PackedPBSOriginalReferences.Family finalD) :
    KeySwitchPaddedProduct.roots finalFamily (.inr ()) =
      KeySwitchPaddedNTT.roots finalFamily (Fin.last finalD) true := rfl

