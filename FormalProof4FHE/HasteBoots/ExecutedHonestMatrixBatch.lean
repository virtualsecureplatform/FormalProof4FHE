module
public import FormalProof4FHE.HasteBoots.ExecutedHonestMatrix
@[expose] public section

/-! Sequential honest matrix commitments share one cache and retain every
computed root and actual per-matrix cumulative transcript. -/
namespace FormalProof4FHE.HasteBoots.ExecutedHonestMatrixBatch
open OracleSpec OracleComp BinaryTree
noncomputable section
variable {F Cfg Input Digest : Type} [Field F] {H : Cfg → ℕ} {b : ℕ}
  {ι : Type} {base : OracleSpec ι}

/-- Commit each level using the existing shared-oracle builder and return its
actual root. No roots or setup snapshots are supplied by the caller. -/
def program (enc : MerkleOracle.Encoding Input Digest (List F)) :
    {n : ℕ} → (parameters : Fin n → RecordedPaddedSource.Parameters F Cfg H b) →
    ((i : Fin n) → RecordedPaddedSource.PhysicalMatrix (parameters i)) →
    OracleComp (CheckpointExecution.Spec base Cfg Input Digest) (Fin n → Digest)
  | 0, _, _ => pure Fin.elim0
  | n+1, parameters, tables => do
      let first ← ExecutedHonestCommitment.commit enc (AmbientMatrixSource.Shape H)
        (parameters 0).tag (HonestRecordedMatrix.leaves (parameters 0) (tables 0))
      let rest ← program enc (fun i : Fin n => parameters i.succ) (fun i => tables i.succ)
      pure (Fin.cases first.getRootValue rest)

variable [DecidableEq Input] [DecidableEq Digest] [SampleableType Digest]

/-- Every returned root has its own actual frozen query transcript in the
returned checkpoint history. Empty batches and repeated tags/roots are allowed. -/
theorem receipts (impl : QueryImpl base ProbComp)
    (enc : MerkleOracle.Encoding Input Digest (List F)) (dummy : Digest)
    {n : ℕ} (parameters : Fin n → RecordedPaddedSource.Parameters F Cfg H b)
    (tables : (i : Fin n) → RecordedPaddedSource.PhysicalMatrix (parameters i))
    (state : CheckpointExecution.State (Input := Input) (Digest := Digest) (AmbientMatrixSource.Shape H))
    (result : (Fin n → Digest) × CheckpointExecution.State (Input := Input) (Digest := Digest) (AmbientMatrixSource.Shape H))
    (supported : result ∈ support ((simulateQ (CheckpointExecution.handler impl enc dummy
      (AmbientMatrixSource.Shape H)) (program enc parameters tables)).run state)) :
    ∃ before : Fin n → MerkleTreeExtractor.QueryLog Input Digest,
      ∃ labels : (i : Fin n) → FullData Digest (Skeleton.perfect (H (parameters i).tag)),
      ∀ i, result.1 i = (labels i).getRootValue ∧
        ⟨(parameters i).tag, ⟨(labels i).getRootValue,
          before i ++ HonestMerkleTranscript.queries enc (HonestRecordedMatrix.leaves (parameters i) (tables i)) (labels i)⟩⟩ ∈
          result.2.checkpoints.checkpoints := by
  induction n generalizing state with
  | zero => exact ⟨(fun i => i.elim0), (fun i => i.elim0), (fun i => i.elim0)⟩
  | succ n ih =>
      simp only [program, simulateQ_bind, simulateQ_pure, StateT.run_bind,
        StateT.run_pure, support_bind, support_pure, Set.mem_iUnion, Set.mem_singleton_iff] at supported
      obtain ⟨first, firstSupported, rest, restSupported, equal⟩ := supported
      subst result
      obtain ⟨before, labels, saved⟩ := ih (fun i : Fin n => parameters i.succ)
        (fun i => tables i.succ) first.2 rest restSupported
      refine ⟨Fin.cases state.hash.log before, Fin.cases first.1 labels, ?_⟩
      intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · refine ⟨rfl, ?_⟩
        exact ExecutedHonestCommitment.retained impl enc dummy (AmbientMatrixSource.Shape H)
          (parameters 0).tag (HonestRecordedMatrix.leaves (parameters 0) (tables 0)) state
          first firstSupported (program enc (fun i : Fin n => parameters i.succ) (fun i => tables i.succ))
          rest restSupported
      · exact saved j

/-- Supported setup and continuation derive all owner receipts in one final
cache. The per-level prefixes are generated by execution, not supplied. -/
theorem owners_retained {Result : Type} (impl : QueryImpl base ProbComp)
    (enc : MerkleOracle.Encoding Input Digest (List F)) (dummy : Digest)
    {n : ℕ} (parameters : Fin n → RecordedPaddedSource.Parameters F Cfg H b)
    (tables : (i : Fin n) → RecordedPaddedSource.PhysicalMatrix (parameters i))
    (built : (Fin n → Digest) × CheckpointExecution.State (Input := Input) (Digest := Digest) (AmbientMatrixSource.Shape H))
    (setupSupported : built ∈ support ((simulateQ (CheckpointExecution.handler impl enc dummy
      (AmbientMatrixSource.Shape H)) (program enc parameters tables)).run
        (CheckpointExecution.empty (AmbientMatrixSource.Shape H))))
    (continuation : OracleComp (CheckpointExecution.Spec base Cfg Input Digest) Result)
    (result : Result × CheckpointExecution.State (Input := Input) (Digest := Digest) (AmbientMatrixSource.Shape H))
    (supported : result ∈ support ((simulateQ (CheckpointExecution.handler impl enc dummy
      (AmbientMatrixSource.Shape H)) continuation).run built.2)) :
    ∃ before : Fin n → MerkleTreeExtractor.QueryLog Input Digest, ∀ i,
      built.1 i = (HonestRecordedMatrix.owner (parameters i) enc
        (fun input => (result.2.hash.cache input).getD dummy) (before i) (tables i)).root ∧
      ⟨(parameters i).tag, HonestRecordedMatrix.owner (parameters i) enc
        (fun input => (result.2.hash.cache input).getD dummy) (before i) (tables i)⟩ ∈
          result.2.checkpoints.checkpoints := by
  have first := RecordedCheckpointQueries.run impl enc dummy (AmbientMatrixSource.Shape H)
    (program enc parameters tables) (CheckpointExecution.empty (AmbientMatrixSource.Shape H))
    ⟨CachedHashHandler.coherent_empty, RecordedCheckpointQueries.empty _⟩ built setupSupported
  have final := RecordedCheckpointQueries.run impl enc dummy (AmbientMatrixSource.Shape H)
    continuation built.2 first result supported
  obtain ⟨before, labels, saved⟩ := receipts impl enc dummy parameters tables
    (CheckpointExecution.empty (AmbientMatrixSource.Shape H)) built setupSupported
  refine ⟨before, fun i => ?_⟩
  have retained := CheckpointHistory.recorded_run impl enc dummy (AmbientMatrixSource.Shape H)
    (parameters i).tag _ continuation built.2 (saved i).2 result supported
  have realized := ExecutedHonestCommitment.realized enc dummy (AmbientMatrixSource.Shape H)
    (parameters i).tag (HonestRecordedMatrix.leaves (parameters i) (tables i))
    (labels i) (before i) result.2 final.2 retained
  refine ⟨?_, ?_⟩
  · change built.1 i = (HonestMerkleTranscript.tree enc
      (fun input => (result.2.hash.cache input).getD dummy)
      (HonestRecordedMatrix.leaves (parameters i) (tables i))).getRootValue
    rw [realized]
    exact (saved i).1
  · exact ExecutedHonestCommitment.realized_recorded enc dummy (AmbientMatrixSource.Shape H)
      (parameters i).tag (HonestRecordedMatrix.leaves (parameters i) (tables i))
      (labels i) (before i) result.2 final.2 retained

end
end FormalProof4FHE.HasteBoots.ExecutedHonestMatrixBatch
