import FormalProof4FHE.LWE.RecursiveFeatureLowLevelHybrid
import Mathlib.GroupTheory.Coset.Card
import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# The order-two subgroup of a weighted message image

Nonzero powers-of-two weights can be multiplied into the top bit. A finite
abelian image generated by D cyclic coefficients has at most 2^D elements
annihilated by two. This limits exact noiseless message interpolation. It
does not bound cancellation in the full noisy ciphertext law or prove the
requested ordinary-LWE-only bootstrappable security theorem.
-/

namespace FormalProof4FHE.LWE.GSWWeightedCubic

noncomputable section

open scoped BigOperators

/-- Multiplication by two as an additive homomorphism. -/
def doubling (G : Type*) [AddCommGroup G] : G →+ G where
  toFun x := x + x
  map_zero' := by simp
  map_add' := by intros; abel

@[simp] theorem doubling_apply {G : Type*} [AddCommGroup G] (x : G) :
    doubling G x = x + x := rfl

/-- A finite group's order-two subgroup and its quotient by doubles
have the same cardinality. -/
theorem card_twoTorsion_eq_card_quotient (G : Type*) [AddCommGroup G] [Finite G] :
    Nat.card (doubling G).ker = Nat.card (G ⧸ (doubling G).range) := by
  have hk := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup (doubling G).ker
  have hr := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup (doubling G).range
  have hfirst := Nat.card_congr (QuotientAddGroup.quotientKerEquivRange (doubling G)).toEquiv
  rw [hfirst] at hk
  have hpositive : 0 < Nat.card (doubling G).range := Nat.card_pos
  nlinarith

/-- A surjective additive image cannot increase the number of order-two
patterns. The quotient proof avoids assuming torsion lifts through the map. -/
theorem card_twoTorsion_le_of_surjective {H G : Type*}
    [AddCommGroup H] [AddCommGroup G] [Finite H] [Finite G]
    (f : H →+ G) (honto : Function.Surjective f) :
    Nat.card (doubling G).ker ≤ Nat.card (doubling H).ker := by
  rw [card_twoTorsion_eq_card_quotient, card_twoTorsion_eq_card_quotient]
  have hmap : (doubling H).range ≤ (doubling G).range.comap f := by
    rintro _ ⟨value, rfl⟩
    exact ⟨f value, by simp⟩
  let induced := QuotientAddGroup.map (doubling H).range (doubling G).range f hmap
  apply Nat.card_le_card_of_surjective induced
  apply QuotientAddGroup.map_surjective_of_surjective
  intro element
  obtain ⟨representative, hrepresentative⟩ := QuotientAddGroup.mk_surjective element
  obtain ⟨preimage, hpreimage⟩ := honto representative
  exact ⟨preimage, by simpa only [Function.comp_apply, hpreimage] using hrepresentative⟩

/-- The zero or half-modulus alternatives for an order-two residue. -/
theorem residue_twoTorsion {half : ℕ} (hhalf : 0 < half) (value : ZMod (2 * half))
    (hvalue : value + value = 0) : value = 0 ∨ value = (half : ZMod (2 * half)) := by
  letI : NeZero (2 * half) := ⟨by omega⟩
  have hcast : ((2 * value.val : ℕ) : ZMod (2 * half)) = 0 := by
    rw [Nat.cast_mul, Nat.cast_ofNat, ZMod.natCast_zmod_val]
    simpa only [two_mul] using hvalue
  have hdvd := (ZMod.natCast_eq_zero_iff (2 * value.val) (2 * half)).mp hcast
  obtain ⟨factor, hfactor⟩ := hdvd
  have hv := ZMod.val_lt value
  have hfactor_le : factor ≤ 1 := by nlinarith
  have heither : value.val = 0 ∨ value.val = half := by
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hfactor_le with hzero | hone
    · left; simp only [hzero, mul_zero] at hfactor; omega
    · right; simp only [hone, mul_one] at hfactor; omega
  rcases heither with hzero | hone
  · left
    exact (ZMod.val_eq_zero value).mp hzero
  · right
    simpa only [ZMod.natCast_zmod_val] using congrArg (fun x : ℕ ↦ (x : ZMod (2 * half))) hone

/-- Encode a vector annihilated by two using one Boolean per coordinate. -/
def torsionBits {half d : ℕ} (value : (doubling (Fin d → ZMod (2 * half))).ker) : Fin d → Bool :=
  fun index ↦ decide (value.1 index ≠ 0)

theorem torsionBits_injective {half d : ℕ} (hhalf : 0 < half) :
    Function.Injective (torsionBits (half := half) (d := d)) := by
  classical
  intro first second hequal
  apply Subtype.ext
  funext index
  have hfirst : first.1 index + first.1 index = 0 := congrFun first.2 index
  have hsecond : second.1 index + second.1 index = 0 := congrFun second.2 index
  have hbit : decide (first.1 index ≠ 0) = decide (second.1 index ≠ 0) := congrFun hequal index
  rcases residue_twoTorsion hhalf _ hfirst with hz | hh <;>
    rcases residue_twoTorsion hhalf _ hsecond with hz' | hh'
  · exact hz.trans hz'.symm
  · have he : second.1 index = 0 := by simpa [hz] using hbit
    exact hz.trans he.symm
  · have he : first.1 index = 0 := by simpa [hz'] using hbit
    exact he.trans hz'.symm
  · exact hh.trans hh'.symm

/-- A D-coefficient cyclic module has at most 2^D order-two elements. -/
theorem card_twoTorsion_pi_le {half d : ℕ} (hhalf : 0 < half) :
    Nat.card (doubling (Fin d → ZMod (2 * half))).ker ≤ 2 ^ d := by
  have h := Nat.card_le_card_of_injective torsionBits (torsionBits_injective (d := d) hhalf)
  simpa only [Nat.card_eq_fintype_card, Fintype.card_fun, Fintype.card_fin, Fintype.card_bool] using h

/-- The finite top-bit capacity bound for ANY D-coefficient additive image. -/
theorem card_twoTorsion_image_le {half d : ℕ} (hhalf : 0 < half)
    {G : Type*} [AddCommGroup G] [Finite G]
    (f : (Fin d → ZMod (2 * half)) →+ G) (honto : Function.Surjective f) :
    Nat.card (doubling G).ker ≤ 2 ^ d := by
  letI : NeZero (2 * half) := ⟨by omega⟩
  exact (card_twoTorsion_le_of_surjective f honto).trans (card_twoTorsion_pi_le hhalf)

/-- Place a Boolean function in the unique nonzero order-two coordinate. -/
def topBit {S : Type*} (half : ℕ) (pattern : S → Bool) : S → ZMod (2 * half) :=
  fun point ↦ if pattern point then half else 0

theorem topBit_injective {S : Type*} {half : ℕ} (hhalf : 0 < half) :
    Function.Injective (topBit (S := S) half) := by
  intro first second hequal
  have hnonzero : (half : ZMod (2 * half)) ≠ 0 := by
    intro hzero
    have hval := ZMod.val_natCast_of_lt (show half < 2 * half by omega)
    rw [hzero, ZMod.val_zero] at hval
    omega
  funext point
  have hp := congrFun hequal point
  cases hf : first point <;> cases hs : second point <;>
    simp_all [topBit]

theorem topBit_double {S : Type*} (half : ℕ) (pattern : S → Bool) :
    doubling (S → ZMod (2 * half)) (topBit half pattern) = 0 := by
  have hhalf : (half : ZMod (2 * half)) + half = 0 := by
    calc
      _ = ((half + half : ℕ) : ZMod (2 * half)) := (Nat.cast_add half half).symm
      _ = ((2 * half : ℕ) : ZMod (2 * half)) := by congr 1; omega
      _ = 0 := ZMod.natCast_self _
  funext point
  change topBit half pattern point + topBit half pattern point = 0
  cases hp : pattern point <;> simp [topBit, hp, hhalf]

/-- Any collection of distinct binary patterns whose top-bit encodings lie
in a D-coefficient image contains at most 2^D patterns. -/
theorem card_patterns_le {S Pattern : Type*} [Finite S] [Finite Pattern]
    {half d : ℕ} (hhalf : 0 < half)
    (evaluate : (Fin d → ZMod (2 * half)) →+ (S → ZMod (2 * half)))
    (patterns : Pattern → S → Bool) (hinjective : Function.Injective patterns)
    (hrepresent : ∀ pattern, topBit half (patterns pattern) ∈ evaluate.range) :
    Nat.card Pattern ≤ 2 ^ d := by
  letI : NeZero (2 * half) := ⟨by omega⟩
  let intoTorsion : Pattern → (doubling evaluate.range).ker := fun pattern ↦
    ⟨⟨topBit half (patterns pattern), hrepresent pattern⟩,
      by apply Subtype.ext; exact topBit_double half (patterns pattern)⟩
  have hinj : Function.Injective intoTorsion := by
    intro first second hequal
    apply hinjective
    apply topBit_injective hhalf
    exact congrArg (fun element : (doubling evaluate.range).ker ↦ element.1.1) hequal
  exact (Nat.card_le_card_of_injective intoTorsion hinj).trans
    (card_twoTorsion_image_le hhalf evaluate.rangeRestrict evaluate.rangeRestrict_surjective)

/-- The top-bit membership follows from ANY nonzero power-of-two weight
that divides half the modulus, without dividing coefficients in the ring. -/
theorem topBit_mem_of_weighted_mem {S : Type*} {half d weight multiplier : ℕ}
    (evaluate : (Fin d → ZMod (2 * half)) →+ (S → ZMod (2 * half)))
    (pattern : S → Bool) (hfactor : multiplier * weight = half)
    (hweighted : (fun point ↦ if pattern point then (weight : ZMod (2 * half)) else 0) ∈ evaluate.range) :
    topBit half pattern ∈ evaluate.range := by
  have h := evaluate.range.nsmul_mem hweighted multiplier
  convert h using 1
  funext point
  cases pattern point <;> simp [topBit, nsmul_eq_mul, ← Nat.cast_mul, hfactor]

/-- A binary vector space of independent evaluation patterns has dimension
at most the number of cyclic coefficients in the containing image. -/
theorem pattern_dimension_le {S : Type*} [Finite S] {half d rank : ℕ} (hhalf : 0 < half)
    (evaluate : (Fin d → ZMod (2 * half)) →+ (S → ZMod (2 * half)))
    (patterns : (Fin rank → Bool) → S → Bool) (hinjective : Function.Injective patterns)
    (hrepresent : ∀ pattern, topBit half (patterns pattern) ∈ evaluate.range) : rank ≤ d := by
  have h := card_patterns_le hhalf evaluate patterns hinjective hrepresent
  simp only [Nat.card_eq_fintype_card, Fintype.card_fun, Fintype.card_fin, Fintype.card_bool] at h
  exact (pow_le_pow_iff_right₀ (by decide : 1 < (2 : ℕ))).mp h

/-- Top-bit encodings turn Boolean XOR into group addition. -/
theorem topBit_xor {S : Type*} (half : ℕ) (first second : S → Bool) :
    topBit half (fun point ↦ xor (first point) (second point)) =
      topBit half first + topBit half second := by
  have hhalf : (half : ZMod (2 * half)) + half = 0 := by
    have h := congrFun (topBit_double half (fun _ : Unit ↦ true)) ()
    simpa [topBit] using h
  funext point
  cases hf : first point <;> cases hs : second point <;> simp [topBit, hf, hs, hhalf]

end

end FormalProof4FHE.LWE.GSWWeightedCubic
