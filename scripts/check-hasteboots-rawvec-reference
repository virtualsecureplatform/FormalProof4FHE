#!/usr/bin/env python3
"""Check the retained RawVec reference payload schema; no cleanup body/ABI theorem."""
import argparse
import copy
import hashlib
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT/'interop/aeneas/rawvec-reference'
BUILD = runpy.run_path(str(ROOT/'scripts/build-hasteboots-inline-tools'))
PARAMETERS = runpy.run_path(str(ROOT/'scripts/extract-hasteboots-parameters'))
PARENT = runpy.run_path(str(ROOT/'scripts/check-hasteboots-allocator-caller'))
REIFIER = runpy.run_path(str(ROOT/'scripts/reify-hasteboots-rawvec-reference'))
INCLUDES = ['alloc::raw_vec','alloc::vec','alloc::alloc','core::alloc::layout',
            'core::ptr::unique','core::ptr::non_null','core::mem::alignment','core::ptr::drop_in_place']


def digest(raw): return hashlib.sha256(raw).hexdigest()


def inventory():
    names = PARENT['inventory']()
    for file in ['Generated.lean','Proof.lean']:
        raw=(DATA/file).read_text()
        PARAMETERS['validate_proof_source'](raw,re.findall(r'^theorem (\w+)',raw,re.M))
        names += ['HasteBootsRawVecReference.'+n for n in re.findall(r'^(?:def|theorem) (\w+)',raw,re.M)]
    return names


def negatives(ir):
    base=REIFIER['Reifier'](ir);root=base.root;records={}
    def check(label,mutation):
        changed=copy.deepcopy(ir);mutation(changed['translated'])
        try:REIFIER['Reifier'](changed).render()
        except (ValueError,KeyError,TypeError,IndexError) as error:records[label]=str(error)
        else:raise RuntimeError('Negative accepted: '+label)
    def f(c):return c['fun_decls'][root]
    def statements(c):return f(c)['body']['Structured']['body']['statements']
    def switch(c):return statements(c)[1]['kind']['Switch']['SwitchInt']
    def read(c):return switch(c)[3]['statements'][1]['kind']['Assign'][1]['Use']
    def cast(c):return switch(c)[3]['statements'][2]['kind']['Assign'][1]['UnaryOp']
    def projection(c):return read(c)[0]['Copy']
    def geometry(c,decl):return c['type_decls'][decl['def_id']]['layout'][0]['value']
    check('wrong_profile',lambda c:c['options'].update(mir='Built'))
    check('wrong_target',lambda c:c['target_information'][0]['value'].update(target_pointer_size=4))
    check('wrong_signature_region',lambda c:f(c)['signature']['inputs'][0]['Untagged']['Ref'].__setitem__(0,{'Var':{'Free':99}}))
    check('wrong_local_region',lambda c:f(c)['body']['Structured']['locals']['locals'][1]['ty']['Untagged']['Ref'].__setitem__(0,{'Body':99}))
    check('mutable_receiver',lambda c:f(c)['signature']['inputs'][0]['Untagged']['Ref'].__setitem__(2,'Mut'))
    check('changed_function_class',lambda c:f(c)['item_meta'].update(opacity='Foreign'))
    check('changed_vec_extent',lambda c:geometry(c,base.vector).update(size=16))
    check('changed_vec_alignment',lambda c:geometry(c,base.vector).update(align=1))
    check('changed_vec_buffer_offset',lambda c:geometry(c,base.vector)['variant_layouts'][0]['field_offsets'].__setitem__(0,8))
    check('changed_rawvec_inner_offset',lambda c:geometry(c,base.buffer)['variant_layouts'][0]['field_offsets'].__setitem__(0,8))
    check('changed_capacity_offset',lambda c:geometry(c,base.storage.inner)['variant_layouts'][0]['field_offsets'].__setitem__(1,8))
    check('invented_capacity_body',lambda c:c['type_decls'][base.storage.carrier['def_id']].update(kind={'Struct':[]}))
    check('wrong_read_field',lambda c:projection(c)['kind']['Projection'][1]['Field'].__setitem__(1,0))
    check('wrong_read_owner',lambda c:projection(c)['kind']['Projection'][1]['Field'][0]['Adt'].__setitem__(0,base.vector['def_id']))
    check('missing_dereference',lambda c:projection(c)['kind']['Projection'][0]['kind']['Projection'][0]['kind']['Projection'][0].update(kind={'Local':1}))
    check('invalid_read_retag',lambda c:read(c).__setitem__(1,'Unknown'))
    check('wrong_transmute_target',lambda c:cast(c)[0]['Cast']['Transmute'].__setitem__(1,{'Untagged':{'Literal':{'UInt':'U32'}}}))
    check('wrong_transmute_source',lambda c:cast(c)[0]['Cast']['Transmute'].__setitem__(0,REIFIER['SPEC']['USIZE']))
    check('unknown_statement_effect',lambda c:statements(c)[0].update(hidden_effect='Drop'))
    check('wrong_storage_local',lambda c:statements(c)[0].update(kind={'StorageLive':99}))
    check('wrong_switch_width',lambda c:switch(c).__setitem__(1,{'UInt':'U32'}))
    check('extra_switch_label',lambda c:switch(c)[2][0][0].append(copy.deepcopy(switch(c)[2][0][0][0])))
    check('wrong_global_type',lambda c:c['global_decls'][0].update(ty={'Untagged':{'Literal':{'UInt':'U32'}}}))
    check('noncanonical_global_word',lambda c:c['global_decls'][0]['value']['kind']['Literal']['Scalar']['Unsigned'].__setitem__(1,'01'))
    check('hidden_global_value_effect',lambda c:c['global_decls'][0]['value'].update(hidden_effect='Drop'))
    return records


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True); args = parser.parse_args()
    out = Path(tempfile.mkdtemp(prefix='rawvec-reference-', dir=ROOT/'build/hasteboots-extraction'))
    record = {'status':'started','commands':[], 'capacity_body_interpreted':True, 'rawvec_cleanup_body_interpreted':False,
              'native_carrier_validity_proved':False, 'physical_niche_decoded':False, 'native_lifetime_refinement':False,
              'physical_work_refinement':False, 'final_security_theorem':False}
    def save(): (out/'manifest.json').write_text(json.dumps(record,indent=2)+'\n')
    def run(command, log):
        record['commands'].append([str(x) for x in command]); save()
        with (out/log).open('w') as stream:
            result = subprocess.run([str(x) for x in command],cwd=ROOT,stdout=stream,stderr=subprocess.STDOUT)
        if result.returncode: raise RuntimeError('Command failed: '+log)
    print('RawVec reference artifacts: '+str(out), flush=True)
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        files = [Path(__file__), ROOT/'scripts/reify-hasteboots-rawvec-reference',
                 ROOT/'scripts/reify-hasteboots-allocator-caller',ROOT/'scripts/reify-hasteboots-rawvec-option',
                 ROOT/'scripts/reify-hasteboots-global-deallocation',ROOT/'scripts/reify-hasteboots-rawvec-fields',
                 ROOT/'scripts/check-hasteboots-allocator-caller',
                 ROOT/'scripts/specify-hasteboots-deallocation-boundary',
                 ROOT/'scripts/extract-hasteboots-parameters',ROOT/'lean-toolchain',
                 *[DATA/n for n in ['fixture.rs','Generated.lean','Retained.json','Proof.lean','Smoke.lean']],
                 *[ROOT/('FormalProof4FHE/HasteBoots/'+n+'.lean') for n in ['NativeRawVecFields','NativeRawVecReference','NativeRecordLLBC','NativeRecordValues']],
                 *[ROOT/('FormalProof4FHETest/HasteBootsRawVecReference'+n+'.lean') for n in ['Smoke','Audit']]]
        record['inputs'] = {str(p.relative_to(ROOT)):digest(p.read_bytes()) for p in files}
        run([ROOT/'scripts/in-container','lake','build','FormalProof4FHETest.HasteBootsRawVecReferenceSmoke',
             'FormalProof4FHETest.HasteBootsRawVecReferenceAudit'],'root-build.log')
        llbc = out/'source.llbc'
        command = [tools/'charon','rustc','--preset=aeneas','--sysroot','default','--monomorphize','--mir','optimized',
                   '--consts','values','--evaluate-runtime-checks','--precise-drops','--desugar-drops','--preserve-allocator','--no-dedup-serialized-ast']
        for include in INCLUDES: command += ['--include',include]
        command += ['--dest-file',llbc,'--','--crate-type','lib','--edition','2024','-Cdebug-assertions=no',
                    '--crate-name','hasteboots_rawvec_reference',(DATA/'fixture.rs').relative_to(ROOT)]
        run(command,'charon.log'); ir = json.loads(llbc.read_text()); reifier = REIFIER['Reifier'](ir)
        generated = reifier.render()
        if generated != (DATA/'Generated.lean').read_text() or reifier.retained() != json.loads((DATA/'Retained.json').read_text()):
            raise RuntimeError('Retained source schema/target metadata differs')
        record['negative_controls'] = negatives(ir)
        names = inventory()
        checked = out/'Checked.lean'
        checked.write_text(generated+'\n'+(DATA/'Proof.lean').read_text()+'\n'+(DATA/'Smoke.lean').read_text()+
                           ''.join('\n#print axioms '+name+'\n' for name in names))
        run([ROOT/'scripts/in-container','lake','env','lean','-DwarningAsError=true',checked.relative_to(ROOT)],'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out/'lean.log').read_text(),names)
        changed=copy.deepcopy(ir)
        changed['translated']['global_decls'][0]['value']['kind']['Literal']['Scalar']['Unsigned'][1]='0'
        changed_generated=REIFIER['Reifier'](changed).render()
        code_only=lambda raw:re.sub(r'^--.*$','',raw,flags=re.M)
        if code_only(changed_generated)==code_only(generated):raise RuntimeError('Element-size global ignored')
        test=out/'ZeroSize.lean'
        test.write_text(changed_generated+"""
open FormalProof4FHE.HasteBoots
open NativeRecordLLBC
example (world : NativeReferenceMachine.State) (index : Nat) (reference : NativeReferenceMachine.Reference)
    (decoded : NativeRawVecReference.decode world index .vector = some (.reference false reference 3)) :
    invoke HasteBootsRawVecReference.capacity world [.vectorSharedReference index] =
      .returned (.scalar (.usize ⟨2^64-1,by decide⟩)) world := by
  simp [invoke, HasteBootsRawVecReference.capacity, decodeArgs, decode, decoded, initial, eval,
    evalRvalue, evalOperand, storageLive, storageDead, write, NativeRecordLLBC.read,
    NativeRecordValues.fits, NativeRecordValues.complete, NativeRecordValues.compatible,
    NativeRecordValues.typeAt, NativeRecordValues.get, NativeSliceLLBC.fits, retag,
    NativeSliceLLBC.retagValue, settle]
""")
        run([ROOT/'scripts/in-container','lake','env','lean','-DwarningAsError=true',test.relative_to(ROOT)],'zero-size.log')
        record['supported_zero_size_mutation']='sizeof global 1 to 0 changes code; universal max-word return with unchanged world proved in Lean'
        changed=copy.deepcopy(ir)
        changed['translated']['fun_decls'][reifier.root]['body']['Structured']['body']['statements'][1]['kind']['Switch']['SwitchInt'][3]['statements'][1]['kind']['Assign'][1]['Use'][1]='No'
        changed_generated=REIFIER['Reifier'](changed).render()
        if code_only(changed_generated)==code_only(generated):raise RuntimeError('Read retag flag ignored')
        test=out/'RetagDisabled.lean';test.write_text(changed_generated+'\n'+(DATA/'Proof.lean').read_text()+'\n'+(DATA/'Smoke.lean').read_text())
        run([ROOT/'scripts/in-container','lake','env','lean','-DwarningAsError=true',test.relative_to(ROOT)],'retag-disabled.log')
        record['supported_retag_mutation']='Yes to No changes code; all source theorems and regressions pass'
        record['llbc_sha256'] = digest(llbc.read_bytes()); record['checked_sha256'] = digest(checked.read_bytes())
        if record['inputs'] != {str(p.relative_to(ROOT)):digest(p.read_bytes()) for p in files}: raise RuntimeError('Inputs changed during validation')
        BUILD['verify_receipt'](args.build_receipt); record['status'] = 'passed'
        print('RawVec reference passed: '+str(len(names))+' audits; '+str(len(record['negative_controls']))+' rejecting controls')
    except Exception as error:
        record.update(status='failed',error=str(error)); raise SystemExit(str(error)+'; inspect '+str(out)) from error
    finally:
        record['logs'] = {p.name:digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__': main()
