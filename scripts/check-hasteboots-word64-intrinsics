#!/usr/bin/env python3
"""Kernel-check exact 64-bit bit-count intrinsics and original helper bodies."""
import argparse
import copy
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-inline-equivalence'))
RANGES = runpy.run_path(str(ROOT / 'scripts/probe-hasteboots-u32-ranges'))
BUILD, PARAMETERS, COMMON, digest = BASE['BUILD'], BASE['PARAMETERS'], BASE['COMMON'], BASE['digest']
DATA = ROOT / 'interop/aeneas/word64-intrinsics'
NAMESPACE = 'hasteboots_word64_intrinsics'
PROOFS = ['raw_model', 'raw_defined', 'raw_undefined_rejected', 'count_zero', 'count_defined',
          'count_total', 'raw_value', 'population_exact', 'population_value', 'power_of_two_exact',
          'power_of_two_high', 'power_of_two_high_plus_one']
RUNTIME_PROOFS = ['leading_zero', 'leading_nonzero', 'leading_bits', 'leading_value', 'leading_bound',
                  'population_value', 'population_bit_sum', 'population_bound', 'population_zero', 'population_full', 'population_high']
FUNCTIONS = ['raw_leading', 'checked_leading', 'population', 'power_of_two',
             'core.num.Usize.count_ones', 'core.num.Usize.is_power_of_two']


def validate_output(raw):
    PARAMETERS['verify_snapshot'](raw, (DATA / 'Generated.lean').read_text())
    PARAMETERS['validate_proof_source']((DATA / 'Proof.lean').read_text(), PROOFS)
    PARAMETERS['validate_proof_source']((DATA / 'Runtime.lean').read_text(), RUNTIME_PROOFS)
    return RANGES['validate_output'](raw, NAMESPACE, FUNCTIONS)


def intrinsic(ir, name):
    found = [f for f in ir['translated']['fun_decls'] if isinstance(f, dict) and
             [x['Ident'][0] for x in f['item_meta']['name'] if 'Ident' in x] == ['core', 'intrinsics', name]]
    if len(found) != 1: raise RuntimeError('Missing/duplicate intrinsic ' + name)
    return found[0]


def validate_ir(ir):
    BASE['BASE']['BASE']['validate_ir'](ir)
    crate = ir['translated']; options = crate.get('options', {})
    if options.get('monomorphize') is not True or options.get('mir') != 'Optimized':
        raise RuntimeError('Expected monomorphic optimized MIR')
    funcs = [f for f in crate['fun_decls'] if isinstance(f, dict)]
    if len(funcs) != 8: raise RuntimeError('Incomplete source/intrinsic functions')
    for name in ['ctpop', 'ctlz_nonzero']:
        if intrinsic(ir, name).get('body', {}).get('Intrinsic', {}).get('name') != name:
            raise RuntimeError('Missing compiler intrinsic identity')
    rest = [f for f in funcs if f not in [intrinsic(ir, n) for n in ['ctpop', 'ctlz_nonzero']]]
    if any(set(f.get('body') or {}) != {'Structured'} for f in rest):
        raise RuntimeError('Incomplete original source bodies')
    names = [[x['Ident'][0] for x in f['item_meta']['name'] if 'Ident' in x] for f in rest]
    if any(names.count([NAMESPACE, n]) != 1 for n in FUNCTIONS[:4]):
        raise RuntimeError('Missing source fixture function')



def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='word64-intrinsics-', dir=parent))
    record = {'status': 'started', 'claim': 'checked 64-bit bit-count primitives and original helper bodies only; compiler/native heap/work/security unproved',
              'script_sha256': digest(Path(__file__).read_bytes()), 'commands': []}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log, required=True):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            status = subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT).returncode
        if required and status: raise RuntimeError(log + ' exited ' + str(status))
        return status
    print('Word64 intrinsics artifacts: ' + str(out), flush=True); save()
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        record['backend_patches'] = PARAMETERS['verify_backend'](args.backend.resolve(), out)
        files = ['fixture.rs', 'Generated.lean', 'Runtime.lean', 'Proof.lean',
                 'unsupported-pop-u32.rs', 'unsupported-pop-u64.rs', 'unsupported-leading-alias.rs']
        record['inputs'] = {name: digest((DATA / name).read_bytes()) for name in files}
        llbc = out / 'positive.llbc'
        run([tools / 'charon', 'rustc', '--preset=aeneas', '--monomorphize', '--mir', 'optimized',
             '--include', 'core::num::_::count_ones', '--include', 'core::num::_::is_power_of_two', '--dest-file', llbc, '--', '--crate-type', 'lib',
             '--edition', '2024', '--crate-name', NAMESPACE, (DATA / 'fixture.rs').relative_to(ROOT)], 'charon.log')
        options = ['-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000', '-max-recdepth', '1000',
                   '-abort-on-error', '-no-external-name-patterns', '-disambiguate-instantiated-names']
        def frontend(llbc, name, word=True, required=True, shapes=True):
            return run([tools / 'aeneas', *options, *(['-monomorphic-builtin-shapes'] if shapes else []),
                        *(['-target-word64'] if word else []), '-dest', out / name, llbc], name + '-frontend.log', required)
        ir = json.loads(llbc.read_text()); validate_ir(ir)
        frontend(llbc, 'positive')
        BASE['BASE']['validate_frontend_log']((out / 'positive-frontend.log').read_text())
        generated = list((out / 'positive').glob('*.lean'))
        if len(generated) != 1: raise RuntimeError('Expected complete single generated module')
        raw = generated[0].read_text(); runtime = validate_output(raw)
        # Audit every emitted definition, both runtime definitions, and all theorems.
        names = [NAMESPACE + '.' + n for n in re.findall(r'^(?:@\[[^\n]*\] )?def ([^\s:(]+)', raw, re.M)]
        names += ['HasteBootsExtractedWord64IntrinsicsProof.' + n for n in PROOFS]
        names += ['HasteBootsWord64Intrinsics.' + n for n in ['leading', 'population'] + RUNTIME_PROOFS]
        def kernel(raw, name, proof=''):
            checked = out / (name + '.lean')
            checked.write_text((DATA / 'Runtime.lean').read_text() + '\n' + raw.replace('import Aeneas\n', '') + '\n' + proof)
            status = run([ROOT / 'scripts/in-container', 'bash', '-euc', 'cd -- "$1"; lake env lean -DwarningAsError=true "$2"', '_',
                          COMMON['container_path'](args.backend.resolve() / 'backends/lean'), COMMON['container_path'](checked)], name + '-lean.log', False)
            return status, checked
        status, checked = kernel(raw, 'Checked', (DATA / 'Proof.lean').read_text()
                                  + ''.join('\n#print axioms ' + n + '\n' for n in names))
        if status: raise RuntimeError('Complete word64 module/proofs rejected by kernel')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'Checked-lean.log').read_text(), names)
        record.update(llbc_sha256=digest(llbc.read_bytes()), checked_sha256=digest(checked.read_bytes()))
        record['rejected'] = []
        error = 'Target word64 requires monomorphic Lean and one 64-bit little-endian target'
        def reject(path, name, shapes=True):
            status = frontend(path, name, required=False, shapes=shapes)
            if status == 0 or error not in (out / (name + '-frontend.log')).read_text():
                raise RuntimeError('Unsupported target/profile accepted: ' + name)
            record['rejected'].append(name)
        reject(llbc, 'without-shapes', False)
        for name in ['target32', 'big-endian', 'missing-target', 'multiple-targets']:
            bad = copy.deepcopy(ir); targets = bad['translated']['target_information']
            if name == 'target32': targets[0]['value']['target_pointer_size'] = 4
            elif name == 'big-endian': targets[0]['value']['is_little_endian'] = False
            elif name == 'missing-target': targets.clear()
            else: targets.append(copy.deepcopy(targets[0]))
            path = out / (name + '.llbc'); path.write_text(json.dumps(bad) + '\n')
            reject(path, name)
        signature_error = 'Word64 bit-count intrinsic requires an exact monomorphic usize-to-u32 compiler intrinsic and Rust ABI/safety'
        def reject_intrinsic(path, name, expected=signature_error):
            status = frontend(path, name, required=False)
            plain = re.sub(r'\x1b\[[0-9;?]*[A-Za-z]', '', (out / (name + '-frontend.log')).read_text())
            if status == 0 or expected not in plain:
                raise RuntimeError('Unsupported bit-count intrinsic accepted: ' + name)
            record['rejected'].append(name)
        for case in ['pop-u32', 'pop-u64', 'leading-alias']:
            path = out / (case + '.llbc')
            run([tools / 'charon', 'rustc', '--preset=aeneas', '--monomorphize', '--mir', 'optimized',
                 '--dest-file', path, '--', '--crate-type', 'lib', '--edition', '2024',
                 '--crate-name', 'bad_' + case.replace('-', '_'), DATA / ('unsupported-' + case + '.rs')], case + '-charon.log')
            reject_intrinsic(path, case)
        for operation in ['ctpop', 'ctlz_nonzero']:
            for field in ['abi', 'is_unsafe', 'is_variadic', 'input', 'output', 'intrinsic-name', 'instantiation']:
                # Explicit negative fault injection; accepted IR/source/terms are untouched.
                bad = copy.deepcopy(ir); decl = intrinsic(bad, operation)
                sig = decl['signature']
                if field == 'abi': sig['abi'] = 'C'
                elif field == 'is_unsafe': sig['is_unsafe'] = not sig['is_unsafe']
                elif field == 'is_variadic': sig['is_variadic'] = True
                elif field == 'input': sig['inputs'] = []
                elif field == 'output': sig['output'] = sig['inputs'][0]
                elif field == 'intrinsic-name': decl['body']['Intrinsic']['name'] = 'ctlz'
                else: decl['item_meta']['name'][-1]['Instantiated']['skip_binder']['types'] = [copy.deepcopy(sig['output'])]
                name = operation + '-' + field
                path = out / (name + '.llbc'); path.write_text(json.dumps(bad) + '\n')
                reject_intrinsic(path, name)
        bad = copy.deepcopy(ir); decl = intrinsic(bad, 'ctlz_nonzero'); changed = []
        def inject_reference(value):
            if isinstance(value, dict):
                if value.get('kind') == {'Fun': {'Regular': decl['def_id']}} and 'generics' in value:
                    value['generics']['types'] = [copy.deepcopy(decl['signature']['output'])]
                    changed.append(True)
                for child in value.values(): inject_reference(child)
            elif isinstance(value, list):
                for child in value: inject_reference(child)
        inject_reference(bad)
        if len(changed) != 2: raise RuntimeError('Unexpected direct intrinsic reference count')
        path = out / 'reference-generics.llbc'; path.write_text(json.dumps(bad) + '\n')
        reject_intrinsic(path, 'reference-generics', 'Word64 bit-count intrinsic reference must have no remaining generic arguments')
        if record['inputs'] != {name: digest((DATA / name).read_bytes()) for name in files}:
            raise RuntimeError('Input changed during check')
        BUILD['verify_receipt'](args.build_receipt)
        record['status'] = 'passed'
        print('Word64 intrinsics passed: ' + str(len(names)) + ' dependency audits; ' + str(len(record['rejected'])) + ' unsupported cases rejected')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); raise SystemExit('Word64 intrinsics check failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
