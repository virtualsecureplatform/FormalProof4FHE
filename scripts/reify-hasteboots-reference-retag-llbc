#!/usr/bin/env python3
"""Reify source reference retags and retain lifetime declarations without a lifetime proof."""
import argparse
import json
from pathlib import Path
import runpy

BASE = runpy.run_path(str(Path(__file__).resolve().parent / 'reify-hasteboots-slice-scope-llbc'))


class Reifier(BASE['Reifier']):
    def render(self, roots=(1, 2)):
        generated = super().render(roots)
        for record in self.records:
            f = self.functions[record['id']]
            record['source_generics'] = f['generics']
            record['source_signature'] = f['signature']
        return generated.replace('namespace HasteBootsSliceScopeBody\n', 'namespace HasteBootsReferenceRetagBody\n').replace('end HasteBootsSliceScopeBody\n', 'end HasteBootsReferenceRetagBody\n')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('llbc', type=Path); parser.add_argument('output', type=Path); parser.add_argument('--retained', type=Path, required=True)
    args = parser.parse_args(); r = Reifier(json.loads(args.llbc.read_text()))
    args.output.write_text(r.render())
    args.retained.write_text(json.dumps({'active_functions':r.records,'inactive_unsupported':r.retained,
                                       'claim':'original reference Use retags and checked region-index erasure; Rust lifetimes and compiler/native/security refinement unproved'},indent=2)+'\n')


if __name__ == '__main__': main()
