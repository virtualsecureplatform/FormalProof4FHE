#!/usr/bin/env python3
"""Kernel-check original residual conversion with structurally empty alternatives."""
import argparse
import copy
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-inline-equivalence'))
RANGES = runpy.run_path(str(ROOT / 'scripts/probe-hasteboots-u32-ranges'))
BUILD, PARAMETERS, COMMON, digest = BASE['BUILD'], BASE['PARAMETERS'], BASE['COMMON'], BASE['digest']
DATA = ROOT / 'interop/aeneas/uninhabited-variants'
NAMESPACE = 'hasteboots_uninhabited'
PROOFS = ['take_live', 'take_exact', 'nested_live', 'nested_exact', 'residual_err', 'residual_exact']
FUNCTIONS = ['take', 'nested_take', 'residual', 'Error.Insts.CoreConvertFromError.from',
             'core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual']


def validate_output(raw):
    PARAMETERS['verify_snapshot'](raw, (DATA / 'Generated.lean').read_text())
    PARAMETERS['validate_proof_source']((DATA / 'Proof.lean').read_text(), PROOFS)
    if raw.count('| Impossible :') != 2 or '| Ok :' not in raw or 'inductive Never where' not in raw:
        raise RuntimeError('Lost original empty constructors or types')
    return RANGES['validate_output'](raw, NAMESPACE, FUNCTIONS)


def declaration(ir, name):
    found = [d for d in ir['translated']['type_decls'] if isinstance(d, dict) and
             [x['Ident'][0] for x in d['item_meta']['name'] if 'Ident' in x][-1:] == [name]]
    if len(found) != 1: raise RuntimeError('Missing/duplicate source type ' + name)
    return found[0]


def validate_error_payload(ir):
    pool = {}
    def collect(value):
        if isinstance(value, dict):
            if 'HashConsedValue' in value:
                index, body = value['HashConsedValue']
                if index in pool and pool[index] != body: raise RuntimeError('Conflicting error payload type')
                pool[index] = body
            for child in value.values(): collect(child)
        elif isinstance(value, list):
            for child in value: collect(child)
    collect(ir)
    def resolve(value, seen=frozenset()):
        if isinstance(value, dict):
            if 'HashConsedValue' in value:
                index, body = value['HashConsedValue']
                if index in seen: raise RuntimeError('Cyclic error payload type')
                return resolve(body, seen | {index})
            if 'Deduplicated' in value:
                index = value['Deduplicated']
                if index in seen or index not in pool: raise RuntimeError('Invalid error payload type')
                return resolve(pool[index], seen | {index})
            return {k: resolve(v, seen) for k, v in value.items()}
        if isinstance(value, list): return [resolve(v, seen) for v in value]
        return value
    fields = declaration(ir, 'Error').get('kind', {}).get('Struct', [])
    if len(fields) != 1: raise RuntimeError('Missing native-shaped error wrapper')
    expected = {'Ref': ['Static', {'Adt': {'id': {'Builtin': 'Str'}, 'generics': {
        'regions': [], 'types': [], 'const_generics': [], 'trait_refs': []}}}, 'Shared']}
    if resolve(fields[0]['ty']) != expected: raise RuntimeError('Changed static string error payload')
    return expected


def validate_ir(ir):
    BASE['BASE']['BASE']['validate_ir'](ir)
    crate = ir['translated']; options = crate.get('options', {})
    if options.get('monomorphize') is not True or options.get('mir') != 'Optimized' or options.get('sysroot') != 'default':
        raise RuntimeError('Expected monomorphic optimized ordinary-sysroot MIR')
    funcs = [f for f in crate['fun_decls'] if isinstance(f, dict)]
    if len(funcs) != 5 or any(set(f.get('body') or {}) != {'Structured'} for f in funcs):
        raise RuntimeError('Incomplete original residual/projection bodies')
    for name in ['Never', 'Infallible']:
        if declaration(ir, name)['kind'] != {'Enum': []}:
            raise RuntimeError('Expected a structurally empty source type')
    for name in ['Only', 'NestedOnly']:
        if [v['name'] for v in declaration(ir, name)['kind']['Enum']] != ['Impossible', 'Live']:
            raise RuntimeError('Lost original constructors')
    if len(declaration(ir, 'EmptyWrapper')['kind']['Struct']) != 1:
        raise RuntimeError('Missing nested empty field')
    validate_error_payload(ir)



def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='uninhabited-variants-', dir=parent))
    record = {'status': 'started', 'claim': 'structurally empty-variant projection and original residual conversion only; compiler/native heap/work/security unproved',
              'script_sha256': digest(Path(__file__).read_bytes()), 'commands': []}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log, required=True):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            status = subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT).returncode
        if required and status: raise RuntimeError(log + ' exited ' + str(status))
        return status
    print('Uninhabited variants artifacts: ' + str(out), flush=True); save()
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        record['backend_patches'] = PARAMETERS['verify_backend'](args.backend.resolve(), out)
        files = ['fixture.rs', 'Generated.lean', 'Proof.lean', 'unsupported-multiple-instantiations.rs']
        record['inputs'] = {name: digest((DATA / name).read_bytes()) for name in files}
        llbc = out / 'positive.llbc'
        run([tools / 'charon', 'rustc', '--preset=aeneas', '--sysroot', 'default', '--monomorphize', '--mir', 'optimized',
             '--include', 'core::result', '--include', 'core::convert', '--dest-file', llbc, '--', '--crate-type', 'lib',
             '--edition', '2024', '--crate-name', NAMESPACE, (DATA / 'fixture.rs').relative_to(ROOT)], 'charon.log')
        options = ['-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000', '-max-recdepth', '1000',
                   '-abort-on-error', '-no-external-name-patterns', '-disambiguate-instantiated-names']
        def frontend(llbc, name, word=True, required=True, shapes=True):
            return run([tools / 'aeneas', *options, *(['-monomorphic-builtin-shapes'] if shapes else []),
                        *(['-target-word64'] if word else []), '-dest', out / name, llbc], name + '-frontend.log', required)
        ir = json.loads(llbc.read_text()); validate_ir(ir)
        frontend(llbc, 'positive')
        BASE['BASE']['validate_frontend_log']((out / 'positive-frontend.log').read_text())
        generated = list((out / 'positive').glob('*.lean'))
        if len(generated) != 1: raise RuntimeError('Expected complete single generated module')
        raw = generated[0].read_text(); runtime = validate_output(raw)
        # Audit every definition/type/reader, the imported empty type and all proof aliases/theorems.
        names = [NAMESPACE + '.' + n for n in re.findall(r'^(?:@\[[^\n]*\] )?def ([^\s:(]+)', raw, re.M)]
        names += [NAMESPACE + '.' + n for n in re.findall(r'^(?:inductive|structure) ([^\s:(]+)', raw, re.M)]
        names += [NAMESPACE + '.' + n + '.read_discriminant' for n in re.findall(r'^inductive ([^\s:(]+)', raw, re.M) if n != 'Never']
        names += ['Aeneas.Std.core.convert.Infallible']
        names += ['HasteBootsUninhabitedProof.' + n for n in PROOFS + ['Input', 'Output']]
        def kernel(raw, name, proof=''):
            checked = out / (name + '.lean')
            checked.write_text('import Aeneas.Std\nimport Aeneas.Data.Discriminant\n' + raw.replace('import Aeneas\n', '') + '\n' + proof)
            status = run([ROOT / 'scripts/in-container', 'bash', '-euc', 'cd -- "$1"; lake env lean -DwarningAsError=true "$2"', '_',
                          COMMON['container_path'](args.backend.resolve() / 'backends/lean'), COMMON['container_path'](checked)], name + '-lean.log', False)
            return status, checked
        status, checked = kernel(raw, 'Checked', (DATA / 'Proof.lean').read_text()
                                  + ''.join('\n#print axioms ' + n + '\n' for n in names))
        if status: raise RuntimeError('Complete empty-variant module/proofs rejected by kernel')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'Checked-lean.log').read_text(), names)
        record.update(llbc_sha256=digest(llbc.read_bytes()), checked_sha256=digest(checked.read_bytes()))
        record['rejected'] = []
        error = 'Target word64 requires monomorphic Lean and one 64-bit little-endian target'
        def reject(path, name, shapes=True):
            status = frontend(path, name, required=False, shapes=shapes)
            if status == 0 or error not in (out / (name + '-frontend.log')).read_text():
                raise RuntimeError('Unsupported target/profile accepted: ' + name)
            record['rejected'].append(name)
        reject(llbc, 'without-shapes', False)
        for name in ['target32', 'big-endian', 'missing-target', 'multiple-targets']:
            bad = copy.deepcopy(ir); targets = bad['translated']['target_information']
            if name == 'target32': targets[0]['value']['target_pointer_size'] = 4
            elif name == 'big-endian': targets[0]['value']['is_little_endian'] = False
            elif name == 'missing-target': targets.clear()
            else: targets.append(copy.deepcopy(targets[0]))
            path = out / (name + '.llbc'); path.write_text(json.dumps(bad) + '\n')
            reject(path, name)
        # Negative fault injections never become accepted extraction artifacts.
        # Keep the original layout's uninhabited flag while invalidating the
        # structural emptiness witness, so layout hints cannot justify pruning.
        for case in ['opaque', 'inhabited', 'cycle']:
            bad = copy.deepcopy(ir); empty = declaration(bad, 'Infallible')
            if case == 'opaque': empty['kind'] = 'Opaque'
            else:
                results = [d for d in bad['translated']['type_decls'] if isinstance(d, dict)
                           and isinstance(d.get('kind'), dict) and 'Enum' in d['kind']
                           and [v['name'] for v in d['kind']['Enum']] == ['Ok', 'Err']
                           and len(d.get('layout', [])) == 1
                           and d['layout'][0]['value'].get('discriminator') == {'Known': 1}]
                if len(results) != 1: raise RuntimeError('Missing unique source residual fixture')
                variant = copy.deepcopy(results[0]['kind']['Enum'][0])
                if case == 'inhabited': variant['fields'] = []; empty['kind'] = {'Enum': [variant]}
                else: empty['kind'] = {'Struct': [copy.deepcopy(variant['fields'][0])]}
            path = out / ('invalid-' + case + '.llbc'); path.write_text(json.dumps(bad) + '\n')
            status = frontend(path, 'invalid-' + case, required=False)
            log = (out / ('invalid-' + case + '-frontend.log')).read_text()
            if status == 0 or 'Not allowed to expand enumerations with several variants' not in log:
                raise RuntimeError('Non-structural emptiness accepted: ' + case)
            record['rejected'].append(case)
        multiple = out / 'multiple.llbc'
        run([tools / 'charon', 'rustc', '--preset=aeneas', '--sysroot', 'default', '--monomorphize', '--mir', 'optimized',
             '--include', 'core::result', '--include', 'core::convert', '--dest-file', multiple, '--', '--crate-type', 'lib',
             '--edition', '2024', '--crate-name', NAMESPACE, DATA / 'unsupported-multiple-instantiations.rs'], 'multiple-charon.log')
        status = frontend(multiple, 'multiple', required=False)
        if status == 0 or 'Name clash detected' not in (out / 'multiple-frontend.log').read_text():
            raise RuntimeError('Multiple residual instantiations unexpectedly accepted')
        record['rejected'].append('multiple-residual-name-clash')
        if record['inputs'] != {name: digest((DATA / name).read_bytes()) for name in files}:
            raise RuntimeError('Input changed during check')
        BUILD['verify_receipt'](args.build_receipt)
        record['status'] = 'passed'
        print('Uninhabited variants passed: ' + str(len(names)) + ' dependency audits; nine unsupported cases rejected')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); raise SystemExit('Uninhabited variants check failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
