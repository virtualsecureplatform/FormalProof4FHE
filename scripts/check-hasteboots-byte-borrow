#!/usr/bin/env python3
"""Check shared/exclusive byte-borrow transitions and source pointer-data composition."""
import argparse
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
RANGE = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-byte-range'))
MEMORY, PARTS = RANGE['MEMORY'], RANGE['PARTS']
BUILD, PARAMETERS, COMMON, digest = [MEMORY[k] for k in ['BUILD', 'PARAMETERS', 'COMMON', 'digest']]
MODEL = ROOT / 'FormalProof4FHE/HasteBoots/NativeByteBorrow.lean'
DATA = ROOT / 'interop/aeneas/byte-borrow'
MODEL_PROOFS = ['lookup_selected', 'overlap_symm', 'empty_no_overlap', 'rawAllowed_selected', 'raw_exclusive_no_overlap', 'through_selected', 'borrow_success', 'borrow_geometry', 'root_exclusive_separated', 'parent_checked', 'shared_parent_no_upgrade', 'lookup_filtered_tag', 'endBorrow_success', 'endBorrow_no_children', 'ended_read_rejected', 'ended_write_rejected', 'rawWrite_success', 'write_success', 'read_success', 'read_exact_length', 'write_changes_memory', 'deallocate_success', 'deallocate_no_borrow_overlap', 'deallocate_removes_allocation', 'allocate_success', 'empty_wellFormed', 'ledger_transport', 'borrow_wellFormed', 'endBorrow_wellFormed', 'rawWrite_wellFormed', 'write_wellFormed', 'allocate_wellFormed', 'deallocate_wellFormed', 'step_wellFormed', 'reachable_wellFormed', 'missing_read', 'missing_write', 'rawRead_success', 'rawRead_exclusive_conflict', 'rawWrite_conflict', 'deallocate_conflict', 'through_exclusive_unrelated', 'lookup_none_iff', 'endBorrow_found', 'step_counter', 'step_keeps_revoked', 'runs_keep_revoked', 'ended_tag_never_returns', 'ancestor_sound', 'parent_before', 'parentPath_strict', 'ancestor_irreflexive', 'ancestor_complete', 'ancestor_iff']
MODEL_VALUES = ['Mode', 'Lease', 'State', 'empty', 'lookup', 'Overlap', 'Compatible', 'ancestor', 'rawAllowed', 'throughAllowed', 'parentAllowed', 'borrow', 'endBorrow', 'rawRead', 'rawWrite', 'read', 'write', 'allocate', 'deallocate', 'Within', 'LedgerValid', 'WellFormed', 'Step', 'Reachable', 'borrowSlice', 'Runs', 'ParentPath']
BRIDGE_PROOFS = ['source_shared', 'source_exclusive', 'source_cast_shared', 'original_exclusive', 'issued_pointer_data', 'issued_initialized_range', 'shared_parent_rejected']


def validate_sources():
    PARAMETERS['validate_proof_source'](MODEL.read_text(), MODEL_PROOFS)
    PARAMETERS['validate_proof_source']((DATA / 'Pointer.lean').read_text(), BRIDGE_PROOFS)
    names = re.findall(r'^(?:def|structure|inductive) ([^\s:(]+)', MODEL.read_text(), re.M)
    if len(names) != len(MODEL_VALUES) or set(names) != set(MODEL_VALUES): raise RuntimeError('Incomplete byte range declaration audit')
    PARAMETERS['validate_proof_source']((ROOT / 'FormalProof4FHETest/HasteBootsByteBorrowSmoke.lean').read_text(), [])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='byte-borrow-', dir=parent))
    record = {'status': 'started', 'claim': 'checked byte-borrow ledger and pointer-data composition only; Rust references/tag representation/aliasing/compiler/work/security unproved',
              'script_sha256': digest(Path(__file__).read_bytes()), 'commands': []}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT, check=True)
    print('Byte borrow artifacts: ' + str(out), flush=True); save()
    try:
        BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        record['backend_patches'] = PARAMETERS['verify_backend'](args.backend.resolve(), out)
        validate_sources()
        files = [MODEL, DATA / 'Pointer.lean', RANGE['MODEL'], RANGE['DATA'] / 'Pointer.lean', MEMORY['MODEL'], PARTS['DATA'] / 'Runtime.lean', PARTS['DATA'] / 'Generated.lean',
                 PARTS['POINTER']['DATA'] / 'Runtime.lean', ROOT / 'FormalProof4FHE/HasteBoots/NativePointerRepresentation.lean',
                 ROOT / 'FormalProof4FHETest/HasteBootsByteBorrowSmoke.lean', ROOT / 'FormalProof4FHETest/HasteBootsByteBorrowAudit.lean',
                 ROOT / 'FormalProof4FHE.lean', ROOT / 'FormalProof4FHETest.lean', ROOT / 'lean-toolchain', ROOT / 'lake-manifest.json']
        record['inputs'] = {str(p.relative_to(ROOT)): digest(p.read_bytes()) for p in files}
        record['parent_gates'] = {}
        for name in ['byte-range']:
            run([ROOT / ('scripts/check-hasteboots-' + name), '--build-receipt', args.build_receipt,
                 '--backend', args.backend], name + '.log')
            path = Path((out / (name + '.log')).read_text().splitlines()[0].split(': ', 1)[1]) / 'manifest.json'
            parent_record = json.loads(path.read_text())
            if parent_record.get('status') != 'passed' or parent_record.get('build_receipt_sha256') != record['build_receipt_sha256']:
                raise RuntimeError('Parent gate does not match paired tools: ' + name)
            record['parent_gates'][name] = {'manifest_sha256': digest(path.read_bytes()),
                'dependency_audit': parent_record['dependency_audit']}
        run([ROOT / 'scripts/in-container', 'lake', 'build', 'FormalProof4FHE.HasteBoots.NativeByteBorrow',
             'FormalProof4FHETest.HasteBootsByteBorrowSmoke', 'FormalProof4FHETest.HasteBootsByteBorrowAudit'], 'root-build.log')
        raw = (PARTS['DATA'] / 'Generated.lean').read_text()
        names = ['FormalProof4FHE.HasteBoots.NativeByteBorrow.' + n for n in MODEL_VALUES + MODEL_PROOFS]
        names += ['HasteBootsByteBorrowPointer.' + n for n in BRIDGE_PROOFS]
        names += ['HasteBootsByteRangePointer.' + n for n in ['decode'] + RANGE['BRIDGE_PROOFS']]
        names += [PARTS['NAMESPACE'] + '.' + n for n in re.findall(r'^(?:@\[[^\n]*\] )?(?:def|structure) ([^\s:(]+)', raw, re.M)]
        names += ['HasteBootsPointerPartsRuntime.' + n for n in ['from_thin_const', 'from_thin_mut', 'from_slice_const', 'from_slice_mut'] + PARTS['RUNTIME_PROOFS']]
        pointer = PARTS['POINTER']
        names += ['HasteBootsPointerRuntime.' + n for n in ['RawPtr', 'MutRawPtr', 'ConstRawPtr', 'mutableFlag', 'cast_scalar'] + pointer['RUNTIME_PROOFS']]
        checked = out / 'Checked.lean'
        checked.write_text('import FormalProof4FHE.HasteBoots.NativeByteBorrow\n' + (pointer['DATA'] / 'Runtime.lean').read_text()
                           + '\n' + (PARTS['DATA'] / 'Runtime.lean').read_text() + '\n' + raw.replace('import Aeneas\n', '')
                           + '\n' + (RANGE['DATA'] / 'Pointer.lean').read_text() + '\n' + (DATA / 'Pointer.lean').read_text() + ''.join('\n#print axioms ' + name + '\n' for name in names))
        command = ('project_path=$(lake env printenv LEAN_PATH); cd -- "$1"; '
                   'backend_path=$(lake env printenv LEAN_PATH); '
                   'LEAN_PATH="$project_path:$backend_path" lean -DwarningAsError=true "$2"')
        run([ROOT / 'scripts/in-container', 'bash', '-euc', command, '_',
             COMMON['container_path'](args.backend.resolve() / 'backends/lean'), COMMON['container_path'](checked)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        record['checked_sha256'] = digest(checked.read_bytes())
        if record['inputs'] != {str(p.relative_to(ROOT)): digest(p.read_bytes()) for p in files}: raise RuntimeError('Input changed during check')
        BUILD['verify_receipt'](args.build_receipt); record['status'] = 'passed'
        print('Byte borrow passed: ' + str(len(names)) + ' dependency audits; 54 ledger theorems and seven source composition theorems')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); raise SystemExit('Byte borrow check failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
