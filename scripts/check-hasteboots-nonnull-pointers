#!/usr/bin/env python3
"""Kernel-check source non-null pointer patterns and checked transparent carriers."""
import argparse
import copy
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
POINTER = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-pointer-extraction'))
BASE, BUILD, PARAMETERS, COMMON, digest = [POINTER[k] for k in ['BASE', 'BUILD', 'PARAMETERS', 'COMMON', 'digest']]
DATA = ROOT / 'interop/aeneas/nonnull-pointers'
NAMESPACE = 'hasteboots_nonnull_pointers'
FUNCTIONS = ['unwrap_const', 'unwrap_mut', 'unwrap_slice', 'wrap_const', 'wrap_mut', 'wrap_slice', 'original_identity', 'original_get']
PROOFS = ['unwrap_const_exact', 'unwrap_mut_exact', 'unwrap_slice_exact', 'wrap_const_exact', 'wrap_mut_exact', 'wrap_slice_exact',
          'original_identity_exact', 'original_as_ptr_exact', 'original_get_exact', 'original_get_address', 'original_get_origin',
          'original_get_metadata', 'wrap_const_valid', 'wrap_mut_zero', 'wrap_slice_zero', 'wrap_slice_valid', 'const_roundtrip', 'no_zero_original']
RUNTIME_PROOFS = ['check_nonnull_valid', 'check_nonnull_zero', 'check_nonnull_ok_iff', 'check_nonnull_roundtrip']


def carrier(ir):
    decls = [d for d in ir['translated']['type_decls'] if d and d['item_meta'].get('lang_item') == 'NonNull']
    if len(decls) != 1: raise RuntimeError('Expected one original NonNull declaration')
    return decls[0]


def validate_ir(ir):
    BASE['BASE']['BASE']['validate_ir'](ir)
    crate = ir['translated']; options = crate.get('options', {})
    if options.get('monomorphize') is not True or options.get('mir') != 'Optimized' or options.get('sysroot') != 'default':
        raise RuntimeError('Expected ordinary optimized monomorphic source')
    funcs = [f for f in crate['fun_decls'] if f]
    if len(funcs) != 9 or any(set(f.get('body') or {}) != {'Structured'} for f in funcs):
        raise RuntimeError('Missing original pointer-pattern/as_ptr body')
    d = carrier(ir)
    if len(d['layout']) != 1: raise RuntimeError('Missing unique carrier layout')
    layout = d['layout'][0]['value']
    if layout['size'] != 8 or layout['align'] != 8 or not layout['repr']['transparent'] or layout['uninhabited']:
        raise RuntimeError('Incorrect transparent pointer layout')
    if layout['discriminator'] != {'Known': 0} or layout['variant_layouts'] != [{'field_offsets': [0], 'uninhabited': False, 'tagger': []}]:
        raise RuntimeError('Incorrect transparent pointer field')


def validate_output(raw):
    PARAMETERS['verify_snapshot'](raw, (DATA / 'Generated.lean').read_text())
    PARAMETERS['validate_proof_source']((DATA / 'Proof.lean').read_text(), PROOFS)
    PARAMETERS['validate_proof_source']((DATA / 'Runtime.lean').read_text(), RUNTIME_PROOFS)
    for fragment in ['// pointer.storage.address ≠ 0', 'HasteBootsPointerRuntime.check_nonnull pointer',
                     'Subtype.val self.pointer', 'HasteBootsPointerRuntime.cast_scalar Std.U8 .Mut p']:
        if fragment not in raw: raise RuntimeError('Missing non-null pointer semantics')
    return POINTER['RANGES']['validate_output'](raw, NAMESPACE, FUNCTIONS)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='nonnull-pointers-', dir=parent))
    record = {'status': 'started', 'claim': 'address non-null patterns and checked outward thin carrier only; source heap/caller/work/security unproved',
              'script_sha256': digest(Path(__file__).read_bytes()), 'commands': []}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log, required=True):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            status = subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT).returncode
        if required and status: raise RuntimeError(log + ' exited ' + str(status))
        return status
    print('Non-null pointer artifacts: ' + str(out), flush=True); save()
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        record['backend_patches'] = PARAMETERS['verify_backend'](args.backend.resolve(), out)
        files = [DATA / n for n in ['fixture.rs', 'Generated.lean', 'Runtime.lean', 'Proof.lean', 'unsupported-base.rs']]
        files += [POINTER['DATA'] / 'Runtime.lean', POINTER['REPRESENTATION'], ROOT / 'lean-toolchain']
        record['inputs'] = {str(p.relative_to(ROOT)): digest(p.read_bytes()) for p in files}
        run([ROOT / 'scripts/in-container', 'lake', 'build', 'FormalProof4FHE.HasteBoots.NativePointerRepresentation'], 'root-build.log')
        llbc = out / 'positive.llbc'
        def source(source, path):
            run([tools / 'charon', 'rustc', '--preset=aeneas', '--sysroot', 'default', '--monomorphize', '--mir', 'optimized',
                 '--include', 'core::ptr::non_null', '--dest-file', path, '--', '--crate-type', 'lib', '--edition', '2024',
                 '--crate-name', NAMESPACE, source.relative_to(ROOT)], path.stem + '-charon.log')
        source(DATA / 'fixture.rs', llbc)
        options = ['-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000', '-max-recdepth', '1000',
                   '-abort-on-error', '-no-external-name-patterns', '-disambiguate-instantiated-names']
        def frontend(path, name, flags=None, required=True):
            if flags is None: flags = ['-monomorphic-builtin-shapes', '-target-word64', '-provenance-pointers']
            return run([tools / 'aeneas', *options, *flags, '-dest', out / name, path], name + '-frontend.log', required)
        ir = json.loads(llbc.read_text()); validate_ir(ir)
        frontend(llbc, 'positive'); BASE['BASE']['validate_frontend_log']((out / 'positive-frontend.log').read_text())
        generated = list((out / 'positive').glob('*.lean'))
        if len(generated) != 1: raise RuntimeError('Expected one complete source module')
        raw = generated[0].read_text(); validate_output(raw)
        names = [NAMESPACE + '.' + n for n in re.findall(r'^(?:@\[[^\n]*\] )?(?:def|structure) ([^\s:(]+)', raw, re.M)]
        names += ['HasteBootsNonNullProof.' + n for n in ['NonNull', 'Valid'] + PROOFS]
        names += ['HasteBootsPointerRuntime.' + n for n in ['check_nonnull'] + RUNTIME_PROOFS]
        names += ['HasteBootsPointerRuntime.' + n for n in ['RawPtr', 'MutRawPtr', 'ConstRawPtr', 'mutableFlag', 'cast_scalar'] + POINTER['RUNTIME_PROOFS']]
        checked = out / 'Checked.lean'
        checked.write_text((POINTER['DATA'] / 'Runtime.lean').read_text() + '\n' + (DATA / 'Runtime.lean').read_text() + '\n'
                           + raw.replace('import Aeneas\n', '') + '\n' + (DATA / 'Proof.lean').read_text()
                           + ''.join('\n#print axioms ' + name + '\n' for name in names))
        run([ROOT / 'scripts/in-container', 'bash', '-euc', 'cd -- "$1"; export LEAN_PATH="$3:${LEAN_PATH:-}"; lake env lean -DwarningAsError=true "$2"', '_',
             COMMON['container_path'](args.backend.resolve() / 'backends/lean'), COMMON['container_path'](checked),
             COMMON['container_path'](ROOT / '.lake/build/lib/lean')], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        record.update(llbc_sha256=digest(llbc.read_bytes()), checked_sha256=digest(checked.read_bytes()), rejected=[])
        def reject(path, name, error, flags=None):
            status = frontend(path, name, flags, False)
            if status == 0 or error not in (out / (name + '-frontend.log')).read_text():
                raise RuntimeError('Unsupported pointer pattern/layout accepted: ' + name)
            record['rejected'].append(name)
        reject(llbc, 'without-provenance', 'Non-null pointer patterns require provenance pointers', ['-monomorphic-builtin-shapes', '-target-word64'])
        reject(llbc, 'without-word64', 'Provenance pointers require the checked target-word64 profile', ['-monomorphic-builtin-shapes', '-provenance-pointers'])
        reject(llbc, 'without-shapes', 'Target word64 requires monomorphic Lean', ['-target-word64', '-provenance-pointers'])
        for name in ['target32', 'big-endian', 'missing-target', 'multiple-targets']:
            bad = copy.deepcopy(ir); targets = bad['translated']['target_information']
            if name == 'target32': targets[0]['value']['target_pointer_size'] = 4
            elif name == 'big-endian': targets[0]['value']['is_little_endian'] = False
            elif name == 'missing-target': targets.clear()
            else: targets.append(copy.deepcopy(targets[0]))
            path = out / (name + '.llbc'); path.write_text(json.dumps(bad) + '\n')
            reject(path, name, 'Target word64 requires monomorphic Lean')
        for name in ['size', 'align', 'transparent', 'offset', 'uninhabited', 'variant', 'tagger', 'discriminator', 'missing-layout', 'align-modifier']:
            bad = copy.deepcopy(ir); decl = carrier(bad); layout = decl['layout'][0]['value']
            if name == 'size': layout['size'] = 16
            elif name == 'align': layout['align'] = 4
            elif name == 'transparent': layout['repr']['transparent'] = False
            elif name == 'offset': layout['variant_layouts'][0]['field_offsets'] = [8]
            elif name == 'uninhabited': layout['uninhabited'] = True
            elif name == 'variant': layout['variant_layouts'][0]['uninhabited'] = True
            elif name == 'tagger': layout['variant_layouts'][0]['tagger'] = [[0, {'Unsigned': ['U8', '1']}]]
            elif name == 'discriminator': layout['discriminator'] = {'Known': 1}
            elif name == 'missing-layout': decl['layout'].clear()
            elif name == 'align-modifier': layout['repr']['align_modif'] = {'Align': 16}
            path = out / ('layout-' + name + '.llbc'); path.write_text(json.dumps(bad) + '\n')
            reject(path, 'layout-' + name, 'Non-null carrier requires a checked transparent pointer layout')
        path = out / 'unsupported-base.llbc'; source(DATA / 'unsupported-base.rs', path)
        reject(path, 'unsupported-base', 'Invalid input for unop')
        if record['inputs'] != {str(p.relative_to(ROOT)): digest(p.read_bytes()) for p in files}: raise RuntimeError('Input changed during check')
        BUILD['verify_receipt'](args.build_receipt)
        record['status'] = 'passed'
        print('Non-null pointers passed: ' + str(len(names)) + ' dependency audits; ' + str(len(record['rejected'])) + ' unsupported cases rejected')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); raise SystemExit('Non-null pointer check failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
