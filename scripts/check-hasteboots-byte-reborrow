#!/usr/bin/env python3
"""Check original mutable byte-reborrow helper and closed local-scope heap simulation."""
import argparse
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
PARENT = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-byte-reference-heap'))
SOURCE = PARENT['SOURCE']
BUILD, PARAMETERS, COMMON, digest = [SOURCE[k] for k in ['BUILD', 'PARAMETERS', 'COMMON', 'digest']]
DATA = ROOT / 'interop/aeneas/byte-reborrow'
MODEL = ROOT / 'FormalProof4FHE/HasteBoots/NativeByteReborrow.lean'
NAMESPACE = 'hasteboots_byte_reborrow'
MODEL_PROOFS = ['outside', 'missing', 'success', 'success_wellFormed', 'scope_restored', 'success_memory',
                'ancestor_fresh_prefix', 'issued_exclusive_access', 'exclusive_allows_shared', 'issued_end_after_write',
                'issued_executes', 'success_steps', 'local_tag_never_returns']
PROOFS = ['replace_cell_exact', 'replace_at_found', 'replace_at_outside', 'replace_at_exact']
BRIDGE_PROOFS = ['replace_heap', 'replace_granted', 'replace_outside_unchanged']


def walk(value):
    yield value
    if isinstance(value, dict):
        for child in value.values(): yield from walk(child)
    elif isinstance(value, list):
        for child in value: yield from walk(child)


def validate_ir(ir):
    SOURCE['BASE']['BASE']['BASE']['BASE']['validate_ir'](ir)
    crate = ir['translated']; options = crate.get('options', {})
    if not options.get('monomorphize') or options.get('mir') != 'Optimized' or options.get('sysroot') != 'default':
        raise RuntimeError('Expected original ordinary optimized monomorphic MIR')
    funcs = [f for f in crate['fun_decls'] if f]
    if len(funcs) != 3: raise RuntimeError('Unexpected reborrow source closure')
    selected = {}
    for name in ['replace_cell', 'replace_at']:
        matches = [f for f in funcs if f['item_meta']['name'] == [{'Ident': [NAMESPACE, 0]}, {'Ident': [name, 0]}]]
        if len(matches) != 1 or set(matches[0]['body']) != {'Structured'} or len(matches[0]['generics']['regions']) != 1:
            raise RuntimeError('Missing original lifetime-preserving source body: ' + name)
        selected[name] = matches[0]
    helper = selected['replace_cell']; caller = selected['replace_at']
    if sum(isinstance(v, str) and v == 'Deref' for v in walk(helper['body'])) != 2:
        raise RuntimeError('Missing original callee reference load/store')
    refs = [v['Ref'] for v in walk(caller['body']) if isinstance(v, dict) and isinstance(v.get('Ref'), dict)]
    if sum(r.get('kind') == 'Mut' for r in refs) != 2 or sum(r.get('kind') == 'TwoPhaseMut' for r in refs) != 1:
        raise RuntimeError('Missing original mutable/two-phase reference rvalues')
    calls = [v['Call']['call']['func']['Regular'] for v in walk(caller['body']) if isinstance(v, dict) and 'Call' in v]
    helper_calls = [c for c in calls if c.get('kind', {}).get('Fun', {}).get('Regular') == helper['def_id']]
    indexes = [c for c in calls if c.get('kind', {}).get('Fun', {}).get('Builtin') == {'Index': {'is_array': False, 'mutability': 'Mut', 'is_range': False}}]
    if len(helper_calls) != 1 or len(indexes) != 1: raise RuntimeError('Missing original mutable index/helper call')
    SOURCE['length_decl'](ir)


def validate_sources():
    PARAMETERS['validate_proof_source'](MODEL.read_text(), MODEL_PROOFS)
    if re.findall(r'^def ([^\s:(]+)', MODEL.read_text(), re.M) != ['replaceAt']:
        raise RuntimeError('Unexpected local scope operation inventory')
    PARAMETERS['validate_proof_source']((DATA / 'Proof.lean').read_text(), PROOFS)
    PARAMETERS['validate_proof_source']((DATA / 'Bridge.lean').read_text(), BRIDGE_PROOFS)
    PARAMETERS['validate_proof_source']((ROOT / 'FormalProof4FHETest/HasteBootsByteReborrowSmoke.lean').read_text(), [])


def validate_output(raw):
    PARAMETERS['verify_snapshot'](raw, (DATA / 'Generated.lean').read_text())
    validate_sources()
    if 'HasteBootsSlice64Runtime.index_mut' not in raw or 'index_mut_back cell1' not in raw:
        raise RuntimeError('Missing original mutable indexing continuation')
    return SOURCE['BASE']['RANGES']['validate_output'](raw, NAMESPACE, ['replace_cell', 'replace_at'])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='byte-reborrow-', dir=parent))
    record = {'status': 'started', 'claim': 'original reborrow function/value and closed local child-scope simulation only; native ownership/intermediate reference identities/two-phase alias/compiler/work/security unproved',
              'script_sha256': digest(Path(__file__).read_bytes()), 'commands': []}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT, check=True)
    print('Byte reborrow artifacts: ' + str(out), flush=True); save()
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        record['backend_patches'] = PARAMETERS['verify_backend'](args.backend.resolve(), out)
        validate_sources()
        files = [MODEL, *[DATA / n for n in ['fixture.rs', 'Generated.lean', 'Proof.lean', 'Bridge.lean']], SOURCE['RUNTIME'],
                 SOURCE['DATA'] / 'Generated.lean', SOURCE['DATA'] / 'Proof.lean', PARENT['DATA'] / 'Bridge.lean',
                 ROOT / 'FormalProof4FHETest/HasteBootsByteReborrowSmoke.lean', ROOT / 'FormalProof4FHETest/HasteBootsByteReborrowAudit.lean',
                 ROOT / 'FormalProof4FHE.lean', ROOT / 'FormalProof4FHETest.lean', ROOT / 'lean-toolchain']
        record['inputs'] = {str(p.relative_to(ROOT)): digest(p.read_bytes()) for p in files}
        run([ROOT / 'scripts/check-hasteboots-byte-reference-heap', '--build-receipt', args.build_receipt, '--backend', args.backend], 'parent.log')
        path = Path((out / 'parent.log').read_text().splitlines()[0].split(': ', 1)[1]) / 'manifest.json'
        parent_record = json.loads(path.read_text())
        if parent_record.get('status') != 'passed' or parent_record.get('build_receipt_sha256') != record['build_receipt_sha256']:
            raise RuntimeError('Parent source/heap gate differs')
        record['parent_gate'] = {'manifest_sha256': digest(path.read_bytes()), 'dependency_audit': parent_record['dependency_audit']}
        run([ROOT / 'scripts/in-container', 'lake', 'build', 'FormalProof4FHE.HasteBoots.NativeByteReborrow',
             'FormalProof4FHETest.HasteBootsByteReborrowSmoke', 'FormalProof4FHETest.HasteBootsByteReborrowAudit'], 'root-build.log')
        llbc = out / 'positive.llbc'
        run([tools / 'charon', 'rustc', '--preset=aeneas', '--sysroot', 'default', '--monomorphize', '--mir', 'optimized', '--dest-file', llbc,
             '--', '--crate-type', 'lib', '--edition', '2024', '--crate-name', NAMESPACE, (DATA / 'fixture.rs').relative_to(ROOT)], 'charon.log')
        validate_ir(json.loads(llbc.read_text()))
        run([tools / 'aeneas', '-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000', '-max-recdepth', '1000',
             '-abort-on-error', '-no-external-name-patterns', '-disambiguate-instantiated-names', '-monomorphic-builtin-shapes',
             '-target-word64', '-word64-slices', '-dest', out / 'positive', llbc], 'frontend.log')
        SOURCE['BASE']['BASE']['BASE']['validate_frontend_log']((out / 'frontend.log').read_text())
        generated = list((out / 'positive').glob('*.lean'))
        if len(generated) != 1: raise RuntimeError('Expected complete source module')
        raw = generated[0].read_text(); validate_output(raw)
        names = ['FormalProof4FHE.HasteBoots.NativeByteReborrow.' + n for n in ['replaceAt'] + MODEL_PROOFS]
        names += [NAMESPACE + '.' + n for n in ['replace_cell', 'replace_at'] + PROOFS]
        names += ['HasteBootsByteReborrowHeap.' + n for n in BRIDGE_PROOFS]
        names += ['HasteBootsSlice64Runtime.' + n for n in SOURCE['VALUES'] + SOURCE['RUNTIME_PROOFS']]
        names += ['HasteBootsByteReferenceHeap.' + n for n in PARENT['BRIDGE_VALUES'] + PARENT['BRIDGE_PROOFS']]
        names += [SOURCE['NAMESPACE'] + '.' + n for n in ['checked_read', 'checked_write'] + SOURCE['PROOFS']]
        checked = out / 'Checked.lean'
        checked.write_text('import FormalProof4FHE.HasteBoots.NativeByteReborrow\n' + SOURCE['RUNTIME'].read_text() + '\n'
                           + (SOURCE['DATA'] / 'Generated.lean').read_text().replace('import Aeneas\n', '') + '\n'
                           + (SOURCE['DATA'] / 'Proof.lean').read_text() + '\n' + (PARENT['DATA'] / 'Bridge.lean').read_text()
                           + '\n' + raw.replace('import Aeneas\n', '') + '\n' + (DATA / 'Proof.lean').read_text() + '\n'
                           + (DATA / 'Bridge.lean').read_text() + ''.join('\n#print axioms ' + name + '\n' for name in names))
        command = ('project_path=$(lake env printenv LEAN_PATH); cd -- "$1"; backend_path=$(lake env printenv LEAN_PATH); '
                   'LEAN_PATH="$project_path:$backend_path" lean -DwarningAsError=true "$2"')
        run([ROOT / 'scripts/in-container', 'bash', '-euc', command, '_', COMMON['container_path'](args.backend.resolve() / 'backends/lean'),
             COMMON['container_path'](checked)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        record.update(llbc_sha256=digest(llbc.read_bytes()), checked_sha256=digest(checked.read_bytes()))
        if record['inputs'] != {str(p.relative_to(ROOT)): digest(p.read_bytes()) for p in files}: raise RuntimeError('Input changed during check')
        BUILD['verify_receipt'](args.build_receipt); record['status'] = 'passed'
        print('Byte reborrow passed: ' + str(len(names)) + ' dependency audits; original mutable helper/caller and local scope simulation')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); raise SystemExit('Byte reborrow failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__': main()
