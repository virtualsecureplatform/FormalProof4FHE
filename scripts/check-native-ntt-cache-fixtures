#!/usr/bin/env python3
"""Check fresh pinned-native cache identity, roots and error behavior."""
from pathlib import Path
import subprocess
import hashlib
import sys
import tomllib

if not __debug__:
    raise SystemExit('Run fixture checks without Python optimization flags')

root = Path(__file__).resolve().parent.parent
lock = tomllib.loads((root / 'scripts/native-fixtures/ntt-cache/Cargo.lock').read_text())
backend = [p for p in lock['package'] if p['name'] == 'concrete-ntt']
assert len(backend) == 1
assert backend[0]['source'] == 'git+https://github.com/pado-labs/concrete-ntt?branch=dev#cdeba793e46208320b30d78be19f7be78d49016a'
native_lock = tomllib.loads((root.parent / 'HasteBoots/Cargo.lock').read_text())
for name in ('arc-swap', 'concrete-ntt'):
    selected = [p for p in lock['package'] if p['name'] == name]
    pinned = [p for p in native_lock['package'] if p['name'] == name]
    assert len(selected) == len(pinned) == 1
    assert all(selected[0].get(field) == pinned[0].get(field)
               for field in ('version', 'source', 'checksum')), f'native dependency mismatch: {name}'
run = subprocess.run([str(root / 'scripts/native-ntt-cache-fixture')], capture_output=True, text=True)
if run.returncode:
    sys.stderr.write(run.stdout)
    sys.stderr.write(run.stderr)
    raise SystemExit(run.returncode)

expected = {4: 70368744161280, 5: 549755813888, 10: 455906449640507599}
p = 18446744069414584321
seen = {'CACHE_PRE': set(), 'CACHE_AFTER': set()}
markers = []
block_cases = {(1, 1, 2): (1, 32, 549755813888),
               (7, 3, 2): (4, 32, 549755813888),
               (1024, 4, 4): (256, 1024, 455906449640507599),
               (4096, 4, 4): (1024, 4096, 1532612707718625687)}
block_seen = set()
errors = {'zero-message', 'zero-block', 'small-blowup', 'nonpower-blowup',
          'message-overflow', 'domain-overflow', 'stride-overflow', 'unsupported-domain'}
error_seen = set()
parameter_cases = {(5,3,2,2,8,3,2), (6,4,2,3,16,4,4), (12,4,2,8,1024,4,4)}
parameter_seen = set()
parameter_errors = {'width-zero','left-too-large','variables-too-large','queries-zero','code-shape',
                    'table-overflow','encoded-overflow','linear-overflow','merkle-overflow'}
parameter_error_seen = set()
balanced_cases = {(0,3,1,2),(2,4,1,2),(5,3,2,2),(10,3,128,2),(10,4,128,4),(16,4,64,2)}
balanced_seen = set()
balanced_errors = {'width-zero','queries-zero','variables-too-large','small-blowup',
                   'nonpower-blowup','table-overflow','unsupported-layout'}
balanced_error_seen = set()
def read_u64(data, offset):
    tag = data[offset]
    if tag < 251:
        return tag,offset+1
    width = {251:2,252:4,253:8}[tag]
    return int.from_bytes(data[offset+1:offset+1+width],'little'),offset+1+width

def balanced_reference(n,w,q,b):
    choices = []
    for left in range(n+1):
        columns = 2**(n-left)
        padded = 1 << (((columns+w-1)//w)-1).bit_length()
        if padded >= 2**64 or padded*b >= 2**64:
            continue
        blocks = max(padded*b,32)
        rows = 2**left*w
        if (p-1)%(2*blocks) or rows >= 2**64 or rows*blocks >= 2**64 or rows*blocks*w >= 2**64:
            continue
        unique = min(q,blocks)
        score = ((2*w*columns+unique*rows*w)*9+unique*blocks.bit_length()*32) % 2**128
        choices.append((score,left,columns,padded,blocks))
    return min(choices) # Lexicographic left index implements the earliest tie.

def encode_u64(value):
    assert 0 <= value < 2**64
    if value < 251:
        return bytes([value])
    for tag, width in [(251, 2), (252, 4), (253, 8)]:
        if value < 2**(width * 8):
            return bytes([tag]) + value.to_bytes(width, 'little')
    raise AssertionError('unreachable u64 encoding')
for line in run.stdout.splitlines():
    label, *fields = line.split()
    assert label in (*seen, 'CACHE_ERROR', 'CACHE_OK', 'BLOCK', 'BLOCK_ERROR', 'PARAM', 'PARAM_ERROR', 'BALANCED', 'BALANCED_ERROR'), f'unknown cache record: {line}'
    if label == 'BALANCED':
        assert len(fields) == 8
        key = tuple(map(int,fields[:4]))
        assert key in balanced_cases and key not in balanced_seen
        balanced_seen.add(key)
        n,w,q,b = key
        _,left,columns,padded,blocks = balanced_reference(*key)
        assert int(fields[4]) == left
        data = bytes.fromhex(fields[5])
        offset = 0
        decoded = []
        for _ in range(5):
            value,offset = read_u64(data,offset)
            decoded.append(value)
        assert decoded == [columns,w,padded,blocks,len(str(p))]
        assert data[offset:offset+decoded[-1]] == str(p).encode()
        offset += decoded[-1]
        root,offset = read_u64(data,offset)
        assert offset == len(data) and 0 < root < p
        assert pow(root,2*blocks,p) == 1 and pow(root,blocks,p) == p-1
        code = b''.join(encode_u64(v) for v in (columns,w,padded,blocks,len(str(p))))
        code += str(p).encode()+encode_u64(root)
        assert data == code
        modulus = str(p).encode()
        domain = b'block-rs/negacyclic-ntt/v1'
        context = b'HasteBoots/mw-parameters/v2'+encode_u64(len(modulus))+modulus
        context += b''.join(encode_u64(v) for v in (n,w,left,q,w,blocks))
        context += encode_u64(len(domain))+domain+code
        assert bytes.fromhex(fields[6]) == context
        assert fields[7] == hashlib.sha512(context).hexdigest()
    elif label == 'BALANCED_ERROR':
        assert len(fields) == 1 and fields[0] in balanced_errors and fields[0] not in balanced_error_seen
        balanced_error_seen.add(fields[0])
    elif label == 'PARAM':
        assert len(fields) == 10
        key = tuple(map(int, fields[:7]))
        assert key in parameter_cases and key not in parameter_seen
        parameter_seen.add(key)
        num_vars, width, left, queries, message, block, blowup = key
        assert message == 2**(num_vars-left)
        padded = 1 << (((message+block-1)//block)-1).bit_length()
        count = max(padded*blowup,32)
        root_value = {32:549755813888,1024:455906449640507599}[count]
        modulus = str(p).encode()
        code = b''.join(encode_u64(v) for v in (message,block,padded,count))
        code += encode_u64(len(modulus))+modulus+encode_u64(root_value)
        domain = b'block-rs/negacyclic-ntt/v1'
        context = b'HasteBoots/mw-parameters/v2'+encode_u64(len(modulus))+modulus
        context += b''.join(encode_u64(v) for v in (num_vars,width,left,queries,block,count))
        context += encode_u64(len(domain))+domain+code
        assert bytes.fromhex(fields[7]) == code
        assert bytes.fromhex(fields[8]) == context
        assert fields[9] == hashlib.sha512(context).hexdigest()
    elif label == 'PARAM_ERROR':
        assert len(fields) == 1 and fields[0] in parameter_errors and fields[0] not in parameter_error_seen
        parameter_error_seen.add(fields[0])
    elif label == 'BLOCK':
        assert len(fields) == 7
        message, block, blowup, padded, count, root_value = map(int, fields[:6])
        key = (message, block, blowup)
        assert key in block_cases and key not in block_seen
        block_seen.add(key)
        assert (padded, count, root_value) == block_cases[key]
        ceil_blocks = (message + block - 1) // block
        assert padded == 1 << (ceil_blocks - 1).bit_length()
        assert count == max(padded * blowup, 32)
        assert 0 < root_value < p and pow(root_value, 2*count, p) == 1 and pow(root_value, count, p) == p-1
        modulus = str(p).encode()
        reference = b''.join(encode_u64(v) for v in (message, block, padded, count))
        reference += encode_u64(len(modulus)) + modulus + encode_u64(root_value)
        assert bytes.fromhex(fields[6]) == reference, f'complete code bytes differ: {key}'
    elif label == 'BLOCK_ERROR':
        assert len(fields) == 1 and fields[0] in errors and fields[0] not in error_seen
        error_seen.add(fields[0])
    elif label in seen:
        assert len(fields) == (2 if label == 'CACHE_PRE' else 3)
        log, value = map(int, fields[:2])
        assert log in expected and log not in seen[label], f'unexpected/duplicate cache key: {line}'
        seen[label].add(log)
        assert value == expected[log] and 0 < value < p
        assert pow(value, 2**(log+1), p) == 1 and pow(value, 2**log, p) == p-1
        if label == 'CACHE_AFTER':
            assert fields[2] == '8'
    else:
        markers.append(line)
assert all(keys == set(expected) for keys in seen.values())
assert block_seen == set(block_cases) and error_seen == errors
assert parameter_seen == parameter_cases and parameter_error_seen == parameter_errors
assert balanced_seen == balanced_cases and balanced_error_seen == balanced_errors
assert markers == ['CACHE_ERROR root-error=true init-panic=true retained-stable=true',
                   'CACHE_OK workers=8 logs=3 retained-handles=24']
print('Native NTT caches passed: 3 exact roots, 24 shared Arc handles across 8 threads, retained roots and error/panic distinction')
print('Native block code constructors passed: 4 complete serialized objects and 8 ordered rejection cases')
print('Native encoded parameters passed: 3 retained codes and complete SHA-512 context inputs/digests, 9 ordered rejection cases')
print('Native balanced layouts passed: 6 minimum-score selections with complete code/context bytes and 7 ordered errors')
