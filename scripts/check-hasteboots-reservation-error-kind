#!/usr/bin/env python3
"""Check the complete transparent getter after explicit reference materialization."""
import argparse
import copy
import hashlib
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile
ROOT=Path(__file__).resolve().parent.parent
DATA=ROOT/'interop/aeneas/reservation-error-kind'
BUILD=runpy.run_path(str(ROOT/'scripts/build-hasteboots-inline-tools'))
PARAM=runpy.run_path(str(ROOT/'scripts/extract-hasteboots-parameters'))
PARENT=runpy.run_path(str(ROOT/'scripts/check-hasteboots-allocator-caller'))
REIFIER=runpy.run_path(str(ROOT/'scripts/reify-hasteboots-reservation-error-kind'))
INCLUDES=['alloc::collections','core::alloc::layout','core::mem::alignment']
EXTRA_MODULES=[('NativeReservationErrorFields',['Kind.capacityOverflow','Kind.allocationError']),('NativeByteBorrowStorage',[]),('NativeStorageBorrowMachine',['Op.legacy','Op.storageBorrow','Runs.refl','Runs.step']),('NativeReservationErrorLocal',['Tags.mk','Tags.error','Tags.kind','Tags.layout','Tags.alignment','Tags.alignmentEnum']),('NativeReservationErrorRead',['Readable.mk','Readable.reference','Readable.lease','Readable.resident','Readable.registered','Readable.shared','Readable.extent','Readable.baseResident','Readable.allowed','Readable.stored'])]
def digest(path):return hashlib.sha256(path.read_bytes()).hexdigest()
def negatives(ir):
 r=REIFIER['Reifier'](ir);records={};function=r.getter['def_id'];typeids=r.tags
 def check(label,mutate):
  changed=copy.deepcopy(ir);mutate(changed['translated'])
  try:REIFIER['Reifier'](changed).render()
  except (ValueError,KeyError,TypeError,IndexError) as error:records[label]=str(error)
  else:raise RuntimeError('Accepted negative control: '+label)
 def body(c):return c['fun_decls'][function]['body']['Structured']
 def ss(c):return body(c)['body']['statements']
 def match(c):return ss(c)[1]['kind']['Switch']['Match']
 def allocation(c):return match(c)[1][1][1]['statements']
 def layoutPlace(c):return allocation(c)[1]['kind']['Assign'][1]['Use'][0]['Copy']
 check('wrong_target',lambda c:c['target_information'][0]['value'].__setitem__('is_little_endian',False))
 check('wrong_word_size',lambda c:c['target_information'][0]['value'].__setitem__('target_pointer_size',4))
 check('not_monomorphized',lambda c:c['options'].__setitem__('monomorphize',False))
 check('wrong_mir',lambda c:c['options'].__setitem__('mir','Built'))
 check('allocator_erased',lambda c:c['options'].__setitem__('preserve_allocator',False))
 check('rewritten_source',lambda c:c['options'].__setitem__('inline_functions',['alloc::collections::kind']))
 check('foreign_getter',lambda c:c['fun_decls'][function]['item_meta'].__setitem__('opacity','Foreign'))
 check('wrong_method_owner',lambda c:c['fun_decls'][function]['item_meta']['name'][2]['Impl']['Ty'].__setitem__('skip_binder',REIFIER['adt'](typeids[2])))
 check('unsafe_getter',lambda c:c['fun_decls'][function]['signature'].__setitem__('is_unsafe',True))
 check('wrong_getter_output',lambda c:c['fun_decls'][function]['signature'].__setitem__('output',REIFIER['adt'](typeids[0])))
 check('exclusive_getter_input',lambda c:c['fun_decls'][function]['signature']['inputs'][0]['Untagged']['Ref'].__setitem__(2,'Mut'))
 check('changed_argument_count',lambda c:body(c)['locals'].__setitem__('arg_count',2))
 check('changed_body_regions',lambda c:body(c).__setitem__('bound_body_regions',5))
 check('changed_local_type',lambda c:body(c)['locals']['locals'][2].__setitem__('ty',REIFIER['adt'](typeids[1])))
 check('unknown_body_metadata',lambda c:body(c).__setitem__('unknown_effect',True))
 check('wrong_discriminant_field',lambda c:match(c)[0]['kind']['Projection'][1]['Field'].__setitem__(1,1))
 check('wrong_dereference_source',lambda c:match(c)[0]['kind']['Projection'][0]['kind']['Projection'][0]['kind'].__setitem__('Local',0))
 check('changed_variant_arm',lambda c:match(c)[1][1].__setitem__(0,[0]))
 check('missing_allocation_arm',lambda c:match(c)[1].pop())
 check('unexpected_default',lambda c:match(c).__setitem__(2,{'statements':[]}))
 check('moved_layout_instead_of_copy',lambda c:allocation(c)[1]['kind']['Assign'][1]['Use'].__setitem__(0,{'Move':layoutPlace(c)}))
 check('wrong_layout_projection',lambda c:layoutPlace(c)['kind']['Projection'][1]['Field'].__setitem__(1,1))
 check('disabled_layout_retag',lambda c:allocation(c)[1]['kind']['Assign'][1]['Use'].__setitem__(1,'No'))
 check('copied_layout_temporary',lambda c:allocation(c)[2]['kind']['Assign'][1]['Aggregate'][1].__setitem__(0,{'Copy':REIFIER['local'](2,REIFIER['adt'](typeids[2]))}))
 check('changed_allocation_variant',lambda c:allocation(c)[2]['kind']['Assign'][1]['Aggregate'][0]['Adt'].__setitem__(1,0))
 check('destroyed_allocation_return',lambda c:allocation(c)[3]['kind'].__setitem__('StorageDead',0))
 check('allocation_return_removed',lambda c:allocation(c)[-1].__setitem__('kind','UnwindResume'))
 check('overflow_temporary_scope',lambda c:ss(c)[2]['kind'].__setitem__('StorageLive',2))
 check('changed_overflow_variant',lambda c:ss(c)[3]['kind']['Assign'][1]['Aggregate'][0]['Adt'].__setitem__(1,1))
 check('copied_overflow_result',lambda c:ss(c)[4]['kind']['Assign'][1]['Use'].__setitem__(0,{'Copy':REIFIER['local'](3,REIFIER['adt'](typeids[1]))}))
 check('destroyed_overflow_return',lambda c:ss(c)[5]['kind'].__setitem__('StorageDead',0))
 check('overflow_return_removed',lambda c:ss(c)[-1].__setitem__('kind','UnwindResume'))
 check('wrong_wrapper_field_type',lambda c:c['type_decls'][typeids[0]]['kind']['Struct'][0].__setitem__('ty',REIFIER['adt'](typeids[2])))
 check('wrong_wrapper_field_offset',lambda c:c['type_decls'][typeids[0]]['layout'][0]['value']['variant_layouts'][0]['field_offsets'].__setitem__(0,8))
 check('changed_layout_word_offsets',lambda c:c['type_decls'][typeids[2]]['layout'][0]['value']['variant_layouts'][0].__setitem__('field_offsets',[0,8]))
 check('changed_niche_offset',lambda c:c['type_decls'][typeids[1]]['layout'][0]['value']['discriminator']['Branch'].__setitem__('offset',8))
 check('changed_niche_fallback',lambda c:c['type_decls'][typeids[1]]['layout'][0]['value']['discriminator']['Branch']['fallback'].__setitem__('Known',0))
 check('changed_alignment_variant',lambda c:c['type_decls'][typeids[4]]['kind']['Enum'][0]['discriminant']['Scalar']['Unsigned'].__setitem__(1,'3'))
 check('changed_alignment_physical_tag',lambda c:c['type_decls'][typeids[4]]['layout'][0]['value']['variant_layouts'][0]['tagger'][0][1]['Unsigned'].__setitem__(1,'3'))
 check('root_unsafe_signature',lambda c:c['fun_decls'][r.root['def_id']]['signature'].__setitem__('is_unsafe',True))
 check('root_regions',lambda c:c['fun_decls'][r.root['def_id']]['body']['Structured'].__setitem__('bound_body_regions',4))
 check('root_local_type',lambda c:c['fun_decls'][r.root['def_id']]['body']['Structured']['locals']['locals'][2].__setitem__('ty',REIFIER['adt'](typeids[0])))
 def root(c):return c['fun_decls'][r.root['def_id']]['body']['Structured']['body']['statements']
 check('root_borrow_scope',lambda c:root(c)[1]['kind'].__setitem__('StorageLive',1))
 check('root_mutable_borrow',lambda c:root(c)[2]['kind']['Assign'][1]['Ref'].__setitem__('kind','Mut'))
 check('root_borrow_destination',lambda c:root(c)[2]['kind']['Assign'][0]['kind'].__setitem__('Local',1))
 check('root_borrow_source',lambda c:root(c)[2]['kind']['Assign'][1]['Ref']['place']['kind']['Projection'][0]['kind'].__setitem__('Local',2))
 check('root_borrow_metadata',lambda c:root(c)[2]['kind']['Assign'][1]['Ref']['ptr_metadata']['Const'].__setitem__('ty',REIFIER['USIZE']))
 check('root_copied_argument',lambda c:root(c)[3]['kind']['Call']['call']['args'].__setitem__(0,{'Copy':root(c)[3]['kind']['Call']['call']['args'][0]['Move']}))
 check('root_getter_target',lambda c:root(c)[3]['kind']['Call']['call']['func']['Regular']['kind']['Fun'].__setitem__('Regular',r.root['def_id']))
 check('root_callee_region',lambda c:root(c)[3]['kind']['Call']['call']['func']['Regular']['generics']['regions'][0].__setitem__('Body',3))
 check('root_call_destination',lambda c:root(c)[3]['kind']['Call']['call']['dest']['kind'].__setitem__('Local',2))
 check('root_unwind_local',lambda c:root(c)[3]['kind']['Call']['on_unwind']['statements'][0]['kind'].__setitem__('StorageDead',2))
 check('root_unwind_exit',lambda c:root(c)[3]['kind']['Call']['on_unwind']['statements'][1].__setitem__('kind','Return'))
 check('root_normal_cleanup',lambda c:root(c)[4]['kind'].__setitem__('StorageDead',0))
 check('root_return_removed',lambda c:root(c)[-1].__setitem__('kind','UnwindResume'))
 return records

def main():
 p=argparse.ArgumentParser(description=__doc__);p.add_argument('--build-receipt',type=Path,required=True);a=p.parse_args()
 out=Path(tempfile.mkdtemp(prefix='reservation-error-kind-',dir=ROOT/'build/hasteboots-extraction'))
 r={'status':'started','commands':[],'transparent_original_getter_body_retained':True,'complete_statement_tree_validated':True,'reference_dereference_materialization_explicit':True,'pure_materialized_getter_proved':True,'equivalent_to_checked_kind_getter':True,'snapshot_to_source_body_round_trip':True,'fixture_root_reborrow_execution_proved':True,'fixture_root_call_moves_cleanup_proved':True,'normal_return_scope_cleanup_explicit':True,'wrapper_snapshot_round_trip_proved':True,'nominal_tag_parametric_getter_proved':True,'original_getter_specialization_proved':True,'original_error_handler_installed':False,'native_reference_stack_abi_lifetime_refinement':False,'physical_work_refinement':False,'final_security_theorem':False}
 def save():(out/'manifest.json').write_text(json.dumps(r,indent=2)+'\n')
 def run(command,log):
  r['commands'].append([str(x)for x in command]);save()
  with (out/log).open('w')as f:result=subprocess.run([str(x)for x in command],cwd=ROOT,stdout=f,stderr=subprocess.STDOUT)
  if result.returncode:raise RuntimeError('Command failed: '+log)
 print('Reservation error kind artifacts: '+str(out),flush=True)
 try:
  _,tools,_=BUILD['verify_receipt'](a.build_receipt);r['build_receipt_sha256']=digest(a.build_receipt)
  files=[Path(__file__),ROOT/'scripts/reify-hasteboots-reservation-error-kind',ROOT/'scripts/build-hasteboots-inline-tools',ROOT/'scripts/extract-hasteboots-parameters',ROOT/'scripts/specify-hasteboots-deallocation-boundary',ROOT/'scripts/check-hasteboots-allocator-caller',ROOT/'lean-toolchain',*sorted((ROOT/'scripts').glob('reify-hasteboots-*')),*sorted((ROOT/'FormalProof4FHE/HasteBoots').glob('Native*.lean')),*[DATA/n for n in ['fixture.rs','Generated.lean','Retained.json','Proof.lean','GenericProof.lean','WrapperProof.lean','ReadyProof.lean','CleanupProof.lean','ProjectionProof.lean','HeapProof.lean','Smoke.lean','GenericSmoke.lean','WrapperSmoke.lean']]]
  files=list(dict.fromkeys(files));r['inputs']={str(f.relative_to(ROOT)):digest(f)for f in files}
  run([ROOT/'scripts/in-container','lake','build','FormalProof4FHE.HasteBoots.NativeAllocatorLLBC','FormalProof4FHE.HasteBoots.NativeReservationErrorRead'],'root-build.log')
  llbc=out/'source.llbc';command=[tools/'charon','rustc','--preset=aeneas','--sysroot','default','--monomorphize','--mir','optimized','--consts','values','--evaluate-runtime-checks','--precise-drops','--desugar-drops','--preserve-allocator','--no-dedup-serialized-ast']
  for include in INCLUDES:command+=['--include',include]
  command+=['--dest-file',llbc,'--','--crate-type','lib','--edition','2024','-Cdebug-assertions=no','--crate-name','hasteboots_reservation_error_kind',(DATA/'fixture.rs').relative_to(ROOT)]
  run(command,'charon.log');ir=json.loads(llbc.read_text());reifier=REIFIER['Reifier'](ir);generated=reifier.render()
  if generated!=(DATA/'Generated.lean').read_text()or reifier.retained()!=json.loads((DATA/'Retained.json').read_text()):raise RuntimeError('Getter source/declarations differ')
  r['negative_controls']=negatives(ir);names=PARENT['inventory'](include_allocator=True)
  for module,extra in EXTRA_MODULES:
   raw=(ROOT/'FormalProof4FHE/HasteBoots'/(module+'.lean')).read_text();PARAM['validate_proof_source'](raw,re.findall(r'^theorem (\w+)',raw,re.M));names+=['FormalProof4FHE.HasteBoots.'+module+'.'+n for n in re.findall(r'^(?:structure|inductive|def|theorem) (\w+)',raw,re.M)+extra]
  dependencyBase=len(names)
  for file in ['Generated.lean','Proof.lean','GenericProof.lean','WrapperProof.lean','ReadyProof.lean','CleanupProof.lean','ProjectionProof.lean','HeapProof.lean']:
   raw=(DATA/file).read_text();PARAM['validate_proof_source'](raw,re.findall(r'^theorem (\w+)',raw,re.M));names+=['HasteBootsReservationErrorKind.'+n for n in re.findall(r'^(?:structure|def|theorem) (\w+)',raw,re.M)]
  names+=['HasteBootsReservationErrorKind.'+n for n in ['Ready.mk','Ready.descriptor','Ready.checked']]
  checked=out/'Checked.lean';checked.write_text(generated+'\n'+'\n'.join((DATA/n).read_text() for n in ['Proof.lean','GenericProof.lean','WrapperProof.lean','ReadyProof.lean','CleanupProof.lean','ProjectionProof.lean','HeapProof.lean','Smoke.lean','GenericSmoke.lean','WrapperSmoke.lean'])+''.join('\n#print axioms '+n+'\n'for n in names))
  run([ROOT/'scripts/in-container','lake','env','lean','-DwarningAsError=true',checked.relative_to(ROOT)],'lean.log')
  r['dependency_audit']=PARAM['audit_log']((out/'lean.log').read_text(),names)
  if r['inputs']!={str(f.relative_to(ROOT)):digest(f)for f in files}:raise RuntimeError('Inputs changed during validation')
  r['llbc_sha256']=digest(llbc);r['checked_sha256']=digest(checked);r['retained_function_count']=2;r['retained_type_count']=5;r['source_example_count']=sum(len(re.findall(r'^example',(DATA/file).read_text(),re.M)) for file in ['Smoke.lean','GenericSmoke.lean','WrapperSmoke.lean']);r['source_declaration_count']=len(names)-dependencyBase
  BUILD['verify_receipt'](a.build_receipt);r['status']='passed';print('Reservation error kind passed: '+str(len(names))+' audits; '+str(len(r['negative_controls']))+' rejecting controls',flush=True)
 except Exception as error:r.update(status='failed',error=str(error));raise SystemExit(str(error)+'; inspect '+str(out))from error
 finally:r['logs']={f.name:digest(f)for f in out.glob('*.log')};save()
if __name__=='__main__':main()
