#!/usr/bin/env python3
"""Freshly extract the inline fixture and kernel-check its complete observable equivalence."""
import argparse
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-inline-baseline'))
BUILD = runpy.run_path(str(ROOT / 'scripts/build-hasteboots-inline-tools'))
DATA, PARAMETERS, COMMON = BASE['DATA'], BASE['PARAMETERS'], BASE['COMMON']
digest = BASE['digest']
NAMESPACE = 'hasteboots_inline_candidate'
PROOFS = ['decode_pair_encode', 'encode_pair_decode', 'decode_twice_encode',
          'encode_twice_decode', 'capture_equivalent', 'twice_equivalent']
FUNCTIONS = ['Tuple.Insts.CoreConvertFromTuple.from',
             'core.result.Result.Insts.CoreOpsTry_traitTry.branch',
             'core.result.Result.Insts.CoreOpsTry_traitFromResidualResult.from_residual',
             'twice', 'capture', 'capture.closure.Insts.CoreOpsFunctionFnOnceTupleUsize.call_once',
             'capture.closure.Insts.CoreOpsFunctionFnOnceTupleUsize']
DECODERS = ['decodePair', 'decodeTwice', 'encodePair', 'encodeTwice']


def validate_output(raw):
    PARAMETERS['validate_proof_source']((DATA / 'Equivalence.lean').read_text(), PROOFS)
    if raw.count('import Aeneas\n') != 1 or not raw.rstrip().endswith('end ' + NAMESPACE):
        raise RuntimeError('Incomplete inline candidate extraction')
    PARAMETERS['verify_snapshot'](raw, (DATA / 'Candidate.lean').read_text())
    if re.search(r'\b(axiom|opaque|constant|sorry|sorryAx|native_decide|unsafe)\b|decide\s*\+native', raw):
        raise RuntimeError('Admitted inline candidate')
    if re.findall(r'^set_option (maxHeartbeats|maxRecDepth) ([0-9]+)$', raw, re.M) != [
            ('maxHeartbeats', '200000'), ('maxRecDepth', '1000')]:
        raise RuntimeError('Unexpected proof limits')
    for name in FUNCTIONS:
        if not re.search(r'^def ' + re.escape(name) + r'\s', raw, re.M):
            raise RuntimeError('Missing source definition: ' + name)
    return raw.replace('import Aeneas\n', '')


def validate_ir(ir):
    BASE['BASE']['validate_ir'](ir)
    crate = ir['translated']
    options = crate.get('options', {})
    if options.get('monomorphize') is not True or options.get('inline_functions') != [
            NAMESPACE + '::adjust', 'core::option::_::and_then']:
        raise RuntimeError('Wrong monomorphization/inlining selection')
    functions = [f for f in crate['fun_decls'] if isinstance(f, dict)]
    def names(f): return [x['Ident'][0] for x in f['item_meta']['name'] if 'Ident' in x]
    if any(names(f)[-1:] in [['adjust'], ['and_then']] for f in functions):
        raise RuntimeError('Selected function was not inlined')
    for name in ['twice', 'capture']:
        selected = [f for f in functions if names(f) == [NAMESPACE, name]]
        if len(selected) != 1 or not isinstance(selected[0].get('body'), dict) or set(selected[0]['body']) != {'Structured'}:
            raise RuntimeError('Missing source body: ' + name)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='inline-equivalence-', dir=parent))
    record = {'status': 'started', 'claim': 'fixture model equivalence only; compiler/native security refinement unproved',
              'commands': [], 'script_sha256': digest(Path(__file__).read_bytes())}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT, check=True)
    print('Inline equivalence artifacts: ' + str(out), flush=True); save()
    try:
        receipt, tools, sources = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        record['backend_patches'] = PARAMETERS['verify_backend'](args.backend.resolve(), out)
        record['inputs'] = {name: digest((DATA / name).read_bytes()) for name in ['fixture.rs', 'Baseline.lean', 'Proof.lean', 'Candidate.lean', 'Equivalence.lean']}
        baseline = BASE['validate_output']((DATA / 'Baseline.lean').read_text())
        baseline = baseline.replace('import Aeneas.Std\n', 'import Aeneas.Std\nimport Aeneas.Data.Discriminant\n')
        llbc = out / 'candidate.llbc'
        run([tools / 'charon', 'rustc', '--preset=aeneas', '--monomorphize', '--inline-function', NAMESPACE + '::adjust',
             '--inline-function', 'core::option::_::and_then', '--include', 'core::option', '--include', 'core::result',
             '--include', 'core::convert', '--dest-file', llbc, '--', '--crate-type', 'lib', '--edition', '2024',
             '--crate-name', NAMESPACE, DATA / 'fixture.rs'], 'charon.log')
        validate_ir(json.loads(llbc.read_text()))
        run([tools / 'aeneas', '-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000', '-max-recdepth', '1000',
             '-abort-on-error', '-no-external-name-patterns', '-disambiguate-instantiated-names', '-monomorphic-builtin-shapes',
             '-dest', out / 'lean', llbc], 'aeneas.log')
        BASE['validate_frontend_log']((out / 'aeneas.log').read_text())
        raw = (out / 'lean/Candidate.lean').read_text()
        runtime = validate_output(raw)
        names = [NAMESPACE + '.' + n for n in FUNCTIONS] + ['HasteBootsInlineEquivalence.' + n for n in DECODERS + PROOFS]
        checked = out / 'Checked.lean'
        checked.write_text(baseline + '\n' + runtime + '\n' + (DATA / 'Equivalence.lean').read_text()
                           + ''.join('\n#print axioms ' + n + '\n' for n in names))
        run([ROOT / 'scripts/in-container', 'bash', '-euc', 'cd -- "$1"; lake env lean -DwarningAsError=true "$2"', '_',
             COMMON['container_path'](args.backend.resolve() / 'backends/lean'), COMMON['container_path'](checked)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        record.update(llbc_sha256=digest(llbc.read_bytes()), checked_sha256=digest(checked.read_bytes()))
        if record['inputs'] != {name: digest((DATA / name).read_bytes()) for name in record['inputs']}:
            raise RuntimeError('Input changed during check')
        if BUILD['verify_sources'](Path(receipt['charon_source']), Path(receipt['frontend_source'])) != sources:
            raise RuntimeError('Compiler source changed during check')
        for name, expected in receipt['tools'].items():
            if digest((tools / name).read_bytes()) != expected: raise RuntimeError('Compiler changed during check')
        record['status'] = 'passed'; print('Inline equivalence passed: ' + str(len(names)) + ' dependency audits')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); raise SystemExit('Inline equivalence failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
