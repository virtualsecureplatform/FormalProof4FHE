#!/usr/bin/env python3
"""Re-extract original release slice bodies, check source retention and Lean proofs."""
import argparse
import copy
import hashlib
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT / 'interop/aeneas/reference-retag-body'
MODEL = ROOT / 'FormalProof4FHE/HasteBoots/NativeSliceLLBC.lean'
BUILD = runpy.run_path(str(ROOT / 'scripts/build-hasteboots-inline-tools'))
PARAMETERS = runpy.run_path(str(ROOT / 'scripts/extract-hasteboots-parameters'))
REIFIER = runpy.run_path(str(ROOT / 'scripts/reify-hasteboots-reference-retag-llbc'))
EXTRAS = {'Element': ['byte', 'word'], 'Ty': ['unit', 'usize', 'raw', 'reference'],
 'Raw': ['mk', 'storage', 'length'], 'Value': ['unit', 'usize', 'raw', 'reference'],
 'Input': ['usize', 'rawRegister'], 'Slot': ['dead', 'live'],
 'Frame': ['mk', 'types', 'slots', 'world'], 'Operand': ['copy', 'move'],
 'Rvalue': ['use', 'rawCast', 'borrow', 'unit'],
 'Body': ['done', 'ret', 'resume', 'abort', 'unsupported', 'storageLive', 'storageDead', 'assign', 'parts', 'constIf', 'call'],
 'Function': ['mk', 'name', 'types', 'argCount', 'body'],
 'Flow': ['continued', 'returned', 'unwind', 'invalid', 'unsupported']}


def digest(raw): return hashlib.sha256(raw).hexdigest()


def inventory():
    raw = MODEL.read_text()
    PARAMETERS['validate_proof_source'](raw, re.findall(r'^theorem (\w+)', raw, re.M))
    names = re.findall(r'^(?:def|theorem|structure|inductive) ([\w.]+)', raw, re.M)
    names += [p + '.' + n for p, ns in EXTRAS.items() for n in ns]
    return ['FormalProof4FHE.HasteBoots.NativeSliceLLBC.' + n for n in names]


def nodes(value):
    yield value
    if isinstance(value, dict):
        for child in value.values(): yield from nodes(child)
    elif isinstance(value, list):
        for child in value: yield from nodes(child)


def negatives(ir):
    results = {}
    def check(name, mutate):
        changed = copy.deepcopy(ir)
        mutate(changed['translated'])
        try: REIFIER['Reifier'](changed).render()
        except (ValueError, KeyError, TypeError, IndexError) as error: results[name] = str(error)
        else: raise RuntimeError('Negative accepted: ' + name)
    def body(c): return c['fun_decls'][3]['body']['Structured']['body']
    def first(c, key): return next(x for x in nodes(body(c)) if isinstance(x, dict) and key in x and (key != 'Ref' or isinstance(x[key], dict)))
    check('wrong_target', lambda c: c['target_information'][0]['value'].update(target_pointer_size=4))
    check('wrong_endian', lambda c: c['target_information'][0]['value'].update(is_little_endian=False))
    check('opaque_active_body', lambda c: c['fun_decls'][3].update(body='Opaque'))
    check('hidden_active_declaration', lambda c: c['fun_decls'][3]['item_meta'].update(opacity='Opaque'))
    check('residual_drop', lambda c: body(c)['statements'][0].update(kind={'Drop': None}))
    check('unknown_statement_field', lambda c: body(c)['statements'][0].update(hidden_effect='Drop'))
    check('bad_storage_index', lambda c: body(c)['statements'][0].update(kind={'StorageLive': 999}))
    check('active_unsupported_ub_check', lambda c: first(c, 'Bool').update(Bool=True))
    check('pointer_parts_mutability', lambda c: first(c, 'PtrFromParts').update(PtrFromParts='Mut'))
    check('wrong_metadata', lambda c: first(c, 'Ref')['Ref'].update(ptr_metadata=None))
    check('wrong_borrowed_element', lambda c: first(c, 'Ref')['Ref']['place'].update(ty={'Untagged': {'Slice': {'Untagged': {'Literal': {'UInt': 'U32'}}}}}))
    check('unsupported_layout', lambda c: c['global_decls'][0]['value']['kind']['Literal']['Scalar'].update(Unsigned=['Usize', '4']))
    check('missing_runtime_policy', lambda c: c['options'].update(precise_drops=False))
    check('source_rewrite_policy', lambda c: c['options'].update(inline_functions=['core::slice::raw::from_raw_parts']))
    def helper_use(c): return c['fun_decls'][5]['body']['Structured']['body']['statements'][1]['kind']['Assign'][1]['Use']
    def bound_call(c):
        return next(s['kind']['Call']['call'] for s in c['fun_decls'][1]['body']['Structured']['body']['statements']
                    if isinstance(s['kind'],dict) and 'Call' in s['kind'] and s['kind']['Call']['call']['func']['Regular']['kind']['Fun'] == {'Regular':0})
    check('unknown_retag_flag', lambda c: helper_use(c).__setitem__(1,'Unknown'))
    def copy_mutable(c):
        operand=helper_use(c)[0];operand['Copy']=operand.pop('Move')
    check('copy_mutable_reference', copy_mutable)
    check('noncanonical_region_binder', lambda c: c['fun_decls'][0]['generics']['regions'][0].update(index=1))
    check('unbound_signature_region', lambda c: c['fun_decls'][0]['signature']['inputs'][0]['Untagged']['Ref'][0]['Var'].update(Free=1))
    check('unbound_call_region', lambda c: bound_call(c)['func']['Regular']['generics']['regions'][0].update(Body=999))
    check('missing_call_region', lambda c: bound_call(c)['func']['Regular']['generics'].update(regions=[]))
    return results


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    args = parser.parse_args()
    out = Path(tempfile.mkdtemp(prefix='reference-retag-body-', dir=ROOT / 'build/hasteboots-extraction'))
    record = {'status': 'started', 'claim': 'original reference Use retags and validated region-index erasure; compiler, Rust lifetimes, native constructor and security refinement remain unproved', 'commands': []}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            result = subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT)
        if result.returncode: raise RuntimeError('Command failed: ' + log)
    print('Reference retag artifacts: ' + str(out), flush=True)
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        files = [Path(__file__), ROOT / 'scripts/reify-hasteboots-reference-retag-llbc', ROOT / 'scripts/reify-hasteboots-scalar-llbc', ROOT / 'scripts/reify-hasteboots-slice-reference-llbc', ROOT / 'scripts/reify-hasteboots-slice-scope-llbc', MODEL,
                 ROOT / 'FormalProof4FHETest/HasteBootsRetagSmoke.lean', ROOT / 'FormalProof4FHETest/HasteBootsSliceLLBCAudit.lean', ROOT / 'lean-toolchain',
                 *[DATA / n for n in ['fixture.rs', 'Generated.lean', 'Retained.json', 'Proof.lean', 'Bridge.lean', 'Smoke.lean', 'RetagDisabledSmoke.lean']]]
        record['inputs'] = {str(p.relative_to(ROOT)): digest(p.read_bytes()) for p in files}
        run([ROOT / 'scripts/in-container', 'lake', 'build', 'FormalProof4FHE.HasteBoots.NativeSliceLLBC', 'FormalProof4FHETest.HasteBootsRetagSmoke', 'FormalProof4FHETest.HasteBootsSliceLLBCAudit'], 'root-build.log')
        base = [tools / 'charon', 'rustc', '--preset=aeneas', '--sysroot', 'default', '--monomorphize', '--mir', 'optimized', '--consts', 'values',
                '--evaluate-runtime-checks', '--precise-drops', '--desugar-drops', '--preserve-allocator', '--no-dedup-serialized-ast',
                '--include', 'core::slice::raw::from_raw_parts', '--include', 'core::slice::raw::from_raw_parts_mut', '--include', 'core::ptr::metadata']
        def extract(name, debug):
            path = out / (name + '.llbc')
            run(base + ['--dest-file', path, '--', '--crate-type', 'lib', '--edition', '2024', '-Cdebug-assertions=' + debug,
                        '--crate-name', 'hasteboots_reference_retag_body', (DATA / 'fixture.rs').relative_to(ROOT)], name + '-charon.log')
            return json.loads(path.read_text())
        run([ROOT / 'scripts/check-hasteboots-slice-scope-body', '--build-receipt', args.build_receipt], 'parent-slice-scope.log')
        parent_path = Path((out / 'parent-slice-scope.log').read_text().splitlines()[0].split(': ', 1)[1]) / 'manifest.json'
        parent = json.loads(parent_path.read_text())
        if parent.get('status') != 'passed' or parent['build_receipt_sha256'] != record['build_receipt_sha256']:
            raise RuntimeError('Parent profile did not pass with the same tools')
        record['parent_slice_scope'] = {'manifest': str(parent_path.relative_to(ROOT)), 'manifest_sha256': digest(parent_path.read_bytes()), 'dependency_audit_count': len(parent['dependency_audit'])}
        ir = extract('release', 'no')
        r = REIFIER['Reifier'](ir); generated = r.render()
        retained = {'active_functions': r.records, 'inactive_unsupported': r.retained,
                    'claim': 'original reference Use retags and checked region-index erasure; Rust lifetimes and compiler/native/security refinement unproved'}
        if generated != (DATA / 'Generated.lean').read_text() or retained != json.loads((DATA / 'Retained.json').read_text()):
            raise RuntimeError('Original source snapshot differs')
        if len(r.cache) != 6 or len(r.globals) != 4 or not r.retained: raise RuntimeError('Incomplete source closure')
        record['functions'] = r.records
        record['inactive_unsupported_count'] = len(r.retained)
        record['negative_controls'] = negatives(ir)
        debug_ir = extract('debug', 'yes')
        try: REIFIER['Reifier'](debug_ir).render()
        except (ValueError, KeyError, TypeError, IndexError) as error: record['debug_active_rejection'] = str(error)
        else: raise RuntimeError('Unsupported debug profile accepted')
        changed = copy.deepcopy(ir)
        stmts = changed['translated']['fun_decls'][3]['body']['Structured']['body']['statements']
        stmts[-2], stmts[-3] = stmts[-3], stmts[-2]
        if REIFIER['Reifier'](changed).render() == generated: raise RuntimeError('Supported syntax mutation ignored')
        record['supported_body_mutation_retained'] = True
        disabled=copy.deepcopy(ir)
        disabled['translated']['fun_decls'][5]['body']['Structured']['body']['statements'][1]['kind']['Assign'][1]['Use'][1]='No'
        disabled_generated=REIFIER['Reifier'](disabled).render()
        if disabled_generated==generated: raise RuntimeError('WithRetag mutation ignored')
        disabled_checked=out/'RetagDisabled.lean'
        disabled_checked.write_text(disabled_generated+'\n'+(DATA/'RetagDisabledSmoke.lean').read_text())
        run([ROOT/'scripts/in-container','lake','env','lean','-DwarningAsError=true',disabled_checked.relative_to(ROOT)],'retag-disabled-lean.log')
        record['retag_disabled_kernel_control']={'original_mutable_leases':4,'disabled_mutable_leases':3,'original_flag':'Yes','mutated_flag':'No'}

        names = inventory() + ['HasteBootsReferenceRetagBody.f' + str(i) for i in range(6)] + ['HasteBootsReferenceRetagBody.g' + str(i) for i in range(4)]
        raw = (DATA / 'Proof.lean').read_text() + '\n' + (DATA / 'Bridge.lean').read_text()
        PARAMETERS['validate_proof_source'](raw, re.findall(r'^theorem (\w+)', raw, re.M))
        names += ['HasteBootsReferenceRetagBody.' + n for n in re.findall(r'^(?:def|theorem) (\w+)', raw, re.M)]
        checked = out / 'Checked.lean'
        checked.write_text(generated + '\n' + raw + '\n' + (DATA / 'Smoke.lean').read_text() + ''.join('\n#print axioms ' + n + '\n' for n in names))
        run([ROOT / 'scripts/in-container', 'lake', 'env', 'lean', '-DwarningAsError=true', checked.relative_to(ROOT)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        record['llbc_sha256'] = digest((out / 'release.llbc').read_bytes())
        record['checked_sha256'] = digest(checked.read_bytes())
        if record['inputs'] != {str(p.relative_to(ROOT)): digest(p.read_bytes()) for p in files}: raise RuntimeError('Inputs changed during validation')
        BUILD['verify_receipt'](args.build_receipt)
        record['status'] = 'passed'
        print('Reference retag passed: ' + str(len(names)) + ' audits; ' + str(len(record['negative_controls'])) + ' rejecting controls; debug profile rejected')
    except Exception as error:
        record.update(status='failed', error=str(error)); raise SystemExit(str(error) + '; inspect ' + str(out)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__': main()
