#!/usr/bin/env python3
"""Prevent native constructor probes from hiding residual or imprecise drops."""
import copy
from pathlib import Path
import runpy
import unittest

ROOT = Path(__file__).resolve().parent.parent
GATE = runpy.run_path(str(ROOT / 'scripts/probe-hasteboots-inline-constructor'))


class Guards(unittest.TestCase):
    def fixture(self):
        return {'has_errors': False, 'translated': {
            'target_information': [{'key': 'x86_64-unknown-linux-gnu', 'value': {
                'target_pointer_size': 8, 'is_little_endian': True}}],
            'options': {'precise_drops': True, 'desugar_drops': True, 'preserve_allocator': True, 'evaluate_runtime_checks': True},
            'fun_decls': [{'def_id': 0, 'body': {'Structured': {'Call': {}}}}]}}

    def test_precise_calls_accepted(self):
        GATE['validate_drop_ir'](self.fixture())

    def test_missing_flags_or_nested_drop_rejected(self):
        original = self.fixture()
        for field in ['precise_drops', 'desugar_drops', 'preserve_allocator', 'evaluate_runtime_checks']:
            changed = copy.deepcopy(original); changed['translated']['options'][field] = False
            with self.assertRaises(RuntimeError): GATE['validate_drop_ir'](changed)
        changed = copy.deepcopy(original)
        changed['translated']['fun_decls'][0]['body']['Structured']['Call']['on_unwind'] = [{'Drop': {}}]
        with self.assertRaises(RuntimeError): GATE['validate_drop_ir'](changed)

    def test_unevaluated_runtime_query_rejected(self):
        for query in ['UbChecks', 'OverflowChecks', 'ContractChecks']:
            ir = self.fixture()
            ir['translated']['fun_decls'][0]['body'] = {'NullaryOp': [query, 'bool']}
            with self.assertRaises(RuntimeError): GATE['validate_drop_ir'](ir)

    def test_multiline_admission_frontier(self):
        raw = 'axiom core.pointer : Type\naxiom\n  core.layout.default : Unit\n'
        self.assertEqual(GATE['extract_axiom_names'](raw), ['core.pointer', 'core.layout.default'])

    def test_stdlib_and_constant_policy_cannot_silently_change(self):
        ir = self.fixture()
        ir['translated']['options'].update(sysroot='default')
        GATE['validate_probe_options'](ir, 'default', False)
        for root, values in [('miri', False), ('auto', False), ('default', True), ('unknown', False)]:
            with self.assertRaises(RuntimeError): GATE['validate_probe_options'](ir, root, values)
        ir['translated']['options'].update(consts='Values')
        GATE['validate_probe_options'](ir, 'default', True)
        with self.assertRaises(RuntimeError): GATE['validate_probe_options'](ir, 'default', False)

    def test_missing_function_reference_rejected(self):
        ir = self.fixture()
        ir['translated']['fun_decls'][0]['body']['Structured']['Call'] = {'kind': {'Fun': {'Regular': 7}}}
        with self.assertRaises(RuntimeError): GATE['validate_drop_ir'](ir)
        ir['translated']['fun_decls'].append({'def_id': 7, 'body': 'Opaque'})
        GATE['validate_drop_ir'](ir)


if __name__ == '__main__':
    unittest.main()
