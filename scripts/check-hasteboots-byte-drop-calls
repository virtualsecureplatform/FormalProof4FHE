#!/usr/bin/env python3
"""Check retained byte-drop calls into the original typed loop; native refinement remains open."""
import argparse
import copy
import hashlib
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT / 'interop/aeneas/byte-drop-calls'
MODEL = ROOT / 'FormalProof4FHE/HasteBoots/NativeByteDropCalls.lean'
BUILD = runpy.run_path(str(ROOT / 'scripts/build-hasteboots-inline-tools'))
PARAMETERS = runpy.run_path(str(ROOT / 'scripts/extract-hasteboots-parameters'))
REIFIER = runpy.run_path(str(ROOT / 'scripts/reify-hasteboots-byte-drop-calls-llbc'))
PARENT = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-byte-loop-body'))
EXTRAS = {
    'Classification': ['transparent', 'foreignBody', 'externalBody'],
    'Code': ['done', 'deallocate', 'native', 'call', 'loop'],
    'Definition': ['mk', 'name', 'classification', 'types', 'argCount', 'code'],
    'Resume': ['next', 'unwind', 'invalid', 'unsupported'],
    'Runs': ['done', 'deallocate', 'nativeNext', 'nativeStop', 'callInvalid', 'callNext', 'callUnwind', 'callStopped',
             'callUnsupported', 'loopArgumentInvalid', 'loopInitialInvalid', 'loopRun'],
    'Invokes': ['argumentsInvalid', 'initialInvalid', 'run'],
}


def digest(raw): return hashlib.sha256(raw).hexdigest()


def inventory():
    raw = MODEL.read_text()
    PARAMETERS['validate_proof_source'](raw, re.findall(r'^theorem (\w+)', raw, re.M))
    names = re.findall(r'^(?:def|theorem|structure|inductive) ([\w.]+)', raw, re.M)
    names += [p + '.' + n for p, ns in EXTRAS.items() for n in ns]
    names = ['FormalProof4FHE.HasteBoots.NativeByteDropCalls.' + n for n in names]
    raw = (ROOT / 'FormalProof4FHE/HasteBoots/NativeByteDeallocation.lean').read_text()
    PARAMETERS['validate_proof_source'](raw, re.findall(r'^theorem (\w+)', raw, re.M))
    return names + ['FormalProof4FHE.HasteBoots.NativeByteDeallocation.' + n
                    for n in re.findall(r'^(?:def|theorem) ([\w.]+)', raw, re.M)]


def negatives(ir):
    records = PARENT['negatives'](ir)
    def check(name, mutate):
        changed = copy.deepcopy(ir)
        mutate(changed['translated'])
        try: REIFIER['Reifier'](changed).render()
        except (ValueError, KeyError, TypeError, IndexError) as error: records[name] = str(error)
        else: raise RuntimeError('Negative accepted: ' + name)
    def statements(c, fid): return c['fun_decls'][fid]['body']['Structured']['body']['statements']
    def call(c, fid, pos): return statements(c, fid)[pos]['kind']['Call']['call']
    check('missing_retained_callee', lambda c: call(c, 0, 7)['func']['Regular']['kind']['Fun'].update(Regular=99))
    check('recursive_retained_call', lambda c: call(c, 3, 5)['func']['Regular']['kind']['Fun'].update(Regular=3))
    check('caller_call_unknown_effect', lambda c: statements(c, 3)[5]['kind']['Call'].update(hidden_effect='Drop'))
    check('caller_statement_unknown_effect', lambda c: statements(c, 3)[0].update(hidden_effect='Drop'))
    check('caller_wrong_argument_type', lambda c: call(c, 0, 7)['args'].__setitem__(1, copy.deepcopy(call(c, 0, 7)['args'][0])))
    check('caller_missing_call_region', lambda c: call(c, 2, 4)['func']['Regular']['generics'].update(regions=[]))
    check('caller_unbound_call_region', lambda c: call(c, 2, 4)['func']['Regular']['generics'].update(regions=[{'Body': 999}]))
    check('foreign_reclassified', lambda c: c['fun_decls'][3]['item_meta'].update(opacity='Transparent'))
    check('foreign_body_removed', lambda c: c['fun_decls'][3].update(body=None))
    check('caller_bad_storage', lambda c: statements(c, 3)[6].update(kind={'StorageDead': 99}))
    check('caller_unknown_retag', lambda c: statements(c, 0)[4]['kind']['Assign'][1]['Use'].__setitem__(1, 'Unknown'))
    return records


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    args = parser.parse_args()
    out = Path(tempfile.mkdtemp(prefix='byte-drop-calls-', dir=ROOT / 'build/hasteboots-extraction'))
    record = {'status': 'started', 'commands': [],
              'claim': 'all five retained byte-drop bodies interpreted with explicit cleanup; Foreign preserved; native foreign-call/compiler/lifetime/security refinement unproved',
              'all_five_retained_bodies_interpreted': True, 'foreign_classification_preserved': True,
              'native_foreign_call_refinement': False, 'rust_lifetime_refinement': False, 'native_constructor_accepted': False}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            result = subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT)
        if result.returncode: raise RuntimeError('Command failed: ' + log)
    print('Byte drop calls artifacts: ' + str(out), flush=True)
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        files = [Path(__file__), ROOT / 'scripts/reify-hasteboots-byte-drop-calls-llbc',
                 ROOT / 'scripts/check-hasteboots-byte-loop-body', ROOT / 'scripts/reify-hasteboots-byte-loop-llbc',
                 ROOT / 'scripts/check-hasteboots-byte-drop-primitives', ROOT / 'scripts/reify-hasteboots-slice-reference-llbc',
                 ROOT / 'scripts/reify-hasteboots-slice-scope-llbc', ROOT / 'scripts/reify-hasteboots-scalar-llbc', MODEL,
                 ROOT / 'FormalProof4FHE/HasteBoots/NativeByteDeallocation.lean',
                 ROOT / 'FormalProof4FHETest/HasteBootsByteDropCallsSmoke.lean',
                 ROOT / 'FormalProof4FHETest/HasteBootsByteDropCallsAudit.lean', ROOT / 'lean-toolchain',
                 ROOT / 'interop/aeneas/byte-loop-body/Proof.lean', ROOT / 'interop/aeneas/byte-drop-loop/fixture.rs',
                 *[DATA / name for name in ['Generated.lean', 'Retained.json', 'Proof.lean', 'Smoke.lean']]]
        record['inputs'] = {str(p.relative_to(ROOT)): digest(p.read_bytes()) for p in files}
        run([ROOT / 'scripts/in-container', 'lake', 'build', 'FormalProof4FHETest.HasteBootsByteDropCallsSmoke',
             'FormalProof4FHETest.HasteBootsByteDropCallsAudit'], 'root-build.log')
        run([ROOT / 'scripts/check-hasteboots-byte-loop-body', '--build-receipt', args.build_receipt], 'parent-byte-loop.log')
        parent_path = Path((out / 'parent-byte-loop.log').read_text().splitlines()[0].split(': ', 1)[1]) / 'manifest.json'
        parent = json.loads(parent_path.read_text())
        if parent.get('status') != 'passed' or parent['build_receipt_sha256'] != record['build_receipt_sha256']:
            raise RuntimeError('Parent did not pass with the same tools')
        record['parent_byte_loop'] = {'manifest': str(parent_path.relative_to(ROOT)),
                                     'manifest_sha256': digest(parent_path.read_bytes()),
                                     'dependency_audit_count': len(parent['dependency_audit'])}
        llbc = out / 'source.llbc'
        run([tools / 'charon', 'rustc', '--preset=aeneas', '--sysroot', 'default', '--monomorphize', '--mir', 'optimized',
             '--consts', 'values', '--evaluate-runtime-checks', '--precise-drops', '--desugar-drops', '--preserve-allocator',
             '--no-dedup-serialized-ast', '--include', 'core::ptr::drop_in_place', '--include', 'core::ptr::slice_from_raw_parts_mut',
             '--dest-file', llbc, '--', '--crate-type', 'lib', '--edition', '2024', '-Cdebug-assertions=no',
             '--crate-name', 'hasteboots_byte_drop_loop', 'interop/aeneas/byte-drop-loop/fixture.rs'], 'charon.log')
        ir = json.loads(llbc.read_text()); r = REIFIER['Reifier'](ir); generated = r.render()
        retained = {'functions': [r.functions[i] for i in range(5)],
                    'claim': 'retained body-call interpretation with explicit cleanup; Foreign classification preserved; native foreign-call/compiler/lifetime/security refinement unproved'}
        if generated != (DATA / 'Generated.lean').read_text() or retained != json.loads((DATA / 'Retained.json').read_text()):
            raise RuntimeError('Original body snapshot differs')
        record['negative_controls'] = negatives(ir)
        changed = copy.deepcopy(ir)
        suffix = changed['translated']['fun_decls'][3]['body']['Structured']['body']['statements']
        suffix[6]['kind'], suffix[7]['kind'] = suffix[7]['kind'], suffix[6]['kind']
        changed_generated = REIFIER['Reifier'](changed).render()
        if changed_generated == generated: raise RuntimeError('Supported caller storage-order mutation ignored')
        names = inventory() + ['HasteBootsByteLoopBody.f4'] + ['HasteBootsByteDropProbe.f' + str(i) for i in range(4)]
        proof = ''
        for directory, namespace in [('byte-loop-body', 'HasteBootsByteLoopBody'), ('byte-drop-calls', 'HasteBootsByteDropProbe')]:
            raw = (ROOT / 'interop/aeneas' / directory / 'Proof.lean').read_text()
            PARAMETERS['validate_proof_source'](raw, re.findall(r'^theorem (\w+)', raw, re.M))
            names += [namespace + '.' + n for n in re.findall(r'^(?:def|theorem) (\w+)', raw, re.M)]
            proof += '\n' + raw
        smoke = (DATA / 'Smoke.lean').read_text()
        checked = out / 'Checked.lean'
        checked.write_text(generated + proof + '\n' + smoke + ''.join('\n#print axioms ' + n + '\n' for n in names))
        run([ROOT / 'scripts/in-container', 'lake', 'env', 'lean', '-DwarningAsError=true', checked.relative_to(ROOT)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        mutant = out / 'CallerStorageOrder.lean'; mutant.write_text(changed_generated + proof + '\n' + smoke)
        run([ROOT / 'scripts/in-container', 'lake', 'env', 'lean', '-DwarningAsError=true', mutant.relative_to(ROOT)], 'caller-storage-order-lean.log')
        record['supported_caller_storage_order_mutation'] = {'function': 3, 'statements': [6, 7],
            'generated_changed': True, 'source_proofs_and_regressions_passed': True}
        record['llbc_sha256'] = digest(llbc.read_bytes()); record['checked_sha256'] = digest(checked.read_bytes())
        if record['inputs'] != {str(p.relative_to(ROOT)): digest(p.read_bytes()) for p in files}:
            raise RuntimeError('Inputs changed during validation')
        BUILD['verify_receipt'](args.build_receipt); record['status'] = 'passed'
        print('Byte drop calls passed: ' + str(len(names)) + ' audits; ' + str(len(record['negative_controls'])) +
              ' rejecting controls; original calls and loop composed with explicit cleanup')
    except Exception as error:
        record.update(status='failed', error=str(error)); raise SystemExit(str(error) + '; inspect ' + str(out)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__': main()
