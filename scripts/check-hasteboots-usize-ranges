#!/usr/bin/env python3
"""Check constrained usize storage; casts and native heap refinement remain open."""
import argparse
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-inline-equivalence'))
RANGES = runpy.run_path(str(ROOT / 'scripts/probe-hasteboots-u32-ranges'))
BUILD, PARAMETERS, COMMON, digest = BASE['BUILD'], BASE['PARAMETERS'], BASE['COMMON'], BASE['digest']
DATA = ROOT / 'interop/aeneas/usize-ranges'
PROOFS = ['preserve_exact', 'select_exact', 'identity_exact', 'capacity_bounds', 'window_bounds', 'select_sound']
NAMESPACE = 'hasteboots_usize_ranges'


def validate_output(raw):
    PARAMETERS['verify_snapshot'](raw, (DATA / 'Generated.lean').read_text())
    PARAMETERS['validate_proof_source']((DATA / 'Proof.lean').read_text(), PROOFS)
    return RANGES['validate_output'](raw, NAMESPACE, ['Stored', 'preserve', 'select', 'identity'])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='usize-ranges-', dir=parent))
    record = {'status': 'started', 'claim': 'read-only constrained usize storage; casts/native heap/work/security unproved',
              'script_sha256': digest(Path(__file__).read_bytes()), 'commands': []}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log, required=True):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            status = subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT).returncode
        if required and status: raise RuntimeError(log + ' exited ' + str(status))
        return status
    print('Usize range artifacts: ' + str(out), flush=True); save()
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        record['backend_patches'] = PARAMETERS['verify_backend'](args.backend.resolve(), out)
        files = ['fixture.rs', 'Generated.lean', 'Proof.lean', 'unsupported-u64.rs', 'unsupported-disjoint.rs']
        record['inputs'] = {name: digest((DATA / name).read_bytes()) for name in files}
        def extract(source, name):
            llbc = out / (name + '.llbc')
            run([tools / 'charon', 'rustc', '--preset=aeneas', '--monomorphize', '--dest-file', llbc,
                 '--', '--crate-type', 'lib', '--edition', '2024', '--crate-name', NAMESPACE,
                 (DATA / source).relative_to(ROOT)], name + '-charon.log')
            return llbc
        options = ['-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000', '-max-recdepth', '1000',
                   '-abort-on-error', '-no-external-name-patterns', '-disambiguate-instantiated-names']
        def frontend(llbc, name, enabled=True, required=True):
            return run([tools / 'aeneas', *options, *(['-monomorphic-builtin-shapes'] if enabled else []),
                        '-dest', out / name, llbc], name + '-frontend.log', required)
        llbc = extract('fixture.rs', 'positive')
        ir = json.loads(llbc.read_text())
        if ir['translated'].get('options', {}).get('monomorphize') is not True:
            raise RuntimeError('Expected monomorphic range extraction')
        record['ranges'] = RANGES['inspect_patterns'](ir, [(0, 9223372036854775807), (7, 19)], 'Usize')
        frontend(llbc, 'positive')
        BASE['BASE']['validate_frontend_log']((out / 'positive-frontend.log').read_text())
        generated = list((out / 'positive').glob('*.lean'))
        if len(generated) != 1: raise RuntimeError('Expected complete single generated module')
        raw = generated[0].read_text()
        runtime = validate_output(raw)
        names = [NAMESPACE + '.' + n for n in ['preserve', 'select', 'identity']]
        names += ['HasteBootsUsizeRangeProof.' + n for n in PROOFS]
        checked = out / 'Checked.lean'
        checked.write_text('import Aeneas.Std\n' + runtime + '\n'
                           + (DATA / 'Proof.lean').read_text()
                           + ''.join('\n#print axioms ' + n + '\n' for n in names))
        run([ROOT / 'scripts/in-container', 'bash', '-euc', 'cd -- "$1"; lake env lean -DwarningAsError=true "$2"', '_',
             COMMON['container_path'](args.backend.resolve() / 'backends/lean'), COMMON['container_path'](checked)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        record.update(llbc_sha256=digest(llbc.read_bytes()), checked_sha256=digest(checked.read_bytes()))
        record['rejected'] = []
        for source, name, enabled, error in [
                ('unsupported-u64.rs', 'u64', True, 'Unsupported scalar pattern type'),
                ('unsupported-disjoint.rs', 'disjoint', True, 'Unsupported scalar pattern type'),
                (None, 'disabled', False, 'Usize ranges require monomorphic builtin shapes')]:
            bad = extract(source, name) if source else llbc
            status = frontend(bad, name, enabled, False)
            log = (out / (name + '-frontend.log')).read_text()
            if status == 0 or error not in log: raise RuntimeError('Unsupported range accepted: ' + name)
            record['rejected'].append(name)
        if record['inputs'] != {name: digest((DATA / name).read_bytes()) for name in files}:
            raise RuntimeError('Input changed during check')
        BUILD['verify_receipt'](args.build_receipt)
        record['status'] = 'passed'; print('Usize ranges passed: nine dependency audits; three unsupported cases rejected')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); raise SystemExit('Usize range check failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
