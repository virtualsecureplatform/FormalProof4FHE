#!/usr/bin/env python3
"""Retain actual native Serde/Bincode bodies and diagnose translation; never certify bytes."""
import argparse
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / 'scripts/extract-hasteboots-registry'))
BUILD = runpy.run_path(str(ROOT / 'scripts/build-hasteboots-static-frontend'))
DATA = ROOT / 'interop/aeneas/code-serialization'
ERROR_TYPES = ['std::io::error::Error', 'std::io::error::repr_bitpacked::Repr',
               'core::ptr::non_null::NonNull', 'std::time::SystemTime', 'std::time::SystemTimeError',
               'std::sys::time::unix::SystemTime', 'std::sys::pal::unix::time::Timespec',
               'core::time::Duration', 'core::num::niche_types::Nanoseconds']
TIME_TYPES = ERROR_TYPES[3:]


def inspect_ir(ir, mode='code', retain_error_types=False, retain_time_types=False):
    if ir.get('has_errors') is not False or ir['translated']['target_information'] != [
            {'key': 'x86_64-unknown-linux-gnu', 'value': {'target_pointer_size': 8, 'is_little_endian': True}}]:
        raise RuntimeError('Incomplete or wrong-target serialization IR')
    functions = [f for f in ir['translated']['fun_decls'] if f]
    required = [(['formalproof4fhe_native_registry_fixture', 'code_bytes'], 'wrapper'),
                (['bincode', 'features', 'serde', 'ser', 'encode_to_vec'], 'bincode'),
                (['pcs', 'utils', 'code', 'block', 'serialize'], 'code'),
                (['algebra', 'goldilocks', 'serialize'], 'root')]
    if mode == 'word':
        required = [(['formalproof4fhe_native_registry_fixture', 'encode_word'], 'wrapper'),
                    (['bincode', 'features', 'impl_alloc', 'encode_to_vec'], 'bincode'),
                    (['bincode', 'enc', 'impls', 'encode'], 'integer'),
                    (['bincode', 'varint', 'encode_unsigned', 'varint_encode_u64'], 'varint'),
                    (['core', 'marker', 'clone'], 'phantom-clone')]
    elif mode != 'code':
        raise RuntimeError('Unknown serialization surface')
    retained = {}
    for prefix, label in required:
        matches = [f for f in functions if
                   [i['Ident'][0] for i in f['item_meta']['name'] if 'Ident' in i and i['Ident'][0] != '_'] == prefix]
        if len(matches) != 1 or not isinstance(matches[0].get('body'), dict) or 'Structured' not in matches[0]['body']:
            raise RuntimeError('Missing transparent source body: ' + label)
        retained[label] = matches[0]['def_id']
    pool = {}
    def collect(value):
        if isinstance(value, dict):
            if 'HashConsedValue' in value:
                index, content = value['HashConsedValue']
                if index in pool and pool[index] != content:
                    raise RuntimeError('Conflicting hash-consed type')
                pool[index] = content
            for child in value.values(): collect(child)
        elif isinstance(value, list):
            for child in value: collect(child)
    collect(ir)
    def regions(value, seen=frozenset()):
        if value == 'Erased': return {'erased'}
        if isinstance(value, dict):
            if 'Body' in value: return {'body'}
            if 'Deduplicated' in value:
                index = value['Deduplicated']
                if index in seen or index not in pool:
                    raise RuntimeError('Invalid signature type reference')
                return regions(pool[index], seen | {index})
            if 'HashConsedValue' in value:
                index, content = value['HashConsedValue']
                return regions(content, seen | {index})
            return set().union(*(regions(child, seen) for child in value.values()))
        if isinstance(value, list):
            return set().union(*(regions(child, seen) for child in value))
        return set()
    failures = []
    for function in functions:
        issues = regions(function['signature'])
        if issues:
            failures.append({'function_id': function['def_id'], 'name': function['item_meta']['name'],
                             'regions': sorted(issues)})
    info = {'function_count': len(functions), 'retained_source_bodies': retained,
            'invalid_signature_regions': failures}
    if retain_error_types or retain_time_types:
        carriers = {}
        for name in ERROR_TYPES if retain_error_types else TIME_TYPES:
            types = [t for t in ir['translated'].get('type_decls', []) if t and
                     [n['Ident'][0] for n in t['item_meta']['name'] if 'Ident' in n] == name.split('::')]
            if len(types) != 1 or not isinstance(types[0]['kind'], dict) or 'Struct' not in types[0]['kind']:
                raise RuntimeError('Missing complete error carrier: ' + name)
            carriers[name] = types[0]
        def resolve(value, seen=frozenset()):
            if isinstance(value, dict):
                if 'HashConsedValue' in value:
                    index, content = value['HashConsedValue']
                    if index in seen: raise RuntimeError('Cyclic carrier type')
                    return resolve(content, seen | {index})
                if 'Deduplicated' in value:
                    index = value['Deduplicated']
                    if index in seen or index not in pool: raise RuntimeError('Invalid carrier type reference')
                    return resolve(pool[index], seen | {index})
            return value
        fields = carriers['core::num::niche_types::Nanoseconds']['kind']['Struct']
        if len(fields) != 1: raise RuntimeError('Nanoseconds field count changed')
        pattern = resolve(fields[0]['ty']).get('Pattern')
        if not isinstance(pattern, list) or len(pattern) != 2 or resolve(pattern[0]) != {'Literal': {'UInt': 'U32'}}:
            raise RuntimeError('Nanoseconds pattern type changed')
        bounds = pattern[1].get('Range')
        if not isinstance(bounds, list) or len(bounds) != 2:
            raise RuntimeError('Nanoseconds range is missing')
        for bound, expected in zip(bounds, ['0', '999999999']):
            if bound['kind'] != {'Literal': {'Scalar': {'Unsigned': ['U32', expected]}}} or resolve(bound['ty']) != resolve(pattern[0]):
                raise RuntimeError('Nanoseconds range bound changed')
        info['retained_error_carriers' if retain_error_types else 'retained_time_carriers'] = list(carriers)
        info['nanoseconds_range'] = [0, 999999999]
        if retain_error_types:
            pointer_fields = carriers['core::ptr::non_null::NonNull']['kind']['Struct']
            if len(pointer_fields) != 1: raise RuntimeError('NonNull pointer field count changed')
            nonnull = resolve(pointer_fields[0]['ty']).get('Pattern')
            if not isinstance(nonnull, list) or len(nonnull) != 2 or nonnull[1] != 'NotNull':
                raise RuntimeError('NonNull predicate is missing')
            pointer = resolve(nonnull[0]).get('RawPtr')
            if not isinstance(pointer, list) or len(pointer) != 2 or pointer[1] != 'Shared' or resolve(pointer[0]) != {'TypeVar': {'Free': 0}}:
                raise RuntimeError('NonNull pointer referent or mutability changed')
            info['nonnull_pointer'] = {'referent_variable': 0, 'mutability': 'Shared', 'predicate': 'NotNull'}
        info['opaque_types'] = [t['item_meta']['name'] for t in ir['translated']['type_decls'] if t and t['kind'] == 'Opaque']
    return info


def classify_failure(log):
    clean = re.sub(r'\x1b\[[0-9;?]*[A-Za-z]', '', log)
    if ('Detected groups of mixed mutually recursive definitions' in clean and
            'bincode::features::serde::ser' in clean and 'interp/Interp.ml' in clean):
        return 'serde-mixed-recursion'
    if ('unsupported type:' in clean and 'Generated_Types.TPattern' in clean and
            'core/src/num/niche_types.rs' in clean and 'llbc/TypesAnalysis.ml' in clean):
        return 'nanoseconds-pattern-type'
    if ('Unsupported scalar pattern type' in clean and 'core/src/ptr/non_null.rs' in clean and
            'llbc/TypesAnalysis.ml' in clean):
        return 'nonnull-pointer-pattern'
    return None


def classify_charon_failure(log):
    if ('Type error after transformations:' in log and 'Mismatched trait clause:' in log and
            'SerdeEncoder' in log and 'serde_core' in log):
        return 'partial-serde-trait-type-errors'
    return None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--tools', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--mode', choices=['generic', 'mono', 'partial', 'word'], required=True)
    parser.add_argument('--retain-error-types', action='store_true', help='Word mode only: retain error carriers and their exact nanosecond range')
    parser.add_argument('--retain-time-types', action='store_true', help='Word mode only: retain the six original bounded time carriers')
    args = parser.parse_args()
    if (args.retain_error_types or args.retain_time_types) and args.mode != 'word':
        parser.error('Retaining error/time carriers requires --mode word')
    if args.retain_error_types and args.retain_time_types:
        parser.error('Choose either error or time carrier retention')
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='code-serialization-' + args.mode + '-', dir=parent))
    record = {'status': 'started', 'mode': args.mode, 'retain_error_types': args.retain_error_types,
              'retain_time_types': args.retain_time_types, 'commands': [],
              'script_sha256': BASE['digest'](Path(__file__).read_bytes()),
              'claim': 'translation diagnostic only; actual serialization/context hashing/security remain unproved'}
    def save():
        (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, name, env=None):
        record['commands'].append([str(x) for x in command]); save()
        with (out / name).open('w') as log:
            return subprocess.run([str(x) for x in command], cwd=ROOT, env=env,
                                  stdout=log, stderr=subprocess.STDOUT).returncode
    print('Serialization artifacts: ' + str(out), flush=True); save()
    try:
        tools, backend = args.tools.resolve(), args.backend.resolve()
        receipt = json.loads(args.build_receipt.read_text())
        profile = receipt.get('profile')
        allowed_profiles = ['discriminants', 'u32-ranges'] if args.mode == 'word' else ['metadata-mono']
        if receipt.get('status') != 'passed' or profile not in allowed_profiles:
            raise RuntimeError('Wrong or failed frontend receipt')
        if receipt.get('script_sha256') != BASE['digest']((ROOT / 'scripts/build-hasteboots-static-frontend').read_bytes()):
            raise RuntimeError('Stale frontend builder policy')
        patch_hash = BUILD['verify_source'](Path(receipt['source']), profile)
        if receipt.get('patch_sha256') != patch_hash or receipt.get('package_profile_sha256') != BASE['digest']((BUILD['DATA'] / 'opam-packages.json').read_bytes()):
            raise RuntimeError('Stale frontend source or package receipt')
        frontend = Path(receipt['executable'])
        if BASE['digest'](frontend.read_bytes()) != receipt.get('executable_sha256'):
            raise RuntimeError('Frontend executable differs')
        record.update(frontend_sha256=receipt['executable_sha256'],
                      build_receipt_sha256=BASE['digest'](args.build_receipt.read_bytes()))
        if run([ROOT / 'scripts/extract-hasteboots-registry', '--tools', tools, '--backend', backend], 'registry.log'):
            raise RuntimeError('Accepted registry preflight failed')
        paths = re.findall(r'^Registry artifacts: (.+)$', (out / 'registry.log').read_text(), re.M)
        if len(paths) != 1: raise RuntimeError('Missing registry preflight')
        source = Path(paths[0]); manifest = source / 'manifest.json'
        if json.loads(manifest.read_text()).get('status') != 'passed':
            raise RuntimeError('Registry preflight not accepted')
        record.update(preflight_manifest=str(manifest), preflight_manifest_sha256=BASE['digest'](manifest.read_bytes()))
        native = ROOT.parent / 'HasteBoots'
        def native_clean():
            if BASE['PARAMETERS']['checked'](['git', '-C', native, 'rev-parse', 'HEAD'], text=True).strip() != BASE['PARAMETERS']['NATIVE_PIN'] or BASE['PARAMETERS']['checked'](['git', '-C', native, 'diff', 'HEAD', '--name-only'], text=True).strip():
                raise RuntimeError('Native revision or tracked cleanliness changed')
        native_clean()
        cargo = (source / 'Cargo.toml').read_text() + 'algebra = { path = "' + str(native / 'algebra') + '" }\n' + 'bincode = { version = "=2.0.1", features = ["serde"] }\n'
        lock = (source / 'Cargo.lock').read_text().replace(
            'name = "formalproof4fhe-native-registry-fixture"\nversion = "0.1.0"\ndependencies = [',
            'name = "formalproof4fhe-native-registry-fixture"\nversion = "0.1.0"\ndependencies = [\n "algebra",\n "bincode",')
        BASE['validate_lock']((native / 'Cargo.lock').read_text(), lock)
        (out / 'Cargo.toml').write_text(cargo); (out / 'Cargo.lock').write_text(lock)
        wrapper = DATA / ('word.rs' if args.mode == 'word' else 'wrapper.rs')
        (out / 'src').mkdir(); (out / 'src/lib.rs').write_bytes(wrapper.read_bytes())
        record.update(native_revision=BASE['PARAMETERS']['NATIVE_PIN'], cargo_sha256=BASE['digest'](cargo.encode()),
                      lock_sha256=BASE['digest'](lock.encode()), wrapper_sha256=BASE['digest'](wrapper.read_bytes()))
        record['native_sources'] = {name: BASE['digest']((native / name).read_bytes()) for name in
                                    ['pcs/src/utils/code/block.rs', 'pcs/src/matrix_weighted.rs', 'algebra/src/goldilocks/mod.rs', 'Cargo.lock']}
        llbc = out / 'code_serialization.llbc'
        command = [tools / 'charon', 'cargo', '--preset=aeneas']
        if args.mode == 'mono': command += ['--raw-consts', '--monomorphize']
        if args.mode == 'partial': command += ['--monomorphize-mut']
        command += ['--start-from', BASE['NAMESPACE'] + ('::encode_word' if args.mode == 'word' else '::code_bytes')]
        modules = ['bincode', 'core::marker'] if args.mode == 'word' else ['bincode', 'serde', 'serde_core', 'pcs::utils::code::block', 'algebra::goldilocks']
        if args.retain_error_types: modules += ERROR_TYPES
        if args.retain_time_types: modules += TIME_TYPES
        for module in modules:
            command += ['--include', module]
        command += ['--dest-file', llbc, '--', '--manifest-path', out / 'Cargo.toml', '--lib', '--locked']
        env = dict(os.environ); env.setdefault('CARGO_TARGET_DIR', str(parent / 'cargo-registry-target'))
        charon_code = run(command, 'charon.log', env)
        record['charon_exit_code'] = charon_code
        if charon_code: raise RuntimeError('Charon rejected serialization')
        native_clean()
        record['llbc_sha256'] = BASE['digest'](llbc.read_bytes())
        ir = json.loads(llbc.read_text())
        record['charon_has_errors'] = ir.get('has_errors')
        if ir.get('has_errors') is not False:
            record['failure_kind'] = classify_charon_failure((out / 'charon.log').read_text())
            raise RuntimeError('Charon reported translation errors; Aeneas was not invoked')
        record['ir'] = inspect_ir(ir, 'word' if args.mode == 'word' else 'code',
                                  args.retain_error_types, args.retain_time_types); save()
        if record['ir']['invalid_signature_regions']:
            record['failure_kind'] = 'signature-regions'
            raise RuntimeError('Signature lifetimes are missing; extraction stopped before symbolic execution')
        status = run([frontend, '-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000',
                      '-max-recdepth', '1000', '-abort-on-error', *([] if args.mode == 'word' else ['-no-external-name-patterns']),
                      '-dest', out / 'lean', llbc], 'aeneas.log')
        record.update(aeneas_exit_code=status, failure_kind=classify_failure((out / 'aeneas.log').read_text()))
        generated = out / 'lean/CodeSerialization.lean'
        if generated.exists():
            raw = generated.read_text()
            record['generated_sha256'] = BASE['digest'](generated.read_bytes())
            record['generated_axioms'] = re.findall(r'^axiom\s+([^\s(]+)', raw, re.M)
            if status == 0 and record['generated_axioms']:
                record['failure_kind'] = 'external-axioms'
        native_clean(); BUILD['verify_source'](Path(receipt['source']), profile)
        raise RuntimeError('Serialization remains unproved: ' + str(record['failure_kind']) + '; reviewed output and kernel proofs required')
    except (Exception, SystemExit) as error:
        record.update(status='rejected-unproved', error=str(error)); save()
        print('Serialization remains unproved: ' + str(error), flush=True)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
