#!/usr/bin/env python3
"""Reject widened usize ranges, missing proofs, admissions and wrong targets."""
import copy
from pathlib import Path
import runpy
import unittest

ROOT = Path(__file__).resolve().parent.parent
GATE = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-usize-ranges'))


class Guards(unittest.TestCase):
    def test_complete_snapshot(self):
        raw = (GATE['DATA'] / 'Generated.lean').read_text()
        self.assertEqual(GATE['validate_output'](raw), raw.replace('import Aeneas\n', ''))

    def test_changed_bounds_and_admissions_rejected(self):
        raw = (GATE['DATA'] / 'Generated.lean').read_text()
        for bad in [raw.replace('9223372036854775807', '18446744073709551615'),
                    raw.replace('7 ≤ value.val', '0 ≤ value.val'),
                    raw.replace('ok value.window', 'sorry'),
                    raw.replace('end hasteboots_usize_ranges', '')]:
            with self.assertRaises(RuntimeError): GATE['validate_output'](bad)

    def test_exact_ir_ranges_and_target(self):
        scalar = {'Literal': {'UInt': 'Usize'}}
        bounds = [{'kind': {'Literal': {'Scalar': {'Unsigned': ['Usize', n]}}}, 'ty': scalar}
                  for n in ['7', '19']]
        ir = {'has_errors': False, 'translated': {'target_information': [
            {'key': 'x86_64-unknown-linux-gnu', 'value': {'target_pointer_size': 8, 'is_little_endian': True}}]},
              'field': {'Pattern': [scalar, {'Range': bounds}]}}
        check = GATE['RANGES']['inspect_patterns']
        self.assertEqual(check(ir, [(7, 19)], 'Usize'), [(7, 19)])
        for mutate in [lambda x: x['translated'].update(target_information=[]),
                       lambda x: x.pop('field'),
                       lambda x: x['field']['Pattern'][1]['Range'][1]['kind']['Literal']['Scalar']['Unsigned'].__setitem__(1, '20'),
                       lambda x: x['field']['Pattern'][0].update(Literal={'UInt': 'U64'})]:
            bad = copy.deepcopy(ir); mutate(bad)
            with self.assertRaises(RuntimeError): check(bad, [(7, 19)], 'Usize')

    def test_missing_proof_rejected(self):
        proof = (GATE['DATA'] / 'Proof.lean').read_text().replace('theorem capacity_bounds', 'theorem omitted')
        with self.assertRaises(RuntimeError):
            GATE['PARAMETERS']['validate_proof_source'](proof, GATE['PROOFS'])


if __name__ == '__main__':
    unittest.main()
