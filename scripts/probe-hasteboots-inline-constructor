#!/usr/bin/env python3
"""Probe original Gold constructor with coupled inline tools; no refinement/security claim."""
import argparse
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / 'scripts/probe-hasteboots-constructor-typing'))
BUILD = runpy.run_path(str(ROOT / 'scripts/build-hasteboots-inline-tools'))
PARAMETERS, COMMON, digest = BASE['PARAMETERS'], BASE['COMMON'], BASE['digest']


def validate_drop_ir(ir):
    BASE['validate_ir'](ir)
    options = ir['translated'].get('options', {})
    if options.get('precise_drops') is not True or options.get('desugar_drops') is not True:
        raise RuntimeError('Native constructor requires precise, desugared drops')
    if options.get('preserve_allocator') is not True:
        raise RuntimeError('Native constructor requires allocator preservation')
    if options.get('evaluate_runtime_checks') is not True:
        raise RuntimeError('Native constructor requires compiler-evaluated runtime checks')
    functions = {f['def_id'] for f in ir['translated']['fun_decls'] if isinstance(f, dict)}
    def visit(value):
        if isinstance(value, dict):
            if 'Drop' in value: raise RuntimeError('Residual drop would hide cleanup semantics')
            nullary = value.get('NullaryOp')
            if isinstance(nullary, list) and nullary and nullary[0] in ['UbChecks', 'OverflowChecks', 'ContractChecks']:
                raise RuntimeError('Unevaluated compiler runtime-check query')
            if set(value) == {'Fun'} and isinstance(value['Fun'], dict) and set(value['Fun']) == {'Regular'}:
                if value['Fun']['Regular'] not in functions: raise RuntimeError('Function reference has no declaration')
            for child in value.values(): visit(child)
        elif isinstance(value, list):
            for child in value: visit(child)
    visit(ir['translated'])


def extract_axiom_names(raw):
    return re.findall(r'^axiom\s+([^\s:(]+)', raw, re.M)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    cleanup = parser.add_mutually_exclusive_group()
    cleanup.add_argument('--expand-string-cleanup', action='store_true', help='Expose original String type and drop body')
    cleanup.add_argument('--cleanup-scope', choices=['opaque', 'string', 'vec', 'rawvec', 'global', 'layout', 'nonzero'], help='Follow original cleanup bodies to the selected boundary')
    parser.add_argument('--inline-ok-or', action='store_true', help='Also inline static-error option conversion')
    parser.add_argument('--target-word64', action='store_true', help='Use checked 64-bit words and original source bindings')
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='inline-constructor-', dir=parent))
    record = {'status': 'started', 'claim': 'strict original constructor translation only; source/heap/work/security refinement unproved',
              'commands': [], 'script_sha256': digest(Path(__file__).read_bytes())}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log, env=None):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            subprocess.run([str(x) for x in command], cwd=ROOT, env=env, stdout=stream, stderr=subprocess.STDOUT, check=True)
    print('Inline constructor artifacts: ' + str(out), flush=True); save()
    try:
        receipt, tools, sources = BUILD['verify_receipt'](args.build_receipt)
        native = ROOT.parent / 'HasteBoots'
        def verify_native():
            if PARAMETERS['checked'](['git', '-C', native, 'rev-parse', 'HEAD'], text=True).strip() != PARAMETERS['NATIVE_PIN']:
                raise RuntimeError('Native source revision differs')
            if PARAMETERS['checked'](['git', '-C', native, 'diff', 'HEAD', '--name-only'], text=True).strip():
                raise RuntimeError('Native tracked source differs')
        verify_native()
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        record['backend_patches'] = PARAMETERS['verify_backend'](args.backend.resolve(), out)
        fixture = ROOT / 'scripts/native-fixtures/ntt-cache'
        wrapper = ROOT / 'interop/aeneas/parameters/wrapper.rs'
        record.update(native_revision=PARAMETERS['NATIVE_PIN'], wrapper_sha256=digest(wrapper.read_bytes()),
                      lock_sha256=digest((fixture / 'Cargo.lock').read_bytes()))
        (out / 'src').mkdir()
        (out / 'src/lib.rs').write_bytes(wrapper.read_bytes())
        (out / 'Cargo.toml').write_text((fixture / 'Cargo.toml').read_text().replace('../../../../HasteBoots', str(native)))
        (out / 'Cargo.lock').write_bytes((fixture / 'Cargo.lock').read_bytes())
        env = dict(os.environ)
        env['CARGO_TARGET_DIR'] = str(parent / 'cargo-constructor-partial')
        llbc = out / 'constructor.llbc'
        optional_inline = ['--inline-function', 'core::option::_::ok_or'] if args.inline_ok_or else []
        record['target_word64'] = args.target_word64
        record['inline_ok_or'] = args.inline_ok_or
        record['expand_string_cleanup'] = args.expand_string_cleanup
        scope = args.cleanup_scope or ('string' if args.expand_string_cleanup else 'opaque')
        record['cleanup_scope'] = scope
        paths = [] if scope == 'opaque' else ['alloc::string::String']
        if scope in ['vec', 'rawvec', 'global', 'layout', 'nonzero']: paths += ['alloc::vec::Vec', 'alloc::vec::Vec::_::drop_glue']
        if scope in ['rawvec', 'global', 'layout', 'nonzero']: paths += ['alloc::vec', 'alloc::raw_vec']
        if scope in ['global', 'layout', 'nonzero']: paths += ['alloc::alloc']
        if scope in ['layout', 'nonzero']: paths += ['core::alloc::layout', 'core::mem::alignment', 'core::num::niche_types', 'core::num::_::unchecked_mul']
        if scope == 'nonzero': paths += ['core::num::nonzero']
        cleanup_scope = [argument for path in paths for argument in ['--include', path]]
        run([tools / 'charon', 'cargo', '--preset=aeneas', '--preserve-allocator', '--evaluate-runtime-checks', '--precise-drops', '--desugar-drops', '--monomorphize',
             '--inline-function', 'core::option::_::and_then', '--inline-function', 'core::option::_::is_none_or', *optional_inline,
             '--start-from', PARAMETERS['NAMESPACE'] + '::new_encoded', '--include', 'pcs', '--include', 'algebra::goldilocks::Goldilocks', *cleanup_scope, '--include', 'core::option',
             '--include', 'core::result', '--include', 'core::convert',
             '--include', 'core::num::_::checked_next_power_of_two', '--include', 'core::num::_::one_less_than_next_power_of_two',
             '--dest-file', llbc, '--', '--manifest-path', out / 'Cargo.toml', '--lib', '--locked'], 'charon.log', env)
        ir = json.loads(llbc.read_text())
        record.update(charon_has_errors=ir.get('has_errors'), llbc_sha256=digest(llbc.read_bytes()))
        validate_drop_ir(ir)
        record['residual_drop_count'] = 0
        record['missing_function_references'] = []
        record['runtime_check_query_count'] = 0
        record['constructor_bodies'] = BASE['validate_constructor_bodies'](ir, False)
        record['retained_functions'] = sum(isinstance(f, dict) for f in ir['translated']['fun_decls'])
        save()
        run([tools / 'aeneas', '-backend', 'lean', '-checks', '-sequential', '-eval-drops', '-max-heartbeats', '200000', '-max-recdepth', '1000',
             '-abort-on-error', '-no-external-name-patterns', '-disambiguate-instantiated-names', '-monomorphic-builtin-shapes',
             *(['-target-word64'] if args.target_word64 else []), '-dest', out / 'lean', llbc], 'aeneas.log')
        plain = re.sub(r'\x1b\[[0-9;?]*[A-Za-z]', '', (out / 'aeneas.log').read_text())
        if re.search(r'Uncaught exception|\[Error\]', plain): raise RuntimeError('Frontend reported an error despite exit status')
        raw = (out / 'lean/Constructor.lean').read_text()
        record['generated_sha256'] = digest(raw.encode())
        record['extracted_axioms'] = extract_axiom_names(raw)
        save()
        if raw.count('import Aeneas\n') != 1 or not raw.rstrip().endswith('end ' + PARAMETERS['NAMESPACE']):
            raise RuntimeError('Incomplete native constructor module')
        if re.search(r'\b(axiom|opaque|constant|sorry|sorryAx|native_decide|unsafe)\b|decide\s*\+native', raw):
            raise RuntimeError('Admitted native constructor module')
        if re.findall(r'^set_option (maxHeartbeats|maxRecDepth) ([0-9]+)$', raw, re.M) != [
                ('maxHeartbeats', '200000'), ('maxRecDepth', '1000')]: raise RuntimeError('Unexpected proof limits')
        name = PARAMETERS['NAMESPACE'] + '.new_encoded'
        checked = out / 'Checked.lean'
        module = raw.replace('import Aeneas\n', 'import Aeneas.Std\nimport Aeneas.Tactic.RustAttributes\nimport Aeneas.Data.Discriminant\n')
        if not args.target_word64:
            runtime_path = ROOT / 'interop/aeneas/usize-ctlz/Runtime.lean'
            support = runtime_path.read_text()
            PARAMETERS['validate_proof_source'](support, ['zero_rejected', 'nonzero_result', 'nonzero_bits', 'leading_value'])
            if support.count('import Aeneas.Std\n') != 1: raise RuntimeError('Unexpected intrinsic runtime imports')
            record['intrinsic_runtime_sha256'] = digest(support.encode())
            marker = 'open Aeneas Aeneas.Std Result ControlFlow Error\n'
            if module.count(marker) != 1: raise RuntimeError('Unexpected constructor prelude')
            module = module.replace(marker, support.replace('import Aeneas.Std\n', '') + '\n' + marker, 1)
        checked.write_text(module + '\n#print axioms ' + name + '\n')
        run([ROOT / 'scripts/in-container', 'bash', '-euc', 'cd -- "$1"; lake env lean -DwarningAsError=true "$2"', '_',
             COMMON['container_path'](args.backend.resolve() / 'backends/lean'), COMMON['container_path'](checked)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), [name])
        verify_native()
        BUILD['verify_receipt'](args.build_receipt)
        if record['wrapper_sha256'] != digest(wrapper.read_bytes()) or record['lock_sha256'] != digest((fixture / 'Cargo.lock').read_bytes()):
            raise RuntimeError('Native fixture changed during check')
        record['status'] = 'passed'; print('Original constructor translation checked; refinement proof still required')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); raise SystemExit('Inline constructor probe failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
