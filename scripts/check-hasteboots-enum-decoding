#!/usr/bin/env python3
"""Check fieldless enum decoding, invalid bit patterns and layout validation."""
import argparse
import copy
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-inline-equivalence'))
RANGES = runpy.run_path(str(ROOT / 'scripts/probe-hasteboots-u32-ranges'))
ENUMS = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-large-discriminants'))
BUILD, PARAMETERS, COMMON, digest = BASE['BUILD'], BASE['PARAMETERS'], BASE['COMMON'], BASE['digest']
DATA = ROOT / 'interop/aeneas/enum-decoding'
PROOFS = ['direct_roundtrip', 'wrapped_roundtrip', 'alignment_roundtrip', 'direct_zero', 'wrapped_invalid', 'alignment_zero', 'alignment_three', 'alignment_high', 'alignment_high_invalid', 'wrapped_sound', 'alignment_sound', 'direct_sound', 'alignment_accepts_iff', 'alignment_bits', 'alignment_valid_bits']
NAMESPACE = 'hasteboots_enum_decoding'


def validate_output(raw):
    PARAMETERS['verify_snapshot'](raw, (DATA / 'Generated.lean').read_text())
    PARAMETERS['validate_proof_source']((DATA / 'Proof.lean').read_text(), PROOFS)
    return RANGES['validate_output'](raw, NAMESPACE, ['Wrapped', 'Align', 'direct', 'wrapped', 'alignment'])


EXPECTED = {
    'Sparse': ('U32', [('One', 1), ('Eight', 8), ('Last', 2**32-1)]),
    'Alignment64': ('U64', [('A' + str(i), 2**i) for i in range(64)])}


def declaration(ir, name):
    found = [d for d in ir['translated']['type_decls'] if isinstance(d, dict)
             and [x['Ident'][0] for x in d['item_meta']['name'] if 'Ident' in x] == [NAMESPACE, name]]
    if len(found) != 1: raise RuntimeError('Missing or duplicate declaration: ' + name)
    return found[0]


def validate_ir(ir):
    ENUMS['inspect_enums'](ir, EXPECTED)
    if ir['translated'].get('options', {}).get('mir') != 'Optimized':
        raise RuntimeError('Expected optimized MIR')
    for name, size in [('Sparse', 4), ('Wrapped', 4), ('Alignment64', 8), ('Align', 8)]:
        decl = declaration(ir, name)
        layouts = decl.get('layout', [])
        if len(layouts) != 1: raise RuntimeError('Missing unique layout')
        layout = layouts[0]['value']
        if layout['size'] != size or layout['align'] != size:
            raise RuntimeError('Wrong representation size/alignment')
        if name in ['Wrapped', 'Align'] and not layout['repr']['transparent']:
            raise RuntimeError('Nontransparent wrapper')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='enum-decoding-', dir=parent))
    record = {'status': 'started', 'claim': 'checked enum decoding only; compiler/native heap/work/security unproved',
              'script_sha256': digest(Path(__file__).read_bytes()), 'commands': []}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log, required=True):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            status = subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT).returncode
        if required and status: raise RuntimeError(log + ' exited ' + str(status))
        return status
    print('Enum decoding artifacts: ' + str(out), flush=True); save()
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        record['backend_patches'] = PARAMETERS['verify_backend'](args.backend.resolve(), out)
        files = ['fixture.rs', 'Generated.lean', 'Proof.lean', 'unsupported-nontransparent.rs', 'unsupported-signed.rs']
        record['inputs'] = {name: digest((DATA / name).read_bytes()) for name in files}
        def extract(source, name):
            llbc = out / (name + '.llbc')
            run([tools / 'charon', 'rustc', '--preset=aeneas', '--monomorphize', '--mir', 'optimized', '--dest-file', llbc,
                 '--', '--crate-type', 'lib', '--edition', '2024', '--crate-name', NAMESPACE,
                 (DATA / source).relative_to(ROOT)], name + '-charon.log')
            return llbc
        options = ['-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000', '-max-recdepth', '1000',
                   '-abort-on-error', '-no-external-name-patterns', '-disambiguate-instantiated-names']
        def frontend(llbc, name, enabled=True, required=True):
            return run([tools / 'aeneas', *options, *(['-monomorphic-builtin-shapes'] if enabled else []),
                        '-dest', out / name, llbc], name + '-frontend.log', required)
        llbc = extract('fixture.rs', 'positive')
        ir = json.loads(llbc.read_text())
        validate_ir(ir)
        frontend(llbc, 'positive')
        BASE['BASE']['validate_frontend_log']((out / 'positive-frontend.log').read_text())
        generated = list((out / 'positive').glob('*.lean'))
        if len(generated) != 1: raise RuntimeError('Expected complete single generated module')
        raw = generated[0].read_text()
        runtime = validate_output(raw)
        names = [NAMESPACE + '.' + n for n in ['direct', 'wrapped', 'alignment']]
        names += ['HasteBootsEnumDecodingProof.' + n for n in PROOFS]
        names += [NAMESPACE + '.' + name + '.read_discriminant' for name in ['Sparse', 'Alignment64']]
        checked = out / 'Checked.lean'
        checked.write_text('import Aeneas.Std\nimport Aeneas.Data.Discriminant\n' + runtime + '\n'
                           + (DATA / 'Proof.lean').read_text()
                           + ''.join('\n#print axioms ' + n + '\n' for n in names))
        run([ROOT / 'scripts/in-container', 'bash', '-euc', 'cd -- "$1"; lake env lean -DwarningAsError=true "$2"', '_',
             COMMON['container_path'](args.backend.resolve() / 'backends/lean'), COMMON['container_path'](checked)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        record.update(llbc_sha256=digest(llbc.read_bytes()), checked_sha256=digest(checked.read_bytes()))
        record['rejected'] = []
        def reject(bad, name, enabled=True, error='Scalar enum transmute'):
            status = frontend(bad, name, enabled, False)
            log = (out / (name + '-frontend.log')).read_text()
            if status == 0 or error not in log: raise RuntimeError('Unsupported enum transmute accepted: ' + name)
            record['rejected'].append(name)
        for case in ['nontransparent', 'signed']:
            reject(extract('unsupported-' + case + '.rs', case), case)
        reject(llbc, 'disabled', False, 'Invalid input for unop: transmute')
        faults = ['size', 'align', 'repr', 'tagger', 'discriminator', 'fallback', 'variant-offset',
                  'wrapper-repr', 'wrapper-offset', 'missing-layout', 'uninhabited', 'variant-id', 'fields']
        for field in faults:
            # Explicit negative fault injection; accepted source/IR is untouched.
            bad = copy.deepcopy(ir)
            decl = declaration(bad, 'Sparse')
            layout = decl['layout'][0]['value']
            wrapped = declaration(bad, 'Wrapped')
            if field in ['size', 'align']: layout[field] = 8
            elif field == 'repr': layout['repr']['explicit_discr_type'] = False
            elif field == 'tagger': layout['variant_layouts'][0]['tagger'][0][1]['Unsigned'][1] = '2'
            elif field == 'discriminator': layout['discriminator']['Branch']['children'][0][1] = {'Known': 1}
            elif field == 'fallback': layout['discriminator']['Branch']['fallback'] = {'Known': 0}
            elif field == 'variant-offset': layout['variant_layouts'][0]['field_offsets'] = [4]
            elif field == 'wrapper-repr': wrapped['layout'][0]['value']['repr']['transparent'] = False
            elif field == 'wrapper-offset': wrapped['layout'][0]['value']['variant_layouts'][0]['field_offsets'] = [4]
            elif field == 'missing-layout': decl['layout'] = []
            elif field == 'uninhabited': layout['variant_layouts'][0]['uninhabited'] = True
            elif field == 'variant-id': decl['kind']['Enum'][0]['id'] = 2
            elif field == 'fields':
                added = copy.deepcopy(wrapped['kind']['Struct'][0])
                functions = [f for f in bad['translated']['fun_decls'] if isinstance(f, dict)]
                added['ty'] = copy.deepcopy(functions[0]['signature']['inputs'][0])
                decl['kind']['Enum'][0]['fields'] = [added]
            path = out / ('invalid-' + field + '.llbc'); path.write_text(json.dumps(bad) + '\n')
            reject(path, 'invalid-' + field)
        if record['inputs'] != {name: digest((DATA / name).read_bytes()) for name in files}:
            raise RuntimeError('Input changed during check')
        BUILD['verify_receipt'](args.build_receipt)
        record['status'] = 'passed'; print('Enum decoding passed: 20 dependency audits; sixteen unsupported cases rejected')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); raise SystemExit('Enum decoding check failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
