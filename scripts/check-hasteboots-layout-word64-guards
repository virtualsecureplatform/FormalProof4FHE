#!/usr/bin/env python3
"""Reject incomplete source, changed target/layouts and weakened word64 proofs."""
import copy
from pathlib import Path
import runpy
import unittest

ROOT = Path(__file__).resolve().parent.parent
GATE = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-layout-word64'))


def fixture():
    funcs = [{'item_meta': {'name': [{'Ident': [GATE['NAMESPACE'], 0]}, {'Ident': [n, 0]}]},
              'body': {'Structured': {}}} for n in GATE['FUNCTIONS'][:8]]
    funcs += [{'item_meta': {'name': []}, 'body': {'Structured': {}}} for _ in range(10)]
    return {'has_errors': False, 'translated': {
        'target_information': [{'key': 'x86_64-unknown-linux-gnu', 'value': {
            'target_pointer_size': 8, 'is_little_endian': True}}],
        'options': {'monomorphize': True, 'mir': 'Optimized'}, 'fun_decls': funcs,
        'type_decls': [{'item_meta': {'name': [{'Ident': [n, 0]} for n in ['core', 'alloc', 'layout', 'Layout']]},
                        'kind': {'Struct': [{'name': 'size'}, {'name': 'align'}]},
                        'layout': [{'value': {'size': 16, 'align': 8, 'variant_layouts': [{'field_offsets': [8, 0]}]}}]}]}}


class Guards(unittest.TestCase):
    def test_complete_source_and_module(self):
        GATE['validate_ir'](fixture())
        GATE['validate_output']((GATE['DATA'] / 'Generated.lean').read_text())

    def test_incompatible_target_or_incomplete_body(self):
        mutations = [lambda x: x['translated'].update(target_information=[]),
                     lambda x: x['translated']['target_information'][0]['value'].update(target_pointer_size=4),
                     lambda x: x['translated']['target_information'][0]['value'].update(is_little_endian=False),
                     lambda x: x['translated']['fun_decls'][0].update(body='Opaque'),
                     lambda x: x['translated']['fun_decls'].pop(),
                     lambda x: x['translated']['type_decls'][0]['layout'][0]['value']['variant_layouts'][0].update(field_offsets=[0, 8])]
        for mutate in mutations:
            bad = copy.deepcopy(fixture()); mutate(bad)
            with self.assertRaises(RuntimeError): GATE['validate_ir'](bad)

    def test_wrong_words_source_type_or_admission(self):
        raw = (GATE['DATA'] / 'Generated.lean').read_text()
        for bad in [raw.replace('Std.U64', 'Std.Usize'), raw.replace('Std.I64', 'Std.Isize'),
                    raw.replace('align : core.mem.alignment.Alignment', 'align : core.ptr.alignment.Alignment'),
                    raw.replace('Std.UScalar.overflowing_add', 'Std.IScalar.overflowing_add'),
                    raw.replace('18446744073709551615', '9223372036854775807'),
                    raw.replace('(by decide)', '(by exact sorry)'), raw.replace('end ' + GATE['NAMESPACE'], '')]:
            with self.assertRaises(RuntimeError): GATE['validate_output'](bad)

    def test_missing_universal_or_boundary_proof(self):
        proof = (GATE['DATA'] / 'Proof.lean').read_text()
        for name in ['align_exact', 'overflowing_add_exact', 'signed_overflowing_add_exact', 'signed_min_exact', 'unsigned_overflow']:
            with self.assertRaises(RuntimeError):
                GATE['PARAMETERS']['validate_proof_source'](proof.replace('theorem ' + name, 'theorem missing'), GATE['PROOFS'])


if __name__ == '__main__':
    unittest.main()
