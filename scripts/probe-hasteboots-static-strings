#!/usr/bin/env python3
"""Compare official/patched extraction and kernel-check static-string regressions."""
import argparse
import hashlib
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT / 'interop/aeneas/static-strings'
PARAMETERS = runpy.run_path(str(ROOT / 'scripts/extract-hasteboots-parameters'))
BUILD = runpy.run_path(str(ROOT / 'scripts/build-hasteboots-static-frontend'))
COMMON = PARAMETERS['COMMON']
FUNCTIONS = ['literal', 'nested_error', 'conditional_error', 'unicode_literal', 'preserve_borrow', 'escaped_literal']
PROOFS = ['literal_exact', 'nested_error_exact', 'conditional_true', 'conditional_false', 'unicode_exact',
          'escaped_exact', 'borrow_identity', 'unicode_bytes', 'escaped_bytes']


def digest(data):
    return hashlib.sha256(data).hexdigest()


def clear_colors(text):
    return re.sub(r'\x1b\[[0-9;?]*[A-Za-z]', '', text)


def validate_output(raw):
    if raw.count('import Aeneas\n') != 1 or not raw.rstrip().endswith('end hasteboots_static_strings'):
        raise RuntimeError('Missing imports or truncated generated namespace')
    if re.search(r'\b(axiom|opaque|sorry|sorryAx|native_decide|unsafe)\b|decide\s*\+native', raw):
        raise RuntimeError('Admitted, opaque or native-proof generated declaration')
    for name in FUNCTIONS:
        if not re.search(r'^def ' + name + r'\s', raw, re.M):
            raise RuntimeError('Missing generated function: ' + name)
    limits = re.findall(r'^set_option (maxHeartbeats|maxRecDepth) ([0-9]+)$', raw, re.M)
    if limits != [('maxHeartbeats', '200000'), ('maxRecDepth', '1000')]:
        raise RuntimeError('Unexpected generated proof limits')
    return raw.replace('import Aeneas\n', 'import Aeneas.Std\nimport Aeneas.Tactic.RustAttributes\n')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--tools', type=Path, required=True, help='Unchanged pinned official release')
    parser.add_argument('--backend', type=Path, required=True, help='Prepared pinned Lean backend')
    parser.add_argument('--build-receipt', type=Path, required=True, help='Passed isolated frontend build manifest')
    args = parser.parse_args()
    tools, backend = args.tools.resolve(), args.backend.resolve()
    parent = ROOT / 'build/hasteboots-extraction'
    parent.mkdir(parents=True, exist_ok=True)
    artifacts = Path(tempfile.mkdtemp(prefix='static-string-probe-', dir=parent))
    manifest = {'status': 'started', 'claim': 'frontend regression only; compiler/security correctness unproved',
                'commands': [], 'proof_limits': {'maxHeartbeats': 200000, 'maxRecDepth': 1000},
                'script_sha256': digest(Path(__file__).read_bytes())}

    def save():
        (artifacts / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')

    def run(command, name, require_success=True):
        manifest['commands'].append([str(x) for x in command]); save()
        with (artifacts / name).open('w') as log:
            result = subprocess.run([str(x) for x in command], cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
        if require_success and result.returncode:
            raise RuntimeError(f'{name} exited {result.returncode}')
        return result.returncode

    print('Probe artifacts: ' + str(artifacts), flush=True); save()
    try:
        for name, expected in PARAMETERS['TOOLS'].items():
            if digest((tools / name).read_bytes()) != expected:
                raise RuntimeError('Official tool hash differs: ' + name)
        manifest['backend_patches'] = PARAMETERS['verify_backend'](backend, artifacts)
        receipt = json.loads(args.build_receipt.read_text())
        if receipt.get('status') != 'passed':
            raise RuntimeError('Frontend build receipt did not pass')
        if receipt.get('script_sha256') != digest((ROOT / 'scripts/build-hasteboots-static-frontend').read_bytes()):
            raise RuntimeError('Stale frontend builder policy')
        source = Path(receipt['source'])
        patch_hash = BUILD['verify_source'](source)
        if receipt.get('patch_sha256') != patch_hash:
            raise RuntimeError('Stale frontend patch receipt')
        profile_hash = digest((DATA / 'opam-packages.json').read_bytes())
        if receipt.get('package_profile_sha256') != profile_hash:
            raise RuntimeError('Stale frontend package profile')
        frontend = Path(receipt['executable'])
        if digest(frontend.read_bytes()) != receipt['executable_sha256']:
            raise RuntimeError('Frontend executable differs from build receipt')
        manifest['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        manifest['frontend_sha256'] = receipt['executable_sha256']
        manifest['frontend_patch_sha256'] = patch_hash
        manifest['source_revision'] = BUILD['PIN']
        manifest['charon_revision'] = BUILD['CHARON_PIN']
        fixture = DATA / 'fixture.rs'
        (artifacts / 'fixture.rs').write_bytes(fixture.read_bytes())
        manifest['fixture_sha256'] = digest(fixture.read_bytes())
        llbc = artifacts / 'hasteboots_static_strings.llbc'
        run([tools / 'charon', 'rustc', '--preset=aeneas', '--dest-file', llbc, '--', '--crate-type', 'lib',
             '--edition=2024', '--crate-name', 'hasteboots_static_strings', fixture], 'charon.log')
        ir = json.loads(llbc.read_text())
        if ir.get('has_errors') is not False:
            raise RuntimeError('Charon reported incomplete extraction')
        target = ir['translated']['target_information']
        if target != [{'key': 'x86_64-unknown-linux-gnu', 'value': {'target_pointer_size': 8, 'is_little_endian': True}}]:
            raise RuntimeError('Unexpected extraction target')
        manifest['target_information'] = target
        manifest['llbc_sha256'] = digest(llbc.read_bytes())
        options = ['-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000', '-max-recdepth', '1000', '-abort-on-error']
        baseline = run([tools / 'aeneas', *options, '-dest', artifacts / 'official', llbc], 'official.log', False)
        baseline_log = clear_colors((artifacts / 'official.log').read_text())
        if baseline == 0 and not re.search(r'Uncaught exception|\[Error\]', baseline_log):
            raise RuntimeError('Official failure baseline unexpectedly passed')
        if not any(text in baseline_log for text in ['bottoms in the value', 'Compiler source: interp/Invariants.ml']):
            raise RuntimeError('Official baseline failed for an unexpected reason')
        manifest['official_returncode'] = baseline
        manifest['official_status'] = 'failed_as_expected'
        run([frontend, *options, '-dest', artifacts / 'patched', llbc], 'patched.log')
        if re.search(r'Uncaught exception|\[Error\]', clear_colors((artifacts / 'patched.log').read_text())):
            raise RuntimeError('Patched frontend reported errors despite its exit code')
        generated = artifacts / 'patched/HastebootsStaticStrings.lean'
        raw = generated.read_text()
        runtime = validate_output(raw)
        manifest['generated_sha256'] = digest(generated.read_bytes())
        manifest['import_only_sha256'] = digest(runtime.encode())
        proof = (DATA / 'Proof.lean').read_text()
        PARAMETERS['validate_proof_source'](proof, PROOFS)
        manifest['proof_sha256'] = digest(proof.encode())
        names = ['hasteboots_static_strings.' + n for n in FUNCTIONS]
        names += ['HasteBootsStaticStringsProof.' + n for n in PROOFS]
        checked = artifacts / 'Checked.lean'
        checked.write_text(runtime + '\n' + proof + ''.join('\n#print axioms ' + n + '\n' for n in names))
        manifest['checked_sha256'] = digest(checked.read_bytes())
        run([ROOT / 'scripts/in-container', 'bash', '-euc',
             'cd -- "$1"; lake env lean -DwarningAsError=true "$2"', '_',
             COMMON['container_path'](backend / 'backends/lean'), COMMON['container_path'](checked)], 'lean.log')
        manifest['dependency_audit'] = PARAMETERS['audit_log']((artifacts / 'lean.log').read_text(), names)
        manifest['status'] = 'passed'
        print('Static-string regression passed: official baseline rejected; 6 functions and 9 theorems strictly kernel checked')
    except (Exception, SystemExit) as error:
        manifest['status'] = 'failed'; manifest['error'] = str(error)
        raise SystemExit(f'Static-string probe failed; inspect {artifacts}: {error}') from error
    finally:
        manifest['logs'] = {p.name: digest(p.read_bytes()) for p in artifacts.glob('*.log')}
        save()


if __name__ == '__main__':
    main()
