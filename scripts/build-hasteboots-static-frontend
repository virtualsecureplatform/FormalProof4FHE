#!/usr/bin/env python3
"""Build the isolated pinned frontend experiment; not a compiler-correctness certificate."""
import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
PIN = '15b968482b0dcd7aae45020b6d1bca39b5024af5'
CHARON_PIN = 'ef3748c1a92c6acc402f978770193d34adc0fe6e'
OPAM_SHA512 = 'd4271d2387751313d5f904e8fdb3133ea893c72d09737139266d2bbe7624f81665a4276d2e55aa71856630ece8ce226b989560076599baae9afc053c5815f8c8'
DATA = ROOT / 'interop/aeneas/static-strings'
PROFILES = {'static-strings': DATA, 'usize-ctlz': ROOT / 'interop/aeneas/usize-ctlz',
            'constructor-typing': ROOT / 'interop/aeneas/constructor-typing',
            'static-slices': ROOT / 'interop/aeneas/static-slices',
            'static-bytes': ROOT / 'interop/aeneas/static-bytes',
            'metadata-mono': ROOT / 'interop/aeneas/metadata-mono',
            'discriminants': ROOT / 'interop/aeneas/discriminants'}


def digest(data):
    return hashlib.sha256(data).hexdigest()


def output(command, **kwargs):
    return subprocess.check_output([str(x) for x in command], **kwargs)


def verify_source(source, profile="static-strings"):
    if (source / '.hasteboots-probe').exists():
        raise RuntimeError('Refusing to modify the prepared official backend checkout')
    if output(['git', '-C', source, 'rev-parse', 'HEAD'], text=True).strip() != PIN:
        raise RuntimeError('Frontend source revision differs')
    patch = (PROFILES[profile] / 'frontend.patch').read_bytes()
    diff = output(['git', '-C', source, 'diff', 'HEAD', '--binary'])
    if diff != patch:
        raise RuntimeError('Frontend source is not the exact reviewed patch')
    charon = (source / 'charon').resolve()
    if output(['git', '-C', charon, 'rev-parse', 'HEAD'], text=True).strip() != CHARON_PIN:
        raise RuntimeError('Charon library revision differs')
    if output(['git', '-C', charon, 'diff', 'HEAD', '--name-only'], text=True).strip():
        raise RuntimeError('Charon library source has tracked changes')
    return digest(patch)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', type=Path, required=True, help='Isolated checkout at the pinned revision')
    parser.add_argument('--opam', type=Path, required=True)
    parser.add_argument('--opam-root', type=Path, required=True)
    parser.add_argument('--switch', required=True)
    parser.add_argument('--jobs', type=int, default=8)
    parser.add_argument('--profile', choices=list(PROFILES), default='static-strings')
    args = parser.parse_args()
    if args.jobs < 1:
        parser.error('jobs must be positive')
    source, opam = args.source.resolve(), args.opam.resolve()
    parent = ROOT / 'build/hasteboots-extraction'
    parent.mkdir(parents=True, exist_ok=True)
    artifacts = Path(tempfile.mkdtemp(prefix='static-frontend-build-', dir=parent))
    record = {'status': 'started', 'claim': 'isolated experimental frontend build only',
              'source': str(source), 'source_revision': PIN, 'charon_revision': CHARON_PIN, 'commands': [],
              'script_sha256': digest(Path(__file__).read_bytes()), 'profile': args.profile}

    def save():
        (artifacts / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')

    print('Build artifacts: ' + str(artifacts), flush=True); save()
    try:
        if hashlib.sha512(opam.read_bytes()).hexdigest() != OPAM_SHA512:
            raise RuntimeError('Opam executable differs from the pinned official binary')
        if (source / '.hasteboots-probe').exists():
            raise RuntimeError('Refusing to modify the prepared official backend checkout')
        if output(['git', '-C', source, 'rev-parse', 'HEAD'], text=True).strip() != PIN:
            raise RuntimeError('Unexpected source revision')
        if not output(['git', '-C', source, 'diff', 'HEAD', '--name-only'], text=True).strip():
            subprocess.run(['git', '-C', str(source), 'apply', str(PROFILES[args.profile] / 'frontend.patch')], check=True)
        record['patch_sha256'] = verify_source(source, args.profile)
        opam_args = ['--root=' + str(args.opam_root.resolve()), '--switch=' + args.switch]
        versions = output([opam, 'list', *opam_args, '--installed', '--columns=name,version', '--short', '--color=never'], text=True)
        rows = [line.split() for line in versions.splitlines() if line.strip()]
        if any(len(row) != 2 for row in rows):
            raise RuntimeError('Unexpected package version output')
        packages = dict(rows)
        if packages != json.loads((DATA / 'opam-packages.json').read_text()):
            raise RuntimeError('OCaml dependency versions differ from the reviewed build profile')
        record['packages'] = packages
        record['package_profile_sha256'] = digest((DATA / 'opam-packages.json').read_bytes())
        command = [opam, 'exec', *opam_args, '--', 'dune', 'build', 'main.exe', '--profile', 'release', '-j', str(args.jobs)]
        record['commands'].append([str(x) for x in command]); save()
        with (artifacts / 'build.log').open('w') as log:
            subprocess.run([str(x) for x in command], cwd=source / 'src', stdout=log, stderr=subprocess.STDOUT, check=True)
        verify_source(source, args.profile)
        executable = source / 'src/_build/default/main.exe'
        record['executable'] = str(executable)
        record['executable_sha256'] = digest(executable.read_bytes())
        record['opam_sha512'] = OPAM_SHA512
        record['status'] = 'passed'
        print('Built reviewed frontend: ' + record['executable_sha256'])
    except (Exception, SystemExit) as error:
        record['status'] = 'failed'; record['error'] = str(error)
        raise SystemExit(f'Frontend build failed; inspect {artifacts}: {error}') from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in artifacts.glob('*.log')}
        save()


if __name__ == '__main__':
    main()
