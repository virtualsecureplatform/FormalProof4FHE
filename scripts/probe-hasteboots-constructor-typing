#!/usr/bin/env python3
"""Check constructor translation fixes; constructor mode still requires an admission-free audit."""
import argparse
import json
import os
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / 'scripts/probe-hasteboots-usize-ctlz'))
PARAMETERS, BUILD, COMMON = BASE['PARAMETERS'], BASE['BUILD'], BASE['COMMON']
digest = BASE['digest']
DATA = ROOT / 'interop/aeneas/constructor-typing'
PROOFS = ['parent_fields', 'both_calls', 'propagate_exact']
NAMESPACE = 'hasteboots_constructor_typing'


def validate_output(raw, mode):
    if mode not in ['fixture', 'constructor', 'concrete-partial']:
        raise RuntimeError('Unknown constructor probe mode')
    namespace = NAMESPACE if mode == 'fixture' else PARAMETERS['NAMESPACE']
    if raw.count('import Aeneas\n') != 1 or not raw.rstrip().endswith('end ' + namespace):
        raise RuntimeError('Truncated or unexpected extraction')
    if re.search(r'\b(axiom|opaque|constant|sorry|sorryAx|native_decide|unsafe)\b|decide\s*\+native', raw):
        raise RuntimeError('Admitted or native-proof extraction')
    if re.findall(r'^set_option (maxHeartbeats|maxRecDepth) ([0-9]+)$', raw, re.M) != [
            ('maxHeartbeats', '200000'), ('maxRecDepth', '1000')]:
        raise RuntimeError('Unexpected proof limits')
    names = ['both', 'propagate'] if mode == 'fixture' else [
        'new_encoded' if mode == 'concrete-partial' else 'generic_new_encoded',
        'pcs.matrix_weighted.Parameters.new_encoded']
    for name in names:
        if not re.search(r'^def ' + re.escape(name) + r'\s', raw, re.M):
            raise RuntimeError('Missing source function: ' + name)
    imports = 'import Aeneas.Std\nimport Aeneas.Tactic.RustAttributes\n'
    if mode != 'fixture':
        imports += 'import Aeneas.Data.Discriminant\n'
    return raw.replace('import Aeneas\n', imports)


def validate_ir(ir):
    translated = ir.get('translated') if isinstance(ir, dict) else None
    if not isinstance(translated, dict) or ir.get('has_errors') is not False or translated.get('target_information') != [
            {'key': 'x86_64-unknown-linux-gnu', 'value': {'target_pointer_size': 8, 'is_little_endian': True}}]:
        raise RuntimeError('Incomplete or wrong-target Charon extraction')


def validate_constructor_bodies(ir, opaque_encoder):
    functions = [d for d in ir['translated']['fun_decls'] if isinstance(d, dict)]
    def names(d):
        return [part['Ident'][0] for part in d['item_meta']['name'] if 'Ident' in part]
    wrapper = [d for d in functions if names(d) == [PARAMETERS['NAMESPACE'], 'new_encoded']]
    constructor = [d for d in functions if names(d) == ['pcs', 'matrix_weighted', 'new_encoded']]
    encoders = [d for d in functions if names(d) == ['pcs', 'utils', 'code', 'block', 'encode_row']]
    for label, selected in [('wrapper', wrapper), ('constructor', constructor)]:
        body = selected[0].get('body') if len(selected) == 1 else None
        if not isinstance(body, dict) or set(body) != {'Structured'} or not isinstance(body['Structured'], dict):
            raise RuntimeError('Missing or nontransparent native ' + label)
    if opaque_encoder and (len(encoders) != 1 or encoders[0].get('body') != 'Opaque'):
        raise RuntimeError('Unused encoder opacity differs from the selected scope')
    return {'wrapper': wrapper[0]['def_id'], 'constructor': constructor[0]['def_id'],
            'opaque_encoder_count': len(encoders) if opaque_encoder else 0,
            'residual_constraint_functions': [d['def_id'] for d in functions
                if d.get('generics', {}).get('trait_type_constraints')]}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--tools', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--mode', choices=['fixture', 'constructor', 'concrete-partial'], default='fixture')
    parser.add_argument('--opaque-encode-row', action='store_true',
                        help='Keep the unused encoder body opaque in the concrete-partial diagnostic only')
    args = parser.parse_args()
    if args.opaque_encode_row and args.mode != 'concrete-partial':
        parser.error('--opaque-encode-row requires --mode concrete-partial')
    tools, backend = args.tools.resolve(), args.backend.resolve()
    parent = ROOT / 'build/hasteboots-extraction'
    parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='constructor-typing-' + args.mode + '-', dir=parent))
    record = {'status': 'started', 'mode': args.mode, 'commands': [],
              'claim': 'translation regression subgate; source refinement and security unproved',
              'script_sha256': digest(Path(__file__).read_bytes()), 'aeneas_invoked': False,
              'opaque_encode_row': args.opaque_encode_row}
    def save():
        (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, name, env=None):
        record['commands'].append([str(x) for x in command]); save()
        with (out / name).open('w') as log:
            subprocess.run([str(x) for x in command], cwd=ROOT, env=env,
                           stdout=log, stderr=subprocess.STDOUT, check=True)
    print('Probe artifacts: ' + str(out), flush=True); save()
    try:
        for name, expected in PARAMETERS['TOOLS'].items():
            if digest((tools / name).read_bytes()) != expected:
                raise RuntimeError('Official tool hash differs: ' + name)
        record['backend_patches'] = PARAMETERS['verify_backend'](backend, out)
        receipt = json.loads(args.build_receipt.read_text())
        if receipt.get('status') != 'passed' or receipt.get('profile') not in ['constructor-typing', 'discriminants', 'u32-ranges']:
            raise RuntimeError('Missing passed constructor-typing build receipt')
        if receipt.get('script_sha256') != digest((ROOT / 'scripts/build-hasteboots-static-frontend').read_bytes()):
            raise RuntimeError('Stale builder policy')
        patch = BUILD['verify_source'](Path(receipt['source']), receipt['profile'])
        if receipt['patch_sha256'] != patch or receipt['package_profile_sha256'] != digest((BUILD['DATA'] / 'opam-packages.json').read_bytes()):
            raise RuntimeError('Stale source/package profile')
        frontend = Path(receipt['executable'])
        if digest(frontend.read_bytes()) != receipt['executable_sha256']:
            raise RuntimeError('Frontend executable differs')
        record.update(frontend_sha256=receipt['executable_sha256'], patch_sha256=patch,
                      build_receipt_sha256=digest(args.build_receipt.read_bytes()))
        llbc = out / 'extracted.llbc'
        options = ['-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000',
                   '-max-recdepth', '1000', '-abort-on-error']
        if args.mode == 'fixture':
            record['fixture_sha256'] = digest((DATA / 'fixture.rs').read_bytes())
            run([tools / 'charon', 'rustc', '--preset=aeneas', '--include', 'core::result',
                 '--dest-file', llbc, '--', '--crate-type', 'lib', '--edition=2024',
                 '--crate-name', NAMESPACE, DATA / 'fixture.rs'], 'charon.log')

        else:
            native = ROOT.parent / 'HasteBoots'
            if PARAMETERS['checked'](['git', '-C', native, 'rev-parse', 'HEAD'], text=True).strip() != PARAMETERS['NATIVE_PIN']:
                raise RuntimeError('Native source revision differs')
            if PARAMETERS['checked'](['git', '-C', native, 'diff', 'HEAD', '--name-only'], text=True).strip():
                raise RuntimeError('Native source has tracked changes')
            fixture = ROOT / 'scripts/native-fixtures/ntt-cache'
            (out / 'Cargo.toml').write_text((fixture / 'Cargo.toml').read_text().replace('../../../../HasteBoots', str(native)))
            (out / 'Cargo.lock').write_bytes((fixture / 'Cargo.lock').read_bytes())
            (out / 'src').mkdir()
            wrapper_path = ROOT / 'interop/aeneas/parameters/wrapper.rs' if args.mode == 'concrete-partial' else DATA / 'wrapper.rs'
            wrapper = wrapper_path.read_bytes()
            (out / 'src/lib.rs').write_bytes(wrapper)
            record.update(wrapper_path=str(wrapper_path.relative_to(ROOT)), wrapper_sha256=digest(wrapper), lock_sha256=digest((out / 'Cargo.lock').read_bytes()),
                          native_revision=PARAMETERS['NATIVE_PIN'])
            env = dict(os.environ)
            env.setdefault('CARGO_TARGET_DIR', str(parent / 'cargo-constructor-typing'))
            command = [tools / 'charon', 'cargo', '--preset=aeneas']
            if args.mode == 'concrete-partial': command += ['--monomorphize-mut']
            if args.opaque_encode_row: command += ['--opaque', 'pcs::utils::code::block::_::encode_row']
            start = 'new_encoded' if args.mode == 'concrete-partial' else 'generic_new_encoded'
            run([*command, '--start-from', PARAMETERS['NAMESPACE'] + '::' + start, '--include', 'pcs',
                 '--include', 'core::option', '--include', 'core::result',
                 '--include', 'core::num::_::checked_next_power_of_two',
                 '--include', 'core::num::_::one_less_than_next_power_of_two',
                 '--dest-file', llbc, '--', '--manifest-path', out / 'Cargo.toml', '--lib', '--locked'], 'charon.log', env)
        ir = json.loads(llbc.read_text())
        record.update(charon_exit_code=0, charon_has_errors=ir.get('has_errors'), llbc_sha256=digest(llbc.read_bytes()))
        if args.mode == 'concrete-partial' and ir.get('has_errors') is not False:
            record['failure_kind'] = 'invalid-partial-constructor-ir'
        validate_ir(ir)
        if args.mode == 'concrete-partial':
            record['critical_bodies'] = validate_constructor_bodies(ir, args.opaque_encode_row)
        record['aeneas_invoked'] = True
        if args.mode == 'fixture':
            run([tools / 'aeneas', *options, '-dest', out / 'official', llbc], 'official.log')
            baseline = (out / 'official/Extracted.lean').read_text()
            if baseline.count('  coremarkerCopyInst : core.marker.Copy ') != 2 or 'lift (core.result.Result.Insts.CoreOpsTry.branch value)' not in baseline:
                raise RuntimeError('Official duplicate-parent/effect baseline changed')
            record['official_status'] = 'duplicate_parent_and_double_result_rejected'
        run([frontend, *options, '-dest', out / 'patched', llbc], 'patched.log')
        if re.search(r'Uncaught exception|\[Error\]', BASE['BASE']['clear_colors']((out / 'patched.log').read_text())):
            raise RuntimeError('Frontend reported errors despite exit status')
        raw = (out / 'patched/Extracted.lean').read_text()
        runtime = validate_output(raw, args.mode)
        if args.mode == 'fixture':
            proof = (DATA / 'Proof.lean').read_text()
            PARAMETERS['validate_proof_source'](proof, PROOFS)
            names = [NAMESPACE + '.' + n for n in ['both', 'propagate']]
            names += ['HasteBootsConstructorTypingProof.' + n for n in PROOFS]
        else:
            proof = ''
            support = (ROOT / 'interop/aeneas/usize-ctlz/Runtime.lean').read_text()
            PARAMETERS['validate_proof_source'](support, BASE['RUNTIME_PROOFS'])
            if support.count('import Aeneas.Std\n') != 1:
                raise RuntimeError('Unexpected primitive support imports')
            marker = 'open Aeneas Aeneas.Std Result ControlFlow Error\n'
            if runtime.count(marker) != 1:
                raise RuntimeError('Unexpected generated prelude')
            runtime = runtime.replace(marker, support.replace('import Aeneas.Std\n', '') + '\n' + marker, 1)
            record['runtime_sha256'] = digest(support.encode())
            names = [PARAMETERS['NAMESPACE'] + '.' + n for n in
                     ['new_encoded' if args.mode == 'concrete-partial' else 'generic_new_encoded',
                      'pcs.matrix_weighted.Parameters.new_encoded']]
        checked = out / 'Checked.lean'
        checked.write_text(runtime + '\n' + proof + ''.join('\n#print axioms ' + n + '\n' for n in names))
        record.update(generated_sha256=digest(raw.encode()), proof_sha256=digest(proof.encode()),
                      checked_sha256=digest(checked.read_bytes()))
        run([ROOT / 'scripts/in-container', 'bash', '-euc',
             'cd -- "$1"; lake env lean -DwarningAsError=true "$2"', '_',
             COMMON['container_path'](backend / 'backends/lean'), COMMON['container_path'](checked)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        record['status'] = 'passed'
        print(f'{args.mode} passed: {len(names)} dependency audits; source/compiler/security refinement unproved')
    except (Exception, SystemExit) as error:
        record['status'] = 'failed'; record['error'] = str(error)
        raise SystemExit(f'Typing probe failed; inspect {out}: {error}') from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
