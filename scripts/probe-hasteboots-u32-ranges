#!/usr/bin/env python3
"""Check read-only U32 range storage and original time carriers; heap/byte refinement remains open."""
import argparse
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / 'scripts/probe-hasteboots-discriminants'))
PARAMETERS, COMMON, BUILD = BASE['PARAMETERS'], BASE['COMMON'], BASE['BUILD']
digest = BASE['BASE']['digest']
DATA = ROOT / 'interop/aeneas/u32-ranges'
TIME_TYPES = ['std::time::SystemTime', 'std::time::SystemTimeError', 'std::sys::time::unix::SystemTime',
              'std::sys::pal::unix::time::Timespec', 'core::time::Duration', 'core::num::niche_types::Nanoseconds']
CASES = {
    'ranges': ('fixture.rs', 'hasteboots_u32_ranges', ['Stored', 'preserve', 'select', 'identity'],
               'Proof.lean', 'HasteBootsU32RangeProof',
               ['preserve_exact', 'select_exact', 'identity_exact', 'nanos_bounds', 'window_bounds', 'select_sound']),
    'time': ('time.rs', 'hasteboots_time_carriers', [name.replace('::', '.') for name in TIME_TYPES] +
             ['preserve_duration', 'preserve_time', 'preserve_error'],
             'TimeProof.lean', 'HasteBootsTimeCarrierProof',
             ['duration_exact', 'time_exact', 'error_exact', 'duration_nanos_bounds', 'time_nanos_bounds'])}


def validate_output(raw, namespace, names):
    if raw.count('import Aeneas\n') != 1 or not raw.rstrip().endswith('end ' + namespace):
        raise RuntimeError('Incomplete scalar range output')
    if re.search(r'\b(axiom|opaque|constant|sorry|sorryAx|native_decide|unsafe)\b|decide\s*\+native', raw):
        raise RuntimeError('Admitted scalar range declaration')
    if re.findall(r'^set_option (maxHeartbeats|maxRecDepth) ([0-9]+)$', raw, re.M) != [
            ('maxHeartbeats', '200000'), ('maxRecDepth', '1000')]:
        raise RuntimeError('Unexpected scalar range proof limits')
    for name in names:
        if not re.search(r'^(def|structure)\s+' + re.escape(name) + r'\s', raw, re.M):
            raise RuntimeError('Missing scalar range declaration: ' + name)
    return raw.replace('import Aeneas\n', '')


def inspect_patterns(ir, expected, scalar='U32'):
    if scalar not in ['U32', 'Usize', 'U64']: raise RuntimeError('Unsupported range scalar')
    if ir.get('has_errors') is not False or ir['translated']['target_information'] != [
            {'key': 'x86_64-unknown-linux-gnu', 'value': {'target_pointer_size': 8, 'is_little_endian': True}}]:
        raise RuntimeError('Incomplete or wrong-target scalar range IR')
    pool, patterns = {}, []
    def collect(value):
        if isinstance(value, dict):
            if 'HashConsedValue' in value:
                index, content = value['HashConsedValue']
                if index in pool and pool[index] != content: raise RuntimeError('Conflicting scalar type reference')
                pool[index] = content
            if 'Pattern' in value: patterns.append(value['Pattern'])
            for child in value.values(): collect(child)
        elif isinstance(value, list):
            for child in value: collect(child)
    collect(ir)
    def resolve(value, seen=frozenset()):
        if isinstance(value, dict):
            if 'HashConsedValue' in value:
                index, content = value['HashConsedValue']
                if index in seen: raise RuntimeError('Cyclic scalar type reference')
                return resolve(content, seen | {index})
            if 'Deduplicated' in value:
                index = value['Deduplicated']
                if index in seen or index not in pool: raise RuntimeError('Invalid scalar type reference')
                return resolve(pool[index], seen | {index})
        return value
    found = set()
    for pattern in patterns:
        if len(pattern) != 2 or resolve(pattern[0]) != {'Literal': {'UInt': scalar}}:
            raise RuntimeError('Unsupported scalar pattern base')
        bounds = pattern[1].get('Range')
        if not isinstance(bounds, list) or len(bounds) != 2: raise RuntimeError('Non-range scalar pattern')
        values = []
        for bound in bounds:
            value = bound.get('kind', {}).get('Literal', {}).get('Scalar', {}).get('Unsigned')
            if not isinstance(value, list) or len(value) != 2 or value[0] != scalar or resolve(bound['ty']) != resolve(pattern[0]):
                raise RuntimeError('Unsupported scalar range bound')
            values.append(int(value[1]))
        if not 0 <= values[0] <= values[1] < 2**(32 if scalar == 'U32' else 64): raise RuntimeError('Invalid scalar range')
        found.add(tuple(values))
    if found != set(expected): raise RuntimeError('Source scalar ranges differ from reviewed bounds')
    return sorted(found)


def output_rejected(code, log, raw, namespace):
    clean = re.sub(r'\x1b\[[0-9;?]*[A-Za-z]', '', log)
    return (code != 0 or re.search(r'Uncaught exception|\[Error\]', clean) is not None or
            re.search(r'\b(axiom|opaque|constant|sorry|sorryAx|native_decide|unsafe)\b', raw) is not None or
            not raw.rstrip().endswith('end ' + namespace))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--tools', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    parser.add_argument('--build-receipt', type=Path, required=True)
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='u32-ranges-', dir=parent))
    record = {'status': 'started', 'commands': [], 'script_sha256': digest(Path(__file__).read_bytes()),
              'claim': 'read-only range/time storage only; casts, pointer/heap, native bytes/security unproved'}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log, required=True):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            result = subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT)
        if required and result.returncode: raise RuntimeError(log + ' exited ' + str(result.returncode))
        return result.returncode
    print('Range artifacts: ' + str(out), flush=True); save()
    try:
        tools, backend = args.tools.resolve(), args.backend.resolve()
        receipt = json.loads(args.build_receipt.read_text())
        if receipt.get('status') != 'passed' or receipt.get('profile') != 'u32-ranges':
            raise RuntimeError('Wrong or failed range frontend receipt')
        run([ROOT / 'scripts/probe-hasteboots-discriminants', '--tools', tools, '--backend', backend,
             '--build-receipt', args.build_receipt.resolve()], 'preflight.log')
        paths = re.findall(r'^Discriminant artifacts: (.+)$', (out / 'preflight.log').read_text(), re.M)
        if len(paths) != 1: raise RuntimeError('Missing discriminant preflight')
        preflight = Path(paths[0]); manifest = preflight / 'manifest.json'; previous = json.loads(manifest.read_text())
        if previous.get('status') != 'passed': raise RuntimeError('Discriminant preflight not accepted')
        record.update(preflight_manifest=str(manifest), preflight_manifest_sha256=digest(manifest.read_bytes()),
                      build_receipt_sha256=digest(args.build_receipt.read_bytes()), frontend_sha256=receipt['executable_sha256'])
        frontend = Path(receipt['executable']); source = (preflight / 'Checked.lean').read_text()
        names = list(previous['dependency_audit']); new_names = []; record['cases'] = {}
        inputs = ['frontend.patch']
        options = ['-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000', '-max-recdepth', '1000', '-abort-on-error']
        for case, (fixture, namespace, declarations, proof_file, proof_namespace, proofs) in CASES.items():
            llbc = out / (case + '.llbc')
            command = [tools / 'charon', 'rustc', '--preset=aeneas', '--dest-file', llbc]
            if case == 'time':
                for name in TIME_TYPES: command += ['--include', name]
            run([*command, '--', '--crate-type', 'lib', '--edition=2024', '--crate-name', namespace,
                 (DATA / fixture).relative_to(ROOT)], case + '-charon.log')
            ir = json.loads(llbc.read_text())
            ranges = inspect_patterns(ir, [(0, 999999999), (7, 19)] if case == 'ranges' else [(0, 999999999)])
            code = run([tools / 'aeneas', *options, '-dest', out / (case + '-baseline'), llbc], case + '-baseline.log', False)
            if code == 0 or 'TPattern' not in (out / (case + '-baseline.log')).read_text():
                raise RuntimeError('Official unsupported-pattern baseline changed')
            run([frontend, *options, '-dest', out / case, llbc], case + '-aeneas.log')
            raw = (out / case / (case.capitalize() + '.lean')).read_text()
            if output_rejected(0, (out / (case + '-aeneas.log')).read_text(), raw, namespace):
                raise RuntimeError('Incomplete or admitted positive output')
            runtime = validate_output(raw, namespace, declarations)
            snapshot = 'Generated.lean' if case == 'ranges' else 'TimeGenerated.lean'
            PARAMETERS['verify_snapshot'](raw, (DATA / snapshot).read_text())
            proof = (DATA / proof_file).read_text(); PARAMETERS['validate_proof_source'](proof, proofs)
            source += '\n' + runtime + '\n' + proof
            new_names += [namespace + '.' + name for name in declarations]
            new_names += [proof_namespace + '.' + name for name in proofs]
            record['cases'][case] = {'llbc_sha256': digest(llbc.read_bytes()), 'generated_sha256': digest(raw.encode()), 'ranges': ranges}
            inputs += [fixture, snapshot, proof_file]
        record['negative'] = {}
        for case in ['signed', 'disjoint', 'cast', 'nonnull']:
            fixture = DATA / ('unsupported-' + case + '.rs'); namespace = 'hasteboots_range_' + case
            llbc = out / (namespace + '.llbc')
            extra = ['--include', 'core::ptr::non_null::NonNull'] if case == 'nonnull' else []
            run([tools / 'charon', 'rustc', '--preset=aeneas', *extra, '--dest-file', llbc,
                 '--', '--crate-type', 'lib', '--edition=2024', '--crate-name', namespace, fixture.relative_to(ROOT)], case + '-charon.log')
            ir = json.loads(llbc.read_text())
            if ir.get('has_errors') is not False: raise RuntimeError('Invalid negative Rust fixture')
            code = run([frontend, *options, '-dest', out / ('negative-' + case), llbc], case + '-aeneas.log', False)
            leanfile = out / ('negative-' + case) / ''.join(part.capitalize() for part in namespace.split('_'))
            leanfile = leanfile.with_suffix('.lean'); raw = leanfile.read_text() if leanfile.exists() else ''
            if not output_rejected(code, (out / (case + '-aeneas.log')).read_text(), raw, namespace):
                raise RuntimeError('Unsupported scalar operation was accepted: ' + case)
            record['negative'][case] = {'llbc_sha256': digest(llbc.read_bytes()), 'exit_code': code, 'source_sha256': digest(fixture.read_bytes())}
            inputs.append(fixture.name)
        names += new_names
        source += ''.join('\n#print axioms ' + name + '\n' for name in new_names)
        checked = out / 'Checked.lean'; checked.write_text(source)
        record.update(inputs={name: digest((DATA / name).read_bytes()) for name in inputs}, checked_sha256=digest(checked.read_bytes()))
        run([ROOT / 'scripts/in-container', 'bash', '-euc', 'cd -- "$1"; lake env lean -DwarningAsError=true "$2"', '_',
             COMMON['container_path'](backend / 'backends/lean'), COMMON['container_path'](checked)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        BUILD['verify_source'](Path(receipt['source']), 'u32-ranges')
        if digest(frontend.read_bytes()) != receipt['executable_sha256']: raise RuntimeError('Frontend changed during extraction')
        record['status'] = 'passed'; print('Range storage passed: ' + str(len(names)) + ' combined dependency audits')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); save()
        raise SystemExit('Range storage failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
