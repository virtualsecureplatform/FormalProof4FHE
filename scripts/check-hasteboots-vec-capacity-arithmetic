#!/usr/bin/env python3
"""Freshly retain constructor scalar assignments and check their arithmetic semantics.
Whole constructor control flow, allocator/ABI refinement and physical work remain open.
"""
import argparse
import copy
import hashlib
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile
ROOT=Path(__file__).resolve().parent.parent
DATA=ROOT/'interop/aeneas/vec-capacity-arithmetic'
BUILD=runpy.run_path(str(ROOT/'scripts/build-hasteboots-inline-tools'))
PARAM=runpy.run_path(str(ROOT/'scripts/extract-hasteboots-parameters'))
PARENT=runpy.run_path(str(ROOT/'scripts/check-hasteboots-allocator-caller'))
REIFIER=runpy.run_path(str(ROOT/'scripts/reify-hasteboots-vec-capacity-arithmetic'))
INCLUDES=['alloc::raw_vec','alloc::vec','alloc::alloc','core::alloc::layout','core::ptr::unique','core::ptr::non_null','core::mem::alignment']
def digest(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def negatives(ir):
 base=REIFIER['Reifier'](ir);records={}
 def row(c,label):
  r=next(r for r in base.rows if r['operation']==label)
  def walk(node):
   if isinstance(node,dict):
    if set(node)=={'span','id','kind','comments_before'} and node['id']==r['statement']['id']:return node
    for v in node.values():
     found=walk(v)
     if found is not None:return found
   elif isinstance(node,list):
    for v in node:
     found=walk(v)
     if found is not None:return found
  return walk(c['fun_decls'][r['function']]['body'])
 def check(label,mutate):
  changed=copy.deepcopy(ir);mutate(changed['translated'])
  try:REIFIER['Reifier'](changed).render()
  except (ValueError,KeyError,TypeError,IndexError) as e:records[label]=str(e)
  else:raise RuntimeError('Negative accepted: '+label)
 def binary(c,label):return row(c,label)['kind']['Assign'][1]['BinaryOp']
 def mul(c):return binary(c,'checkedMultiply')
 check('wrong_target',lambda c:c['target_information'][0]['value'].update(target_pointer_size=4))
 check('not_monomorphized',lambda c:c['options'].update(monomorphize=False))
 check('wrong_mir',lambda c:c['options'].update(mir='Built'))
 check('allocator_erased',lambda c:c['options'].update(preserve_allocator=False))
 check('hidden_source',lambda c:c['options']['opaque'].append('alloc::raw_vec'))
 check('unsafe_root',lambda c:c['fun_decls'][0]['signature'].update(is_unsafe=True))
 check('wrong_root_input',lambda c:c['fun_decls'][0]['signature']['inputs'].__setitem__(0,REIFIER['U64']))
 check('unchecked_multiplication',lambda c:mul(c).__setitem__(0,{'Mul':'UB'}))
 check('wrong_operand_width',lambda c:mul(c)[1]['Move'].update(ty={'Untagged':{'Literal':{'UInt':'U32'}}}))
 check('copy_instead_of_move',lambda c:mul(c)[1].update(Copy=mul(c)[1].pop('Move')))
 check('wrong_destination_type',lambda c:row(c,'checkedMultiply')['kind']['Assign'][0].update(ty=REIFIER['BOOL']))
 check('aliased_operands',lambda c:mul(c)[2].update(Move=copy.deepcopy(mul(c)[1]['Move'])))
 check('unknown_arithmetic_effect',lambda c:row(c,'checkedMultiply')['kind']['Assign'][1].update(hidden_effect=True))
 check('wrong_signed_shift',lambda c:binary(c,'wrappingShiftLeft')[2]['Const']['kind']['Literal']['Scalar']['Signed'].__setitem__(1,'64'))
 check('word_instead_of_boolean',lambda c:row(c,'logicalNot')['kind']['Assign'][1]['UnaryOp'][1]['Move'].update(ty=REIFIER['USIZE']))
 check('missing_checked_assignment',lambda c:row(c,'checkedMultiply').update(kind='Nop'))
 check('duplicate_checked_assignment',lambda c:c['fun_decls'][next(r['function'] for r in base.rows if r['operation']=='checkedMultiply')]['body']['Structured']['body']['statements'].append(copy.deepcopy(row(c,'checkedMultiply'))))
 check('wrong_operator_owner',lambda c:c['fun_decls'][next(r['function'] for r in base.rows if r['operation']=='checkedMultiply')]['item_meta'].update(opacity='Foreign'))
 check('unknown_statement_metadata',lambda c:row(c,'checkedMultiply').update(unmodeled_effect=True))
 check('changed_literal',lambda c:binary(c,'wrappingSubtract')[2]['Const']['kind']['Literal']['Scalar']['Unsigned'].__setitem__(1,'1'))
 check('unregistered_local',lambda c:mul(c)[1]['Move']['kind'].update(Local=99999))
 def prefix(c):return c['fun_decls'][base.layout_prefix.function['def_id']]['body']['Structured']['body']['statements']
 def outer(c):return prefix(c)[28]['kind']['Switch']['If']
 def inner(c):return outer(c)[2]['statements'][-1]['kind']['Switch']['If']
 def byte(c):return next(g for g in c['global_decls'] if g and REIFIER['name'](g)=='core::mem::SizedTypeProperties::LAYOUT')
 check('overflow_move_instead_of_copy',lambda c:outer(c)[0].update(Move=outer(c)[0].pop('Copy')))
 check('layout_copy_instead_of_move',lambda c:inner(c)[0].update(Copy=inner(c)[0].pop('Move')))
 check('swapped_layout_suffixes',lambda c:inner(c).__setitem__(slice(1,3),inner(c)[1:3][::-1]))
 check('changed_byte_layout_size',lambda c:byte(c)['value']['kind']['Adt'][1][0]['kind']['Literal']['Scalar']['Unsigned'].__setitem__(1,'2'))
 check('changed_byte_alignment',lambda c:byte(c)['value']['kind']['Adt'][1][1]['kind']['Adt'][1][0]['kind']['Adt'].__setitem__(0,1))
 check('changed_physical_layout',lambda c:c['type_decls'][4]['layout'][0]['value']['variant_layouts'][0]['field_offsets'].__setitem__(0,0))
 check('changed_alignment_discriminant',lambda c:c['type_decls'][12]['kind']['Enum'][0]['discriminant']['Scalar']['Unsigned'].__setitem__(1,'2'))
 check('changed_prefix_retag',lambda c:prefix(c)[6]['kind']['Assign'][1]['Use'].__setitem__(1,'No'))
 check('changed_prefix_boolean',lambda c:prefix(c)[6]['kind']['Assign'][1]['Use'][0]['Const']['kind']['Literal'].__setitem__('Bool',False))
 check('extra_prefix_statement',lambda c:prefix(c).insert(0,copy.deepcopy(prefix(c)[0])))
 check('duplicate_byte_layout_global',lambda c:c['global_decls'].append(copy.deepcopy(byte(c))))
 def accepted(c):return inner(c)[1]['statements']
 def size(c):return accepted(c)[-1]['kind']['Switch']['SwitchInt']
 def aggregate(c,index):return accepted(c)[index]['kind']['Assign'][1]['Aggregate']
 check('changed_size_case',lambda c:size(c)[2][0][0][0]['Scalar']['Unsigned'].__setitem__(1,'1'))
 check('size_move_instead_of_copy',lambda c:size(c)[0].update(Move=size(c)[0].pop('Copy')))
 check('missing_positive_size_arm',lambda c:size(c).__setitem__(3,None))
 check('changed_accepted_prefix_extent',lambda c:accepted(c).insert(0,copy.deepcopy(accepted(c)[0])))
 check('changed_layout_success_variant',lambda c:aggregate(c,2)[0]['Adt'].__setitem__(1,1))
 check('changed_reservation_success_variant',lambda c:aggregate(c,7)[0]['Adt'].__setitem__(1,1))
 check('changed_aggregate_union_field',lambda c:aggregate(c,1)[0]['Adt'].__setitem__(2,0))
 check('changed_layout_result_fields',lambda c:c['type_decls'][19]['kind']['Enum'][0]['fields'][0].update(ty=REIFIER['USIZE']))
 check('changed_reservation_result_discriminant',lambda c:c['type_decls'][14]['kind']['Enum'][0]['discriminant']['Scalar']['Signed'].__setitem__(1,'1'))
 check('changed_result_success_projection',lambda c:accepted(c)[6]['kind']['Assign'][1]['Use'][0]['Move']['kind']['Projection'][1]['Field'].__setitem__(1,1))
 def zero(c):return size(c)[2][0][1]['statements']
 def conversion(c):return zero(c)[6]['kind']['Assign'][1]['UnaryOp']
 check('zero_return_missing',lambda c:zero(c)[-1].update(kind='Nop'))
 check('wrong_nonnull_transmute_target',lambda c:conversion(c)[0]['Cast']['Transmute'].__setitem__(1,REIFIER['USIZE']))
 check('wrong_dangling_alignment_source',lambda c:conversion(c)[1]['Copy']['kind'].update(Local=39))
 check('nonnull_pointer_nullable',lambda c:c['type_decls'][13]['kind']['Struct'][0]['ty']['Untagged']['Pattern'].__setitem__(1,'Any'))
 check('wrong_zero_rawvec_field_order',lambda c:c['type_decls'][3]['kind']['Struct'].reverse())
 check('wrong_zero_return_variant',lambda c:zero(c)[16]['kind']['Assign'][1]['Aggregate'][0]['Adt'].__setitem__(1,1))
 check('wrong_zero_physical_pointer_offset',lambda c:c['type_decls'][13]['layout'][0]['value']['variant_layouts'][0]['field_offsets'].__setitem__(0,8))
 check('wrong_capacity_upper_bound',lambda c:zero(c)[12]['kind']['Assign'][1]['Aggregate'][1][0]['Const']['ty']['Untagged']['Pattern'][1]['Range'][1]['kind']['Literal']['Scalar']['Unsigned'].__setitem__(1,'9223372036854775808'))
 def caller(c,fid):return c['fun_decls'][fid]['body']['Structured']['body']['statements']
 def call(c,fid,index):return caller(c,fid)[index]['kind']['Call']['call']
 def statement(c,ident):return next(s for s in caller(c,2) if s['id']==ident)
 check('global_copy_instead_of_move',lambda c:call(c,1,5)['args'][1].update(Copy=call(c,1,5)['args'][1].pop('Move')))
 check('inner_global_copy_instead_of_move',lambda c:call(c,2,6)['args'][2].update(Copy=call(c,2,6)['args'][2].pop('Move')))
 check('reordered_inner_arguments',lambda c:call(c,2,6)['args'].__setitem__(slice(1,3),call(c,2,6)['args'][1:3][::-1]))
 check('wrong_root_call_target',lambda c:call(c,0,3)['func']['Regular']['kind']['Fun'].__setitem__('Regular',2))
 check('root_copy_instead_of_move',lambda c:call(c,0,3)['args'][0].update(Copy=call(c,0,3)['args'][0].pop('Move')))
 check('changed_callee_signature',lambda c:c['fun_decls'][3]['signature']['inputs'].__setitem__(2,REIFIER['USIZE']))
 check('changed_allocation_mode_discriminant',lambda c:c['type_decls'][10]['kind']['Enum'][0]['discriminant']['Scalar']['Signed'].__setitem__(1,'1'))
 check('missing_global_construction',lambda c:caller(c,1)[4].update(kind='Nop'))
 check('missing_allocation_mode_construction',lambda c:caller(c,2)[5].update(kind='Nop'))
 check('caller_size_move_instead_of_copy',lambda c:statement(c,85)['kind']['Switch']['SwitchInt'][0].update(Move=statement(c,85)['kind']['Switch']['SwitchInt'][0].pop('Copy')))
 check('caller_false_assumption',lambda c:statement(c,106)['kind']['Assert']['assert'].update(expected=False))
 check('caller_wrong_assumption_failure',lambda c:statement(c,106)['kind']['Assert'].update(on_failure='Panic'))
 check('changed_vec_wrapper_fields',lambda c:c['type_decls'][0]['kind']['Struct'].reverse())
 check('changed_vec_wrapper_offset',lambda c:c['type_decls'][0]['layout'][0]['value']['variant_layouts'][0]['field_offsets'].__setitem__(1,8))
 check('missing_root_return',lambda c:caller(c,0)[-1].update(kind='Nop'))
 check('extra_call_effect',lambda c:caller(c,2)[6]['kind']['Call'].update(hidden_effect=True))
 def modes(c):return size(c)[3]['statements'][2]['kind']['Switch']['Match']
 def arm(c,mode):return modes(c)[1][mode][1]['statements']
 def borrow(c,mode):return arm(c,mode)[1]['kind']['Assign'][1]['Ref']
 def allocation_call(c,mode):return arm(c,mode)[2]['kind']['Call']['call']
 check('changed_positive_mode_place',lambda c:modes(c)[0]['kind'].update(Local=21))
 check('swapped_allocation_mode_arms',lambda c:modes(c)[1].reverse())
 check('mutable_global_borrow',lambda c:borrow(c,0).update(kind='Mut'))
 check('wrong_global_borrow_local',lambda c:borrow(c,0)['place']['kind'].update(Local=2))
 check('changed_global_borrow_metadata',lambda c:borrow(c,0)['ptr_metadata']['Const']['kind'].update(Adt=[0,[]]))
 check('copied_allocation_reference',lambda c:allocation_call(c,0)['args'][0].update(Copy=allocation_call(c,0)['args'][0].pop('Move')))
 check('moved_allocation_layout',lambda c:allocation_call(c,1)['args'][1].update(Move=allocation_call(c,1)['args'][1].pop('Copy')))
 check('wrong_zeroed_allocation_target',lambda c:allocation_call(c,1)['func']['Regular']['kind']['Fun'].update(Regular=7))
 check('wrong_shared_temporary_scope',lambda c:arm(c,0)[3]['kind'].update(StorageDead=12))
 check('wrong_allocation_method_result',lambda c:c['fun_decls'][7]['signature'].update(output=REIFIER['USIZE']))
 check('wrong_allocation_method_owner',lambda c:c['fun_decls'][8]['item_meta'].update(opacity='Foreign'))
 def method(c,mode):return c['fun_decls'][7+mode]['body']['Structured']['body']['statements']
 def runtime(c):return c['fun_decls'][13]['body']['Structured']['body']['statements']
 def runtime_size(c):return runtime(c)[12]['kind']['Switch']['SwitchInt']
 def runtime_modes(c):return runtime_size(c)[3]['statements'][0]['kind']['Switch']['If']
 def runtime_arm(c,zeroed):return runtime_modes(c)[1 if zeroed else 2]['statements']
 check('ordinary_wrapper_zeroed_flag',lambda c:method(c,0)[1]['kind']['Call']['call']['args'][1]['Const']['kind']['Literal'].update(Bool=True))
 check('zeroed_wrapper_ordinary_flag',lambda c:method(c,1)[1]['kind']['Call']['call']['args'][1]['Const']['kind']['Literal'].update(Bool=False))
 check('copied_forwarded_layout',lambda c:method(c,0)[1]['kind']['Call']['call']['args'][0].update(Copy=method(c,0)[1]['kind']['Call']['call']['args'][0].pop('Move')))
 check('wrong_wrapper_runtime_target',lambda c:method(c,1)[1]['kind']['Call']['call']['func']['Regular']['kind']['Fun'].update(Regular=18))
 check('wrong_wrapper_return_cleanup',lambda c:method(c,0)[3]['kind'].update(StorageDead=2))
 check('wrong_wrapper_unwind',lambda c:method(c,1)[1]['kind']['Call']['on_unwind']['statements'][-1].update(kind='Abort'))
 check('wrong_runtime_signature',lambda c:c['fun_decls'][13]['signature']['inputs'].__setitem__(1,REIFIER['USIZE']))
 check('moved_runtime_size_condition',lambda c:runtime_size(c)[0].update(Move=runtime_size(c)[0].pop('Copy')))
 check('missing_runtime_return',lambda c:runtime(c)[-1].update(kind='Nop'))
 check('erased_allocator_external_boundary',lambda c:c['fun_decls'][18]['item_meta'].update(opacity='Transparent'))
 check('changed_allocator_external_safety',lambda c:c['fun_decls'][19]['signature'].update(is_unsafe=False))
 check('changed_allocator_external_return',lambda c:c['fun_decls'][18]['signature'].update(output=REIFIER['USIZE']))
 check('changed_shim_arguments',lambda c:c['fun_decls'][17]['signature']['inputs'].append(REIFIER['USIZE']))
 check('moved_runtime_mode_flag',lambda c:runtime_modes(c)[0].update(Move=runtime_modes(c)[0].pop('Copy')))
 check('wrong_zeroed_external_target',lambda c:runtime_arm(c,True)[3]['kind']['Call']['call']['func']['Regular']['kind']['Fun'].update(Regular=19))
 check('copied_external_alignment',lambda c:runtime_arm(c,False)[3]['kind']['Call']['call']['args'][1].update(Copy=runtime_arm(c,False)[3]['kind']['Call']['call']['args'][1].pop('Move')))
 check('allocator_before_shim',lambda c:runtime_arm(c,False).__setitem__(slice(0,4,3),[runtime_arm(c,False)[3],runtime_arm(c,False)[0]]))
 check('unknown_external_call_effect',lambda c:runtime_arm(c,True)[3]['kind']['Call'].update(hidden_effect=True))
 def positive(c):return runtime_size(c)[3]['statements']
 check('changed_shim_unwind_abort',lambda c:runtime_arm(c,False)[0]['kind']['Call']['on_unwind']['statements'][-1].update(kind='UnwindResume'))
 check('changed_pointer_inspection_scope',lambda c:positive(c)[1]['kind'].update(StorageLive=8))
 check('changed_pointer_cast_source',lambda c:positive(c)[5]['kind']['Assign'][1]['UnaryOp'][1]['Copy']['kind'].update(Local=7))
 check('changed_null_dispatch_local',lambda c:positive(c)[6]['kind']['Switch']['SwitchInt'][0]['Copy']['kind'].update(Local=22))
 check('changed_null_dispatch_case',lambda c:positive(c)[6]['kind']['Switch']['SwitchInt'][2][0][0][0]['Scalar']['Unsigned'].__setitem__(1,'1'))
 def nonnull(c):return positive(c)[6]['kind']['Switch']['SwitchInt'][3]['statements']
 check('changed_nonnull_cast_source',lambda c:nonnull(c)[3]['kind']['Assign'][1]['UnaryOp'][1]['Copy']['kind'].update(Local=29))
 check('changed_nonnull_option_variant',lambda c:nonnull(c)[4]['kind']['Assign'][1]['Aggregate'][0]['Adt'].__setitem__(1,0))
 check('changed_nonnull_projection_variant',lambda c:nonnull(c)[7]['kind']['Assign'][1]['Use'][0]['Move']['kind']['Projection'][1]['Field'][0]['Adt'].__setitem__(1,0))
 check('changed_slice_parts_length',lambda c:nonnull(c)[22]['kind']['Call']['call']['args'][1]['Copy']['kind'].update(Local=23))
 check('unknown_slice_builtin_effect',lambda c:nonnull(c)[22]['kind']['Call'].update(hidden_effect=True))
 check('changed_slice_parts_target',lambda c:nonnull(c)[22]['kind']['Call']['call']['dest']['kind'].update(Local=12))
 check('enabled_nonnull_precondition',lambda c:nonnull(c)[2]['kind']['Switch']['If'][0]['Const']['kind']['Literal'].update(Bool=True))
 check('removed_nonnull_pointer_pattern',lambda c:c['type_decls'][13]['kind']['Struct'][0]['ty']['Untagged']['Pattern'].__setitem__(1,'NonZero'))
 check('changed_slice_pointer_field_offset',lambda c:c['type_decls'][16]['layout'][0]['value']['variant_layouts'][0]['field_offsets'].__setitem__(0,8))
 return records

def main():
 p=argparse.ArgumentParser(description=__doc__);p.add_argument('--build-receipt',type=Path,required=True);a=p.parse_args()
 out=Path(tempfile.mkdtemp(prefix='vec-capacity-arithmetic-',dir=ROOT/'build/hasteboots-extraction'))
 r={'status':'started','commands':[],'isolated_original_arithmetic_assignments_reified':True,'original_checked_multiply_assignment_proved':True,
 'byte_size_one_overflow_flag_false_proved':True,'source_move_consumption_proved':True,'source_layout_prefix_branch_selection_proved':True,'arbitrary_suffix_continuations_preserved':True,'layout_prefix_statement_counts':[28,9],'accepted_layout_statement_count':16,'source_success_aggregates_and_moves_proved':True,'source_zero_size_dispatch_proved':True,'reservation_error_representation_arbitrary':True,'source_zero_size_return_proved':True,'zero_capacity_decoded_root_proved':True,'zero_capacity_source_call_chain':[0,1,2,3],'zero_capacity_external_allocator_assumption':False,'unused_logical_local_and_error_types_arbitrary':True,'unprocessed_source_branches_explicitly_unsupported':True,'positive_size_allocator_dispatch_proved':True,'positive_size_allocator_body_execution_proved':False,'allocation_capable_evaluator_embeds_legacy_exactly':True,'source_allocator_wrappers_forward_all_outcomes':True,'common_runtime_entry_and_size_dispatch_proved':True,'runtime_shim_conditional_allocation_and_pointer_dispatch_proved':True,'runtime_post_dispatch_result_construction_proved':False,'runtime_nonnull_result_construction_proved':True,'runtime_positive_invocation_success_conditional_on_shim_and_allocation':True,'allocator_boundary_model_executes_heap_steps':True,'native_allocator_shim_and_abi_refinement':False,'global_placement_address_explicit':True,'native_stack_placement_refinement':False,'whole_constructor_control_flow_proved':False,
 'allocator_error_and_abort_paths_proved':False,'native_abi_refinement':False,'physical_work_refinement':False,'final_security_theorem':False}
 def save():(out/'manifest.json').write_text(json.dumps(r,indent=2)+'\n')
 def run(cmd,log):
  r['commands'].append([str(x) for x in cmd]);save()
  with (out/log).open('w') as f:result=subprocess.run([str(x) for x in cmd],cwd=ROOT,stdout=f,stderr=subprocess.STDOUT)
  if result.returncode:raise RuntimeError('Command failed: '+log)
 print('Capacity arithmetic artifacts: '+str(out),flush=True)
 try:
  _,tools,_=BUILD['verify_receipt'](a.build_receipt);r['build_receipt_sha256']=digest(a.build_receipt)
  files=[Path(__file__),ROOT/'scripts/check-hasteboots-allocator-caller',ROOT/'scripts/build-hasteboots-inline-tools',ROOT/'scripts/extract-hasteboots-parameters',ROOT/'scripts/specify-hasteboots-deallocation-boundary',ROOT/'lean-toolchain',
   *sorted((ROOT/'scripts').glob('reify-hasteboots-*')),*sorted((ROOT/'FormalProof4FHE/HasteBoots').glob('Native*.lean')),
   ROOT/'FormalProof4FHETest/HasteBootsRecordArithmeticSmoke.lean',ROOT/'FormalProof4FHETest/HasteBootsRecordArithmeticAudit.lean',ROOT/'FormalProof4FHETest/HasteBootsZstBorrowSmoke.lean',ROOT/'FormalProof4FHETest/HasteBootsZstBorrowAudit.lean',ROOT/'FormalProof4FHETest/HasteBootsAllocatorExecutionSmoke.lean',ROOT/'FormalProof4FHETest/HasteBootsAllocatorExecutionAudit.lean',
   *[DATA/n for n in ['fixture.rs','Generated.lean','Retained.json','Proof.lean','LayoutProof.lean','AcceptedProof.lean','ZeroProof.lean','CallerProof.lean','PositiveProof.lean','AllocatorProof.lean','RuntimeProof.lean','SuccessProof.lean','Smoke.lean','LayoutSmoke.lean','AcceptedSmoke.lean','ZeroSmoke.lean','CallerSmoke.lean','PositiveSmoke.lean','AllocatorSmoke.lean','RuntimeSmoke.lean','SuccessSmoke.lean']]]
  r['inputs']={str(f.relative_to(ROOT)):digest(f) for f in files}
  run([ROOT/'scripts/in-container','lake','build','FormalProof4FHE.HasteBoots.NativeRecordCallValues','FormalProof4FHETest.HasteBootsRecordArithmeticSmoke','FormalProof4FHETest.HasteBootsRecordArithmeticAudit','FormalProof4FHETest.HasteBootsZstBorrowSmoke','FormalProof4FHETest.HasteBootsZstBorrowAudit','FormalProof4FHETest.HasteBootsAllocatorExecutionSmoke','FormalProof4FHETest.HasteBootsAllocatorExecutionAudit'],'root-build.log')
  llbc=out/'source.llbc';cmd=[tools/'charon','rustc','--preset=aeneas','--sysroot','default','--monomorphize','--mir','optimized','--consts','values','--evaluate-runtime-checks','--precise-drops','--desugar-drops','--preserve-allocator','--no-dedup-serialized-ast']
  for include in INCLUDES:cmd+=['--include',include]
  cmd+=['--dest-file',llbc,'--','--crate-type','lib','--edition','2024','-Cdebug-assertions=no','--crate-name','hasteboots_vec_capacity_arithmetic',(DATA/'fixture.rs').relative_to(ROOT)]
  run(cmd,'charon.log');ir=json.loads(llbc.read_text());reifier=REIFIER['Reifier'](ir);generated=reifier.render()
  if generated!=(DATA/'Generated.lean').read_text() or reifier.retained()!=json.loads((DATA/'Retained.json').read_text()):raise RuntimeError('Original constructor assignments/declarations differ')
  r['negative_controls']=negatives(ir);names=PARENT['inventory'](include_allocator=True)
  for file in ['Generated.lean','Proof.lean','LayoutProof.lean','AcceptedProof.lean','ZeroProof.lean','CallerProof.lean','PositiveProof.lean','AllocatorProof.lean','RuntimeProof.lean','SuccessProof.lean']:
   raw=(DATA/file).read_text();PARAM['validate_proof_source'](raw,re.findall(r'^theorem (\w+)',raw,re.M))
   names+=['HasteBootsVecCapacityArithmetic.'+n for n in re.findall(r'^(?:def|theorem) (\w+)',raw,re.M)]
  checked=out/'Checked.lean';checked.write_text(generated+'\n'+'\n'.join((DATA/n).read_text() for n in ['Proof.lean','LayoutProof.lean','AcceptedProof.lean','ZeroProof.lean','CallerProof.lean','PositiveProof.lean','AllocatorProof.lean','RuntimeProof.lean','SuccessProof.lean','Smoke.lean','LayoutSmoke.lean','AcceptedSmoke.lean','ZeroSmoke.lean','CallerSmoke.lean','PositiveSmoke.lean','AllocatorSmoke.lean','RuntimeSmoke.lean','SuccessSmoke.lean'])+''.join('\n#print axioms '+n+'\n' for n in names))
  run([ROOT/'scripts/in-container','lake','env','lean','-DwarningAsError=true',checked.relative_to(ROOT)],'lean.log')
  r['dependency_audit']=PARAM['audit_log']((out/'lean.log').read_text(),names)
  if r['inputs']!={str(f.relative_to(ROOT)):digest(f) for f in files}:raise RuntimeError('Inputs changed during validation')
  r['llbc_sha256']=digest(llbc);r['checked_sha256']=digest(checked);r['assignment_count']=len(reifier.rows);r['retained_function_count']=len(reifier.functions)
  BUILD['verify_receipt'](a.build_receipt);r['status']='passed'
  print('Capacity arithmetic passed: '+str(len(names))+' audits; '+str(len(r['negative_controls']))+' rejecting controls')
 except Exception as e:r.update(status='failed',error=str(e));raise SystemExit(str(e)+'; inspect '+str(out)) from e
 finally:r['logs']={f.name:digest(f) for f in out.glob('*.log')};save()
if __name__=='__main__':main()
