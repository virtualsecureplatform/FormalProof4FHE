 def statement(c,fid,sid):
  def walk(node):
   if isinstance(node,dict):
    if node.get('id')==sid and 'kind' in node:return node
    for v in node.values():
     found=walk(v)
     if found is not None:return found
   elif isinstance(node,list):
    for v in node:
     found=walk(v)
     if found is not None:return found
  return walk(c['fun_decls'][fid]['body'])
