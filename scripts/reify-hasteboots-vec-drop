#!/usr/bin/env python3
"""Reify original resident Vec destruction and its unbounded byte-drop loop.
Compiler, native lifetime/ABI, constructors, allocator and work refinement are open.
"""
import argparse
import json
from pathlib import Path
import runpy
ROOT=Path(__file__).resolve().parent.parent
PARENT=runpy.run_path(str(ROOT/'scripts/reify-hasteboots-rawvec-drop'))
LOOP=runpy.run_path(str(ROOT/'scripts/reify-hasteboots-byte-loop-llbc'))
BASE=PARENT['BASE'];SPEC=PARENT['SPEC'];REGIONS=PARENT['REGIONS']
require=SPEC['require'];empty=SPEC['empty'];name=SPEC['name'];seq=BASE['seq']
U8={'Untagged':{'Literal':{'UInt':'U8'}}};SLICE={'Untagged':{'Slice':U8}}

class ByteLoop(LOOP['Reifier']):
    def __init__(self,f):
        self.function=f;regions=f['generics']['regions'];self.free=len(regions)
        require(f['item_meta']['opacity']=='Transparent' and f['is_global_initializer'] is None and
                set(f['body'])=={'Structured'} and all(set(r)=={'index','name','mutability'} and r['index']==i for i,r in enumerate(regions)) and
                empty({**f['generics'],'regions':[]}), 'Unclosed Vec byte loop')
        b=f['body']['Structured'];require(set(b)=={'span','bound_body_regions','locals','body','comments'},'Unknown loop body fields')
        self.bound=b['bound_body_regions'];locals_=b['locals']
        require(type(self.bound) is int and self.bound>=0 and [v['index'] for v in locals_['locals']]==list(range(len(locals_['locals']))),'Wrong loop locals')
        self.types=[LOOP['ty'](v['ty'],self.bound,self.free) for v in locals_['locals']]
        sig=f['signature'];require(set(sig)=={'is_unsafe','abi','is_variadic','inputs','output'} and sig['is_unsafe'] is True and
                sig['abi']=='Rust' and sig['is_variadic'] is False and locals_['arg_count']==1 and
                [LOOP['ty'](t,free=self.free) for t in sig['inputs']]==['sliceRef'] and LOOP['ty'](sig['output'],free=self.free)=='unit' and
                self.types[:2]==['unit','sliceRef'],'Wrong byte-loop signature')
        top=b['body'];require(set(top)=={'span','statements'},'Unknown loop block fields')
        indices=[i for i,s in enumerate(top['statements']) if isinstance(s['kind'],dict) and 'Loop' in s['kind']]
        require(len(indices)==1,'Expected one byte-drop loop');pos=indices[0];statement=top['statements'][pos]
        require(set(statement)=={'span','id','kind','comments_before'} and set(statement['kind'])=={'Loop'},'Unknown loop statement fields')
        self.before={'span':top['span'],'statements':top['statements'][:pos]};self.body=statement['kind']['Loop'];self.after={'span':top['span'],'statements':top['statements'][pos+1:]}
    def render(self):
        raw=super().render().replace('HasteBootsByteLoopBody','HasteBootsVecByteLoop')
        return raw.replace('def f4 :','def f'+str(self.function['def_id'])+' :').replace('#4"','#'+str(self.function['def_id'])+'"')

class Reifier(PARENT['Reifier']):
    def __init__(self,ir):
        self.vector=None;self.vec_glue=None;self.vec_method=None;self.slice_glue=None;self.loop_id=None
        self.composed={};self.composing=set()
        super().__init__(ir)
        def find(items,expected):
            xs=[x for x in items if name(x)==expected];require(len(xs)==1,'Missing/duplicate '+expected);return xs[0]
        self.vector=find(self.types.values(),'alloc::vec::Vec')
        fields=self.vector['kind'].get('Struct',[])
        require(self.vector['item_meta']['opacity']=='Transparent' and empty(self.vector['generics']) and
                [(x['name'],x['ty']) for x in fields]==[('buf',SPEC['adt'](self.rawvec['def_id'])),('len',SPEC['USIZE'])], 'Changed Vec fields')
        require(self.vector['layout']==[{**self.rawvec['layout'][0],'value':{**self.rawvec['layout'][0]['value'],'size':24}}], 'Changed Vec layout')
        self.vec_glue=find(self.functions.values(),'alloc::vec::Vec::drop_glue')['def_id']
        self.vec_method=find(self.functions.values(),'alloc::vec::drop')['def_id']
        self.slice_glue=find(self.functions.values(),'core::ptr::drop_glue')['def_id']
        loops=[f for f in self.functions.values() if isinstance(f['body'],dict) and 'Structured' in f['body'] and
               any(isinstance(s['kind'],dict) and 'Loop' in s['kind'] for s in f['body']['Structured']['body']['statements'])]
        require(len(loops)==1,'Missing/duplicate byte loop');self.loop_id=loops[0]['def_id'];self.loop=ByteLoop(loops[0])
        self.entry=self.vec_glue
        for fid in [self.vec_glue,self.vec_method,self.slice_glue,self.loop_id]:self.schema(fid)

    def ty(self,raw):
        if self.vector:
            u=raw.get('Untagged',{})
            if set(u)=={'Ref'} and u['Ref'][1] in [SPEC['adt'](self.vector['def_id']),SLICE]:
                require(u['Ref'][2]=='Mut','Wrong Vec/slice mutability');return '(.scalar (.reference true))'
            if u=={'RawPtr':[SLICE,'Mut']}:return '(.scalar (.raw true))'
        return super().ty(raw)

    def schema(self,fid):
        if fid in self.schemas:return self.schemas[fid]
        if fid not in [self.vec_glue,self.vec_method,self.slice_glue,self.loop_id]:return super().schema(fid)
        f=self.functions[fid];sig=f['signature'];pointee=SPEC['adt'](self.vector['def_id']) if fid in [self.vec_glue,self.vec_method] else SLICE
        expected={'Untagged':{'Ref':[{'Var':{'Free':0}},pointee,'Mut']}}
        require(sig=={'is_unsafe':fid!=self.vec_method,'abi':'Rust','is_variadic':False,'inputs':[expected],'output':SPEC['UNIT']} and
                f['is_global_initializer'] is None,'Changed Vec drop signature')
        require(f['item_meta']['opacity']==('Foreign' if fid==self.slice_glue else 'Transparent') and set(f['body'])=={'Structured'} and
                f['generics']['regions']==[{'index':0,'name':None,'mutability':'Unknown'}] and empty({**f['generics'],'regions':[]}), 'Unclosed Vec drop body')
        b=f['body']['Structured'];require(set(b)=={'span','bound_body_regions','locals','body','comments'},'Unknown Vec body fields')
        bound=b['bound_body_regions'];require(type(bound) is int and bound>=0,'Wrong Vec bound regions')
        for raw in sig['inputs']+[sig['output']]:PARENT['PARENT']['validate_regions'](raw,None,1)
        if fid==self.loop_id:
            self.schemas[fid]=[SPEC['UNIT'],expected],1;return self.schemas[fid]
        locals_=b['locals']['locals'];types=[v['ty'] for v in locals_]
        require([v['index'] for v in locals_]==list(range(len(locals_))) and b['locals']['arg_count']==1 and
                REGIONS['erase_regions'](types[:2])==REGIONS['erase_regions']([sig['output']]+sig['inputs']),'Wrong Vec locals/signature')
        for raw in types:PARENT['PARENT']['validate_regions'](raw,bound,1);self.ty(raw)
        self.schemas[fid]=types,1;return types,1

    def operand(self,op,fid):
        if set(op)=={'Const'}:
            literal=op['Const'];require(set(literal)=={'kind','ty'} and literal['ty']==SPEC['USIZE'],'Wrong Vec usize literal')
            kind=literal['kind'];number=kind.get('Literal',{}).get('Scalar',{}).get('Unsigned',[None,None])[1]
            require(kind=={'Literal':{'Scalar':{'Unsigned':['Usize',number]}}} and isinstance(number,str) and
                    str(int(number))==number and 0<=int(number)<2**64,'Noncanonical Vec usize literal')
            return '(.usize '+BASE['word'](int(number))+')',SPEC['USIZE']
        return super().operand(op,fid)

    def resident(self,place,fid):
        path=[];p=place
        while set(p.get('kind',{}))=={'Projection'}:
            require(set(p)=={'kind','ty'},'Unknown resident Vec place fields');base,projection=p['kind']['Projection']
            if projection=='Deref':
                require(p['ty']==SPEC['adt'](self.vector['def_id']),'Wrong Vec resident dereference')
                index,local_path,raw=self.place(base,fid)
                require(not local_path and raw['Untagged']['Ref'][1:]==[p['ty'],'Mut'],'Wrong resident Vec parent')
                return index,list(reversed(path))
            require(set(projection)=={'Field'},'Unknown Vec resident projection');owner,index=projection['Field'];tid,variant=owner['Adt']
            require(owner=={'Adt':[tid,None]} and variant is None and base['ty']==SPEC['adt'](tid),'Wrong Vec field owner')
            fields=self.types[tid]['kind']['Struct'];require(type(index) is int and 0<=index<len(fields) and p['ty']==fields[index]['ty'],'Wrong Vec field type/index')
            path.append((tid,index));p=base
        raise ValueError('Missing Vec resident dereference')

    def rvalue(self,rv,fid):
        if fid==self.vec_method and set(rv)=={'Use'}:
            op,flag=rv['Use']
            if set(op)=={'Copy'} and self.is_heap_place(op['Copy']):
                require(flag=='Yes','Unsupported Vec read retag flag');index,path=self.resident(op['Copy'],fid)
                if path==[(self.vector['def_id'],1)]:return '(.vec (.field .length) '+str(index)+' [])',SPEC['USIZE']
                require(path==[(self.vector['def_id'],0),(self.rawvec['def_id'],0),(self.storage.inner['def_id'],0),(self.storage.unique['def_id'],0)],'Wrong Vec data pointer path')
                tag=self.storage.nonnull['def_id'];return '(.recordResult '+str(tag)+' true (.vec (.field .pointer) '+str(index)+' []))',SPEC['adt'](tag)
        if fid==self.vec_method and set(rv)=={'UnaryOp'}:
            operator,op=rv['UnaryOp'];value,raw=self.operand(op,fid);target={'Untagged':{'RawPtr':[U8,'Mut']}}
            require(operator=={'Cast':{'Transmute':[SPEC['adt'](self.storage.nonnull['def_id']),target]}} and raw==SPEC['adt'](self.storage.nonnull['def_id']),'Wrong Vec pointer cast')
            kind=next(iter(op));index,path,_=self.place(op[kind],fid)
            return '(.rawCast (.'+kind.lower()+' '+str(index)+' '+seq(path+['(.unwrap '+str(self.storage.nonnull['def_id'])+')','.left'])+'))',target
        return super().rvalue(rv,fid)

    def assignment(self,target,rv,fid,following):
        if fid in [self.vec_glue,self.vec_method,self.slice_glue] and set(rv)=={'Ref'}:
            index,path,raw=self.place(target,fid);ref=rv['Ref']
            require(not path and set(ref)=={'place','kind','ptr_metadata'} and ref['kind']=='Mut','Wrong Vec/slice borrow kind')
            p=ref['place'];require(raw['Untagged']['Ref'][1:]==[p['ty'],'Mut'],'Wrong Vec/slice borrow target')
            if p['ty']==SLICE:
                require(set(p)=={'kind','ty'} and set(p['kind'])=={'Projection'} and p['kind']['Projection'][1]=='Deref','Missing slice dereference')
                base=p['kind']['Projection'][0];parent,parent_path,parent_ty=self.place(base,fid)
                require(not parent_path and parent_ty['Untagged'] in [{'RawPtr':[SLICE,'Mut']},{'Ref':[parent_ty['Untagged'].get('Ref',[None])[0],SLICE,'Mut']}] and
                        ref['ptr_metadata']=={'Copy':{'kind':{'Projection':[base,'PtrMetadata']},'ty':SPEC['USIZE']}},'Wrong slice borrow metadata/parent')
                return '(.assign '+str(index)+' (.borrowSlice '+str(parent)+' []) '+following+')'
            require(fid==self.vec_glue and ref['ptr_metadata']=={'Const':{'kind':{'Adt':[None,[]]},'ty':SPEC['UNIT']}},'Wrong Vec borrow metadata')
            parent,path=self.resident(p,fid)
            require(path in [[],[(self.vector['def_id'],0)]],'Wrong Vec mutable subobject')
            target_kind='whole' if not path else 'rawVec'
            return '(.assign '+str(index)+' (.vec (.borrow .'+target_kind+') '+str(parent)+' []) '+following+')'
        return super().assignment(target,rv,fid,following)

    def composed_block(self,b,fid):
        require(set(b)=={'span','statements'},'Unknown Vec composition block');statements=b['statements']
        for s in statements:require(set(s)=={'span','id','kind','comments_before'},'Unknown Vec composition statement')
        for pos,s in enumerate(statements):
            if not isinstance(s['kind'],dict) or set(s['kind'])!={'Call'}:continue
            info=s['kind']['Call'];require(set(info)=={'call','on_unwind'},'Unknown Vec call fields');call=info['call']
            require(set(call)=={'func','args','dest'} and set(call['func'])=={'Regular'},'Unknown Vec call form');fun=call['func']['Regular']
            require(set(fun)=={'kind','generics'} and set(fun['kind'])=={'Fun'},'Unknown Vec callee form')
            following=self.composed_block({'span':b['span'],'statements':statements[pos+1:]},fid)
            target=fun['kind']['Fun'];index,path,raw=self.place(call['dest'],fid);args=[self.operand(a,fid) for a in call['args']]
            if set(target)=={'Builtin'}:
                require(target=={'Builtin':{'PtrFromParts':'Mut'}} and fun['generics']=={'regions':['Erased'],'types':[SLICE],'const_generics':[],'trait_refs':[]} and
                        not path and raw=={'Untagged':{'RawPtr':[SLICE,'Mut']}} and [a[1] for a in args]==[{'Untagged':{'RawPtr':[U8,'Mut']}},SPEC['USIZE']],'Wrong Vec parts intrinsic')
                intrinsic='(.assign '+str(index)+' (.parts '+args[0][0]+' '+args[1][0]+') .done)'
                # The closed intrinsic cannot unwind in this logical model. Retain
                # its checked, original UB edge as source metadata.
                require([s['kind'] for s in info['on_unwind']['statements']]==[{'Abort':'UndefinedBehavior'}] and
                        all(set(s)=={'span','id','kind','comments_before'} for s in info['on_unwind']['statements']),'Wrong intrinsic unwind')
                result='(.native '+intrinsic+' .done)'
            else:
                require(set(target)=={'Regular'},'Unknown Vec call target');callee=target['Regular'];types,count=self.schema(callee);g=fun['generics']
                require(empty({**g,'regions':[]}) and len(g['regions'])==len(self.functions[callee]['generics']['regions']) and
                        all(REGIONS['region_valid'](r,self.functions[fid]['body']['Structured']['bound_body_regions'],1) for r in g['regions']),'Wrong Vec call regions')
                require(not path and REGIONS['erase_regions'](raw)==REGIONS['erase_regions'](types[0]) and
                        REGIONS['erase_regions']([a[1] for a in args])==REGIONS['erase_regions'](types[1:count+1]),'Wrong Vec call types')
                result='(.call '+json.dumps(name(self.functions[callee]))+' '+self.classification(callee)+' '+seq([self.ty(t) for t in types])+' '+str(count)+' '+str(index)+' '+seq([a[0] for a in args])+' '+self.composed_code(callee)+' '+self.composed_block(info['on_unwind'],fid)+' .done)'
            if pos:result='(.native '+self.block({'span':b['span'],'statements':statements[:pos]},fid)+' '+result+')'
            return '(.scope '+result+' '+following+')'
        # UnwindTerminate aborts are retained as rejection by the closed model.
        adapted=[]
        for s in statements:
            if s['kind']=={'Abort':'UnwindTerminate'}:s={**s,'kind':{'Abort':'UndefinedBehavior'}}
            adapted.append(s)
        return '(.native '+self.block({'span':b['span'],'statements':adapted},fid)+' .done)'

    def composed_code(self,fid):
        if fid in self.composed:return self.composed[fid]
        require(fid not in self.composing,'Recursive Vec composition');self.composing.add(fid)
        if fid==self.loop_id:result='(.loop '+self.classification(fid)+' HasteBootsVecByteLoop.f'+str(fid)+')'
        elif fid in [self.vec_glue,self.vec_method,self.slice_glue]:result=self.composed_block(self.functions[fid]['body']['Structured']['body'],fid)
        else:result='(.native '+self.code(fid)+' .done)'
        self.composing.remove(fid);self.composed[fid]=result;return result

    def render(self):
        self.composed_code(self.entry)
        # Existing finite function declarations keep their exact bodies.
        finite=super().render()
        loop_raw=self.loop.render();loop_raw=loop_raw[loop_raw.index('namespace HasteBootsVecByteLoop'):]
        lines=[finite,loop_raw,'namespace HasteBootsVecDrop','open FormalProof4FHE.HasteBoots.NativeRecordDropCalls','def alignmentDiscriminants := HasteBootsRawVecDrop.alignmentDiscriminants']
        for fid in sorted(self.composed):
            types,count=self.schema(fid)
            lines+=['-- Original declaration SHA256 '+SPEC['digest'](self.functions[fid]),'def f'+str(fid)+' : Definition :=',
                    '  ⟨'+json.dumps(name(self.functions[fid]))+', '+self.classification(fid)+', '+seq([self.ty(t) for t in types])+', '+str(count)+', '+self.composed_code(fid)+'⟩']
        # Each composed callee is embedded, so declarations are audit handles.
        return '\n'.join(lines+['end HasteBootsVecDrop','']).replace('public import FormalProof4FHE.HasteBoots.NativeRecordLLBC','public import FormalProof4FHE.HasteBoots.NativeRecordHeapBounds\npublic import FormalProof4FHE.HasteBoots.NativeResidentVecBorrow\npublic import FormalProof4FHE.HasteBoots.NativeRecordCallValues\npublic import FormalProof4FHE.HasteBoots.NativeRecordIncomingReference\npublic import FormalProof4FHE.HasteBoots.NativeBorrowFrontier\npublic import FormalProof4FHE.HasteBoots.NativeByteTraversalCompleteness\npublic import FormalProof4FHE.HasteBoots.NativeVecBytePrefix\npublic import FormalProof4FHE.HasteBoots.NativeRawVecBorrowCompleteness\npublic import FormalProof4FHE.HasteBoots.NativeRawVecSharedCompleteness\npublic import FormalProof4FHE.HasteBoots.NativeRawVecDeallocationCompleteness\npublic import FormalProof4FHE.HasteBoots.NativeVecDestructionCompleteness\npublic import FormalProof4FHE.HasteBoots.NativeEmptyVecStorage\npublic import FormalProof4FHE.HasteBoots.NativeReservedVecConstruction')

    def retained(self):
        value=super().retained();value['vec_entry']=self.entry;value['composed_functions']=[self.functions[i] for i in sorted(self.composed)]
        value['claim']='original resident Vec destruction with unbounded byte-loop relation and explicit scope cleanup; native constructor/ABI/compiler/lifetime/allocator/work/security refinement unproved'
        return value

def main():
    p=argparse.ArgumentParser(description=__doc__);p.add_argument('llbc',type=Path);p.add_argument('output',type=Path);p.add_argument('--retained',type=Path,required=True)
    args=p.parse_args();r=Reifier(json.loads(args.llbc.read_text()));args.output.write_text(r.render());args.retained.write_text(json.dumps(r.retained(),indent=2)+'\n')
if __name__=='__main__':main()
