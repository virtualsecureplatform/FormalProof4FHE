  self.prefix=self.code(ss,'next')
 def rvalue(self,statement,rv,output):
  if set(rv)=={'Aggregate'}:
   kind,args=rv['Aggregate'];require(set(kind)=={'Adt'},'Changed rejected layout aggregate');owner,variant,union=kind['Adt'];tag=owner['id']['Adt']
   expected={20:(None,[]),19:(1,[{'Move':{'kind':{'Local':47},'ty':adt(20)}}]),18:(0,[]),9:(None,[{'Move':{'kind':{'Local':49},'ty':adt(18)}}]),8:(1,[{'Move':{'kind':{'Local':50},'ty':adt(9)}}])}
   require(tag in expected and owner==adt(tag)['Untagged']['Adt'] and output==adt(tag) and union is None and (variant,args)==expected[tag],'Changed rejected layout fields, variants or operand modes')
   return '(.aggregate (some '+str(tag)+') '+('none' if variant is None else '(some '+str(bool(variant)).lower()+')')+' ['+', '.join(self.operand(a) for a in args)+'])'
  return super().rvalue(statement,rv,output)
 def render(self):
  slots='base.slots'
