   require(set(call)=={'call','on_unwind'} and call['call']=={'func':{'Regular':{'kind':{'Fun':{'Regular':target}},'generics':{'regions':[{'Body':12+2*mode}],'types':[],'const_generics':[],'trait_refs':[]}}},'args':[{'Move':{'kind':{'Local':local},'ty':ref}},{'Copy':{'kind':{'Local':6},'ty':adt(4)}}],'dest':{'kind':{'Local':10},'ty':adt(15)}},'Changed allocation-method arguments')
   callee=parent.functions[target];require(name(callee)==['alloc::alloc::allocate','alloc::alloc::allocate_zeroed'][mode] and callee['item_meta']['opacity']=='Transparent' and callee['signature']=={'is_unsafe':False,'abi':'Rust','is_variadic':False,'inputs':[{'Untagged':{'Ref':[{'Var':{'Free':0}},adt(1),'Shared']}},adt(4)],'output':adt(15)},'Changed allocation-method owner/signature')
   self.arms.append(statements)
