class AllocatorMethods:
 def __init__(self,parent):
  self.parent=parent;impl=parent.functions[13]
  require(name(impl)=='alloc::alloc::alloc_impl_runtime' and impl['item_meta']['opacity']=='Transparent' and impl['signature']=={'is_unsafe':False,'abi':'Rust','is_variadic':False,'inputs':[adt(4),BOOL],'output':adt(15)},'Changed allocation implementation')
  self.method_calls=[]
  for mode,fid in enumerate([7,8]):
