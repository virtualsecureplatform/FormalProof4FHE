#!/usr/bin/env python3
"""Retain actual Vec::with_capacity arithmetic assignments, without claiming whole-function execution."""
import argparse
import json
from pathlib import Path
import runpy
ROOT=Path(__file__).resolve().parent.parent
SPEC=runpy.run_path(str(ROOT/'scripts/specify-hasteboots-deallocation-boundary'))
require=SPEC['require'];name=SPEC['name'];empty=SPEC['empty'];adt=SPEC['adt'];digest=SPEC['digest']
def literal(t):return {'Untagged':{'Literal':t}}
USIZE=literal({'UInt':'Usize'});U64=literal({'UInt':'U64'});BOOL=literal('Bool');ISIZE=literal({'Int':'Isize'});I32=literal({'Int':'I32'})
TUPLE={'Untagged':{'Adt':{'id':'Tuple','generics':{'regions':[],'types':[U64,BOOL],'const_generics':[],'trait_refs':[]}}}}
OPS={json.dumps(k,sort_keys=True):(label,owner,types,modes,output) for k,label,owner,types,modes,output in [
 ({'Sub':'Wrap'},'wrappingSubtract','alloc::raw_vec::with_capacity_in',[USIZE,USIZE],['Copy','Const'],USIZE),
 ('Gt','greater','alloc::raw_vec::with_capacity_in',[USIZE,USIZE],['Copy','Move'],BOOL),
 ('Not','logicalNot','alloc::raw_vec::with_capacity_in',[BOOL],['Move'],BOOL),
 ('MulChecked','checkedMultiply','alloc::raw_vec::try_allocate_in',[U64,U64],['Move','Move'],TUPLE),
 ({'Sub':'UB'},'uncheckedSubtract','alloc::raw_vec::try_allocate_in',[USIZE,USIZE],['Const','Move'],USIZE),
 ('Le','lessEqual','alloc::raw_vec::try_allocate_in',[USIZE,USIZE],['Copy','Move'],BOOL),
 ('Eq','equal','alloc::alloc::alloc_impl_runtime',[ISIZE,ISIZE],['Copy','Const'],BOOL),
 ({'Shl':'Wrap'},'wrappingShiftLeft','core::ptr::non_null::new_unchecked::precondition_check',[USIZE,I32],['Move','Const'],USIZE),
 ('BitOr','bitOr','core::ptr::non_null::new_unchecked::precondition_check',[USIZE,USIZE],['Move','Const'],USIZE)]}
LITERALS={'wrappingSubtract':('Unsigned','Usize','0'),'uncheckedSubtract':('Unsigned','Usize',str(2**63)),
 'equal':('Signed','Isize','1'),'wrappingShiftLeft':('Signed','I32','1'),'bitOr':('Unsigned','Usize','1')}
class Reifier:
 def __init__(self,ir):
  require(ir['charon_version']=='0.1.226' and ir['has_errors'] is False,'Wrong schema/compiler errors')
  self.crate=c=ir['translated'];o=c['options']
  require(o['monomorphize'] and o['mir']=='Optimized' and o['sysroot']=='default' and o['consts']=='Values','Wrong extraction profile')
  for k in ['evaluate_runtime_checks','precise_drops','desugar_drops','preserve_allocator','no_dedup_serialized_ast']:require(o[k] is True,'Missing policy: '+k)
  require(not o['opaque'] and not o['exclude'] and not o['inline_functions'],'Hidden/rewritten source')
  require(c['target_information']==[{'key':'x86_64-unknown-linux-gnu','value':{'target_pointer_size':8,'is_little_endian':True}}],'Wrong target')
  self.functions={f['def_id']:f for f in c['fun_decls'] if f};self.rows=[]
  roots=[f for f in self.functions.values() if name(f)=='hasteboots_vec_capacity_arithmetic::capacity'];require(len(roots)==1,'Missing/duplicate source root')
  root=roots[0];require(root['signature']=={'is_unsafe':False,'abi':'Rust','is_variadic':False,'inputs':[USIZE],'output':adt(0)} and root['item_meta']['opacity']=='Transparent','Changed root signature')
  for f in self.functions.values():
   if isinstance(f['body'],dict) and 'Structured' in f['body']:
    b=f['body']['Structured'];locals=b['locals']['locals'];require([l['index'] for l in locals]==list(range(len(locals))),'Noncanonical source locals')
    self.walk(f,b['body'])
  require(len(self.rows)==9 and {r['operation'] for r in self.rows}=={v[0] for v in OPS.values()},'Changed arithmetic inventory')
  self.layout_prefix=LayoutPrefix(self)
 def walk(self,f,node):
  if isinstance(node,dict):
   if 'statements' in node:
    for s in node['statements']:
     require(set(s)=={'span','id','kind','comments_before'},'Unknown statement metadata')
     k=s['kind']
     if isinstance(k,dict) and 'Assign' in k:
      dest,rv=k['Assign'];operation=None
      if 'BinaryOp' in rv:operation,*args=rv['BinaryOp'];require(set(rv)=={'BinaryOp'},'Unknown binary rvalue metadata')
      elif 'UnaryOp' in rv and rv['UnaryOp'][0]=='Not':operation,args0=rv['UnaryOp'];args=[args0];require(set(rv)=={'UnaryOp'},'Unknown unary rvalue metadata')
      if operation is not None:self.assignment(f,s,dest,operation,args)
   for k,v in node.items():
    if k!='statements':self.walk(f,v)
   if 'statements' in node:
    for s in node['statements']:self.walk(f,s['kind'])
  elif isinstance(node,list):
   for item in node:self.walk(f,item)
 def assignment(self,f,statement,dest,operation,args):
  key=json.dumps(operation,sort_keys=True);require(key in OPS,'Unsupported arithmetic operator')
  label,owner,types,modes,output=OPS[key];require(name(f)==owner,'Changed arithmetic owner')
  require(f['item_meta']['opacity']=='Transparent' and f['signature']['abi']=='Rust' and empty(f['generics']),'Unclosed arithmetic owner')
  require(len(args)==len(types) and [list(a) for a in args]==[[m] for m in modes],'Changed arithmetic operand modes/arity')
  locals=f['body']['Structured']['locals']['locals']
  require(set(dest)=={'kind','ty'} and set(dest['kind'])=={'Local'} and dest['ty']==output and locals[dest['kind']['Local']]['ty']==output,'Changed arithmetic destination')
  rendered=[];inputs=[]
  for arg,ty,mode in zip(args,types,modes):
   value=arg[mode];require(value['ty']==ty,'Changed arithmetic operand width/type')
   if mode=='Const':
    sign,width,n=LITERALS[label];require(value=={'kind':{'Literal':{'Scalar':{sign:[width,n]}}},'ty':ty},'Changed arithmetic literal')
    rendered.append('(.usize '+n+')')
   else:
    require(set(value)=={'kind','ty'} and set(value['kind'])=={'Local'},'Unsupported arithmetic operand place')
    index=value['kind']['Local'];require(locals[index]['ty']==ty,'Changed arithmetic local type')
    rendered.append('(.'+mode.lower()+' '+str(index)+' [])');inputs.append(index)
  self.rows.append({'function':f['def_id'],'owner':name(f),'statement':statement,'destination':dest['kind']['Local'],
    'operation':label,'operands':args,'inputs':inputs,'rendered':rendered})
 def retained(self):
  return {'functions':[self.functions[k] for k in sorted(self.functions)],'types':self.crate['type_decls'],
   'globals':self.crate['global_decls'],'target':self.crate['target_information'],
   'layout_prefix':self.layout_prefix.retained(),
   'assignments':[{k:v for k,v in r.items() if k!='rendered'} for r in self.rows],
   'claim':'original scalar assignments and contiguous layout prefix with arbitrary continuations; whole constructor, calls, error suffixes, ABI and physical work remain open'}
 def render(self):
  lines=['module','public import FormalProof4FHE.HasteBoots.NativeRecordCallValues','@[expose] public section',
   'namespace HasteBootsVecCapacityArithmetic','open FormalProof4FHE.HasteBoots','open NativeRecordLLBC']
  for r in self.rows:
   lines+=['-- Original assignment SHA256 '+digest(r['statement']),
    'def expr_'+r['operation']+' : Rvalue := .arithmetic .'+r['operation']+' ['+', '.join(r['rendered'])+']',
    'def step_'+r['operation']+' : Body := .assign '+str(r['destination'])+' expr_'+r['operation']+' .done']
  row=next(r for r in self.rows if r['operation']=='checkedMultiply');left,right=row['inputs'];dest=row['destination']
  require(len({left,right,dest})==3,'Aliased checked multiplication locals')
  lines+=['def checkedLeft : Nat := '+str(left),'def checkedRight : Nat := '+str(right),'def checkedDestination : Nat := '+str(dest)]
  count=max(left,right,dest)+1
  # These contexts cover the isolated original assignment, with all unused locals dead.
  for after in [False,True]:
   label='checkedAfter' if after else 'checkedFrame'
   types=[];slots=[]
   for i in range(count):
    types.append('(.pair (.scalar .usize) (.pair .boolean (.scalar .unit)))' if i==dest else '(.scalar .usize)' if i in [left,right] else '(.scalar .unit)')
    if i==dest:
     value='(.pair (.scalar (.usize (NativeRecordArithmetic.word (left.val*right.val)))) (.pair (.boolean (decide (2^64 ≤ left.val*right.val))) (.scalar .unit)))'
     slots.append('(.live (some '+value+'))' if after else '(.live none)')
    elif i in [left,right]:slots.append('(.live (some .uninit))' if after else '(.live (some (.scalar (.usize '+('left' if i==left else 'right')+'))))')
    else:slots.append('.dead')
   lines+=['def '+label+' (world : NativeReferenceMachine.State) (left right : NativeWord64Memory.Word) : Frame :=',
    '  ⟨['+', '.join(types)+'], ['+', '.join(slots)+'], world⟩']
  lines+=[self.layout_prefix.render(),'end HasteBootsVecCapacityArithmetic',''];return '\n'.join(lines)

class LayoutPrefix:
 def __init__(self,parent):
  self.parent=parent;c=parent.crate;self.types={t['def_id']:t for t in c['type_decls'] if t}
  matches=[f for f in parent.functions.values() if name(f)=='alloc::raw_vec::try_allocate_in'];require(len(matches)==1,'Missing layout-check owner');self.function=matches[0]
  self.locals=self.function['body']['Structured']['locals']['locals'];self.count=len(self.locals)
  body=self.function['body']['Structured']['body']['statements']
  outer=[(i,s) for i,s in enumerate(body) if isinstance(s['kind'],dict) and 'Switch' in s['kind']]
  require(len(outer)==1 and set(outer[0][1]['kind']['Switch'])=={'If'},'Changed overflow branch structure')
  pos,self.outer=outer[0];self.initial=body[:pos];self.following=body[pos+1:]
  condition,self.overflow,otherwise=self.outer['kind']['Switch']['If']
  require(condition=={'Copy':{'kind':{'Local':24},'ty':BOOL}},'Changed overflow condition')
  nested=[(i,s) for i,s in enumerate(otherwise['statements']) if isinstance(s['kind'],dict) and 'Switch' in s['kind']]
  require(len(nested)==1 and set(nested[0][1]['kind']['Switch'])=={'If'} and nested[0][0]==len(otherwise['statements'])-1,'Changed layout branch structure')
  pos,self.inner=nested[0];self.check=otherwise['statements'][:pos]
  condition,self.accepted,self.rejected=self.inner['kind']['Switch']['If']
  require(condition=={'Move':{'kind':{'Local':30},'ty':BOOL}},'Changed layout condition move')
  require(self.accepted['statements'][0]['kind']=={'StorageLive':31} and self.rejected['statements'][0]['kind']=={'StorageLive':47},'Changed layout suffix roles')
  self.layout=self.types[4];self.alignment=self.types[11];self.enum=self.types[12]
  require(name(self.layout)=='core::alloc::layout::Layout' and self.layout['item_meta']['opacity']=='Transparent' and
   [(f['name'],f['ty']) for f in self.layout['kind']['Struct']]==[('size',USIZE),('align',adt(11))],'Changed layout fields')
  require(name(self.alignment)=='core::mem::alignment::Alignment' and self.alignment['item_meta']['opacity']=='Transparent' and
   [(f['name'],f['ty']) for f in self.alignment['kind']['Struct']]==[('_inner_repr_trick',adt(12))],'Changed alignment wrapper')
  require(name(self.enum)=='core::mem::alignment::AlignmentEnum' and self.enum['item_meta']['opacity']=='Transparent','Changed alignment enum owner')
  variants=self.enum['kind']['Enum'];require(len(variants)==64 and all(v['id']==i and v['fields']==[] and v['name']=='_Align1Shl'+str(i) and
   v['discriminant']=={'Scalar':{'Unsigned':['Usize',str(2**i)]}} for i,v in enumerate(variants)),'Changed alignment discriminants')
  layout=runpy.run_path(str(ROOT/'scripts/reify-hasteboots-rawvec-fields'))['layout']
  require(self.layout['layout']==layout(16,8,[8,0]) and self.alignment['layout']==layout(8,8,[0],True),'Changed physical layout/alignment wrapper')
  enum_layout=[{'key':'x86_64-unknown-linux-gnu','value':{'size':8,'align':8,'uninhabited':False,
   'repr':{'repr_algo':'Rust','align_modif':None,'transparent':False,'explicit_discr_type':True},
   'variant_layouts':[{'field_offsets':[],'uninhabited':False,'tagger':[[0,{'Unsigned':['U64',str(2**i)]}]]} for i in range(64)],
   'discriminator':{'Branch':{'offset':0,'int_ty':{'Unsigned':'U64'},'fallback':'Invalid',
    'children':[[{'start':{'Unsigned':['U64',str(2**i)]},'end':{'Unsigned':['U64',str(2**i)]}},{'Known':i}] for i in range(64)]}}}}]
  require(self.enum['layout']==enum_layout,'Changed physical alignment tags')
  gs=[g for g in c['global_decls'] if g and name(g)=='core::mem::SizedTypeProperties::LAYOUT'];require(len(gs)==1,'Missing byte layout global');self.global_layout=gs[0]
  expected={'kind':{'Adt':[None,[{'kind':{'Literal':{'Scalar':{'Unsigned':['Usize','1']}}},'ty':USIZE},
    {'kind':{'Adt':[None,[{'kind':{'Adt':[0,[]]},'ty':adt(12)}]]},'ty':adt(11)}]]},'ty':adt(4)}
  require(self.global_layout['ty']==adt(4) and self.global_layout['value']==expected and
   self.global_layout['src']['TraitDecl']['trait_ref']['generics']=={'regions':[],'types':[literal({'UInt':'U8'})],'const_generics':[],'trait_refs':[]},'Changed evaluated byte layout')
  accepted=self.accepted['statements'];require(len(accepted)==17,'Changed accepted prefix extent')
  self.accepted_prefix=accepted[:-1]
  require(set(accepted[-1]['kind'])=={'Switch'} and set(accepted[-1]['kind']['Switch'])=={'SwitchInt'},'Changed size dispatch')
  test,width,cases,otherwise=accepted[-1]['kind']['Switch']['SwitchInt']
  require(test=={'Copy':{'kind':{'Local':7},'ty':USIZE}} and width=={'UInt':'Usize'} and len(cases)==1 and cases[0][0]==[{'Scalar':{'Unsigned':['Usize','0']}}] and otherwise is not None,'Changed zero-size dispatch')
  self.zero_size=cases[0][1];self.positive_size=otherwise
  require(self.zero_size['statements'][0]['kind']=={'StorageDead':7} and self.positive_size['statements'][0]['kind']=={'StorageDead':7},'Changed size dispatch arms')
  for tag,error in [(14,9),(19,20)]:
   t=self.types[tag];require(name(t)=='core::result::Result' and t['item_meta']['opacity']=='Foreign','Changed Result owner')
   vs=t['kind']['Enum'];require([(v['id'],v['name'],[f['ty'] for f in v['fields']],v['discriminant']) for v in vs]==[(0,'Ok',[adt(4)],{'Scalar':{'Signed':['Isize','0']}}),(1,'Err',[adt(error)],{'Scalar':{'Signed':['Isize','1']}})],'Changed Result variants')
  require(name(self.types[20])=='core::alloc::layout::LayoutError' and self.types[20]['kind']=={'Struct':[]},'Changed LayoutError')
  expected_fields={1:[],5:[],6:[('pointer',adt(13)),('_marker',adt(5))],3:[('ptr',adt(6)),('cap',adt(7)),('alloc',adt(1))]}
  for tag,fs in expected_fields.items():
   require([(f['name'],f['ty']) for f in self.types[tag]['kind']['Struct']]==fs,'Changed zero-return fields')
  rawptr={'Untagged':{'RawPtr':[literal({'UInt':'U8'}),'Shared']}}
  require(name(self.types[13])=='core::ptr::non_null::NonNull' and [(f['name'],f['ty']) for f in self.types[13]['kind']['Struct']]==[('pointer',{'Untagged':{'Pattern':[rawptr,'NotNull']}})],'Changed NonNull representation')
  require(name(self.types[7])=='core::num::niche_types::UsizeNoHighBit' and self.types[7]['kind']=='Opaque','Changed bounded capacity owner')
  for tag,size,align,offsets,transparent in [(1,0,1,[],False),(5,0,1,[],False),(3,16,8,[8,0,16],False),(6,8,8,[0,8],True),(7,8,8,[0],True),(13,8,8,[0],True)]:
   require(self.types[tag]['layout']==layout(size,align,offsets,transparent),'Changed zero-return physical layout')
  variants=self.types[8]['kind']['Enum']
  require(name(self.types[8])=='core::result::Result' and [(v['id'],v['name'],[f['ty'] for f in v['fields']],v['discriminant']) for v in variants]==[(0,'Ok',[adt(3)],{'Scalar':{'Signed':['Isize','0']}}),(1,'Err',[adt(9)],{'Scalar':{'Signed':['Isize','1']}})],'Changed RawVec Result')
  zs=self.zero_size['statements'];require(zs[-1]['kind']=='Return','Missing zero-size return')
  self.zero_code=self.code(zs[:-1],'.ret')
  self.accepted_code=self.code(self.accepted_prefix,'next')
  self.initial_code=self.code(self.initial,'next');self.check_code=self.code(self.check,'next')
  require(len(self.initial)==28 and len(self.check)==9,'Changed layout prefix extent')
 def operand(self,arg):
  require(len(arg)==1,'Unknown prefix operand');mode=next(iter(arg));v=arg[mode]
  if mode=='Const':
   pattern={'Untagged':{'Pattern':[USIZE,{'Range':[{'kind':{'Literal':{'Scalar':{'Unsigned':['Usize','0']}}},'ty':USIZE},{'kind':{'Literal':{'Scalar':{'Unsigned':['Usize','9223372036854775807']}}},'ty':USIZE}]}]}}
   if v=={'kind':{'Literal':{'Scalar':{'Unsigned':['Usize','0']}}},'ty':pattern}:return '(.usize 0)'
   require(v=={'kind':{'Literal':{'Bool':True}},'ty':BOOL},'Changed prefix Boolean literal');return '(.boolean true)'
  require(mode in ['Copy','Move'],'Unsupported prefix operand mode')
  def place(p):
   k=p['kind'];ty=p['ty'];require(set(p)=={'kind','ty'} and len(k)==1,'Unknown prefix place')
   if 'Local' in k:
    idx=k['Local'];require(self.locals[idx]['ty']==ty,'Prefix local type mismatch');return idx,[],ty
   require(set(k)=={'Projection'},'Unsupported prefix place');base,step=k['Projection'];idx,path,raw=place(base)
   require(set(step)=={'Field'},'Unsupported prefix projection');owner,index=step['Field']
   if owner=={'Tuple':2}:
    require(raw==TUPLE and index in [0,1] and ty==[U64,BOOL][index],'Changed checked result projection')
    return idx,path+(['.left'] if index==0 else ['.right','.left']),ty
   if owner in [{'Adt':[14,0]},{'Adt':[19,0]}]:
    tag=owner['Adt'][0];require(raw==adt(tag) and index==0 and ty==adt(4),'Changed Result success projection')
    return idx,path+['(.unwrap '+str(tag)+')','(.active false)','.left'],ty
   require(owner=={'Adt':[4,None]} and raw==adt(4) and index in [0,1] and ty==[USIZE,adt(11)][index],'Changed layout field projection')
   return idx,path+['(.unwrap 4)']+(['.left'] if index==0 else ['.right','.left']),ty
  idx,path,_=place(v);return '(.'+mode.lower()+' '+str(idx)+' ['+', '.join(path)+'])'
 def rvalue(self,statement,rv,output):
  if set(rv)=={'Use'}:
   arg,retag=rv['Use'];require(retag=='Yes','Changed prefix retag');require(next(iter(arg.values()))['ty']==output,'Changed prefix use type');return '(.use '+self.operand(arg)+' true .byte)'
  if set(rv)=={'Aggregate'}:
   kind,args=rv['Aggregate'];require(set(kind)=={'Adt'},'Changed prefix aggregate');owner,variant,union=kind['Adt']
   tag=owner['id']['Adt'];require(owner==adt(tag)['Untagged']['Adt'] and union is None and output==adt(tag),'Changed aggregate nominal type')
   zero_fields={1:[],5:[],6:[adt(13),adt(5)],7:[next(iter(args[0].values()))['ty']] if len(args)==1 else [],3:[adt(6),adt(7),adt(1)],8:[adt(3)]}
   if tag in zero_fields:
    require(variant==(0 if tag==8 else None) and [next(iter(a.values()))['ty'] for a in args]==zero_fields[tag],'Changed zero-return aggregate')
    if tag==7:require(len(args)==1 and self.operand(args[0])=='(.usize 0)','Changed zero capacity')
    return '(.aggregate (some '+str(tag)+') '+('(some false)' if tag==8 else 'none')+' ['+', '.join(self.operand(a) for a in args)+'])'
   require((tag==4 and variant is None and [next(iter(a.values()))['ty'] for a in args]==[USIZE,adt(11)]) or (tag in [14,19] and variant==0 and [next(iter(a.values()))['ty'] for a in args]==[adt(4)]),'Unsupported prefix aggregate variant')
   return '(.aggregate (some '+str(tag)+') '+('none' if variant is None else '(some false)')+' ['+', '.join(self.operand(a) for a in args)+'])'
  if set(rv)=={'BinaryOp'}:
   row=next((r for r in self.parent.rows if r['function']==self.function['def_id'] and r['statement']['id']==statement['id']),None)
   require(row is not None,'Missing prefix arithmetic assignment');return 'expr_'+row['operation']
  require(set(rv)=={'UnaryOp'},'Unsupported prefix rvalue');op,arg=rv['UnaryOp']
  if op in [{'Cast':{'Scalar':[{'UInt':'Usize'},{'UInt':'U64'}]}},{'Cast':{'Scalar':[{'UInt':'U64'},{'UInt':'Usize'}]}}]:
   source,target=op['Cast']['Scalar'];require(set(arg)=={'Copy'} and arg['Copy']['ty']==literal(source) and output==literal(target),'Changed word-width cast');return '(.use '+self.operand(arg)+' false .byte)'
  if output==adt(13):
   require(op=={'Cast':{'Transmute':[adt(11),adt(13)]}} and arg=={'Copy':{'kind':{'Local':40},'ty':adt(11)}},'Changed dangling alignment conversion')
   return '(.enumAddress (.copy 40 [(.unwrap 11),.left]) 12 13)'
  require(output==USIZE and op=={'Cast':{'Transmute':[adt(11),USIZE]}} and arg=={'Copy':{'kind':{'Local':40},'ty':adt(11)}},'Changed alignment transmute')
  return '(.enumWord (.copy 40 [(.unwrap 11),.left]) 12)'
 def code(self,statements,tail):
  code=tail
  for s in reversed(statements):
   k=s['kind'];require(isinstance(k,dict) and len(k)==1,'Unknown prefix statement')
   if 'StorageLive' in k or 'StorageDead' in k:
    key=next(iter(k));idx=k[key];require(isinstance(idx,int) and 0<=idx<self.count,'Unknown prefix storage slot')
    code='(.'+('live' if key=='StorageLive' else 'dead')+' '+str(idx)+' '+code+')'
   else:
    require(set(k)=={'Assign'},'Unsupported layout prefix control');dest,rv=k['Assign'];require(set(dest)=={'kind','ty'} and set(dest['kind'])=={'Local'},'Changed prefix destination')
    idx=dest['kind']['Local'];require(self.locals[idx]['ty']==dest['ty'],'Changed prefix destination type')
    code='(.assign '+str(idx)+' '+self.rvalue(s,rv,dest['ty'])+' '+code+')'
  return code
 def retained(self):return {'function':self.function['def_id'],'initial':self.initial,'overflow_branch':self.outer,'layout_else_prefix':self.check,
  'layout_branch':self.inner,'accepted_prefix':self.accepted_prefix,'zero_size_branch':self.zero_size,'positive_size_branch':self.positive_size,'following':self.following,'byte_layout_global':self.global_layout,
  'claim':'original contiguous scalar prefix with arbitrary overflow, accepted, rejected and following continuations; suffixes and whole constructor execution remain open'}
 def render(self):
  enumty='(.enumeration 12 alignmentDiscriminants)';align='(.record 11 (.pair '+enumty+' (.scalar .unit)))'
  layout='(.record 4 (.pair (.scalar .usize) (.pair '+align+' (.scalar .unit))))'
  lines=['def alignmentDiscriminants : List NativeWord64Memory.Word := ['+', '.join('⟨'+str(2**i)+',by decide⟩' for i in range(64))+']',
   'def byteAlignment : NativeRecordValues.Value := .record 11 (.pair (.enumeration 12 1) (.scalar .unit))',
   'def byteLayout : NativeRecordValues.Value := .record 4 (.pair (.scalar (.usize 1)) (.pair byteAlignment (.scalar .unit)))',
   'def layoutInitialPrefix (next : Body) : Body := '+self.initial_code,
   'def layoutCheckPrefix (next : Body) : Body := '+self.check_code,
   'def layoutPrefix (overflow accepted rejected next : Body) : Body :=',
   '  layoutInitialPrefix (.switchBoolean (.copy 24 []) overflow (layoutCheckPrefix (.switchBoolean (.move 30 []) accepted rejected .done)) next)']
  lines += ['def capacityLayout (capacity : NativeWord64Memory.Word) : NativeRecordValues.Value := .record 4 (.pair (.scalar (.usize capacity)) (.pair byteAlignment (.scalar .unit)))',
   'def acceptedLayoutPrefix (next : Body) : Body := '+self.accepted_code,
   'def zeroSizeBody : Body := '+self.zero_code,
   'def capacityDispatch (zero positive next : Body) : Body := acceptedLayoutPrefix (.switchUsize (.copy 7 []) 0 zero positive next)']
  layout_error='(.record 20 (.scalar .unit))'
  success='(.pair '+layout+' (.scalar .unit))'
  allocator='(.record 1 (.scalar .unit))';marker='(.record 5 (.scalar .unit))'
  pointer='(.record 13 (.pair .nonnull (.scalar .unit)))';unique='(.record 6 (.pair '+pointer+' (.pair '+marker+' (.scalar .unit))))'
  cap='(.record 7 (.pair (.scalar .usize) (.scalar .unit)))'
  raw='(.record 3 (.pair '+unique+' (.pair '+cap+' (.pair '+allocator+' (.scalar .unit)))))'
  lines += ['def allocatorValue : NativeRecordValues.Value := .record 1 (.scalar .unit)',
    'def zeroRawValue : NativeRecordValues.Value := .record 3 (.pair (.record 6 (.pair (.record 13 (.pair (.scalar (.raw ⟨⟨1,none⟩,none⟩)) (.scalar .unit))) (.pair (.record 5 (.scalar .unit)) (.scalar .unit)))) (.pair (.record 7 (.pair (.scalar (.usize 0)) (.scalar .unit))) (.pair allocatorValue (.scalar .unit))))',
    'def zeroResultValue : NativeRecordValues.Value := .record 8 (.choice false (.pair zeroRawValue (.scalar .unit)))']
  known={0:'(.record 8 (.choice (.pair '+raw+' (.scalar .unit)) (ambient.types[0]?.getD (.scalar .unit))))',3:allocator,9:allocator,8:raw,35:unique,36:pointer,51:marker,52:cap,**{i:'(.scalar .usize)' for i in [1,39,28,26,27,23,32,33]},**{i:'.boolean' for i in [21,24,30]},
   25:'(.pair (.scalar .usize) (.pair .boolean (.scalar .unit)))',4:layout,40:align,31:layout,34:layout,6:layout,7:'(.scalar .usize)',22:'(.record 19 (.choice '+success+' (.pair '+layout_error+' (.scalar .unit))))',5:'(.record 14 (.choice '+success+' (ambient.types[5]?.getD (.scalar .unit))))'}
  lines+=['def layoutTypes (ambient : Frame) : List NativeRecordValues.Ty := ['+', '.join(known.get(i,'(ambient.types['+str(i)+']?.getD (.scalar .unit))') for i in range(self.count))+']']
  for label in ['layoutFrame','layoutProductFrame','layoutComparedFrame','layoutAfterFrame','layoutAcceptedFrame']:
   values={1:'(.live (some (.scalar (.usize capacity))))',4:'(.live (some byteLayout))'}
   if label!='layoutFrame':
    values.update({i:'(.live none)' for i in [0,6,13,29,5,22]})
    values.update({21:'(.live (some (.boolean true)))',39:'(.live (some (.scalar (.usize 1))))',40:'(.live (some byteAlignment))',28:'(.live (some (.scalar (.usize capacity))))',24:'(.live (some (.boolean false)))'})
    values.update({i:'.dead' for i in [27,26,25,23]})
   if label in ['layoutComparedFrame','layoutAfterFrame','layoutAcceptedFrame']:
    values.update({i:'.dead' for i in [24,33,32]})
    values[30]='(.live (some (.boolean (decide (capacity.val < 2^63)))))' if label=='layoutComparedFrame' else '(.live (some .uninit))'
   if label=='layoutAcceptedFrame':
    values.update({i:'.dead' for i in [31,30,34,22,28,39,5]})
    values.update({6:'(.live (some (capacityLayout capacity)))',7:'(.live (some (.scalar (.usize capacity))))'})
   lines+=['def '+label+' (ambient : Frame) (capacity : NativeWord64Memory.Word) : Frame :=',
    '  ⟨layoutTypes ambient,['+', '.join(values.get(i,'(ambient.slots['+str(i)+']?.getD .dead)') for i in range(self.count))+'],ambient.world⟩']
  return '\n'.join(lines)+'\n'

def main():
 p=argparse.ArgumentParser(description=__doc__);p.add_argument('llbc',type=Path);p.add_argument('output',type=Path);p.add_argument('--retained',type=Path,required=True);a=p.parse_args()
 r=Reifier(json.loads(a.llbc.read_text()));a.output.write_text(r.render());a.retained.write_text(json.dumps(r.retained(),indent=2)+'\n')
if __name__=='__main__':main()
