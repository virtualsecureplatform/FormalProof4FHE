class CallerPreparation:
 def __init__(self,parent):
  self.parent=parent;self.prefixes={};self.calls={};self.views={}
  for fid,owner,target,length,args,dest in [
   (1,'alloc::vec::with_capacity',2,5,[{'Move':{'kind':{'Local':1},'ty':USIZE}},{'Move':{'kind':{'Local':5},'ty':adt(1)}},{'Copy':{'kind':{'Global':{'id':parent.layout_prefix.global_layout['def_id'],'generics':{'regions':[],'types':[],'const_generics':[],'trait_refs':[]}}},'ty':adt(4)}}],3),
   (2,'alloc::raw_vec::with_capacity_in',3,6,[{'Copy':{'kind':{'Local':1},'ty':USIZE}},{'Move':{'kind':{'Local':14},'ty':adt(10)}},{'Move':{'kind':{'Local':2},'ty':adt(1)}},{'Copy':{'kind':{'Local':3},'ty':adt(4)}}],4)]:
   f=parent.functions[fid];require(name(f)==owner and f['item_meta']['opacity']=='Transparent','Changed constructor caller owner')
   body=f['body']['Structured']['body']['statements'];require(set(body[length]['kind'])=={'Call'},'Missing constructor call')
   call=body[length]['kind']['Call'];require(set(call)=={'call','on_unwind'},'Unknown caller call effects')
   callee=parent.functions[target];require(callee['item_meta']['opacity']=='Transparent' and callee['signature']=={'is_unsafe':False,'abi':'Rust','is_variadic':False,'inputs':[USIZE,adt(1),adt(4)] if target==2 else [USIZE,adt(10),adt(1),adt(4)],'output':adt(3) if target==2 else adt(8)},'Changed constructor callee signature')
   require(call['call']=={'func':{'Regular':{'kind':{'Fun':{'Regular':target}},'generics':{'regions':[],'types':[],'const_generics':[],'trait_refs':[]}}},'args':args,'dest':{'kind':{'Local':dest},'ty':callee['signature']['output']}},'Changed constructor call arguments or target')
   view=copy.copy(parent.layout_prefix);view.function=f;view.locals=f['body']['Structured']['locals']['locals'];view.count=len(view.locals)
   self.prefixes[fid]=view.code(body[:length],'next');self.calls[fid]=call;self.views[fid]=view
  t=parent.layout_prefix.types[10]
  require(name(t)=='alloc::raw_vec::AllocInit' and t['item_meta']['opacity']=='Transparent' and [(v['id'],v['name'],v['fields'],v['discriminant']) for v in t['kind']['Enum']]==[(0,'Uninitialized',[],{'Scalar':{'Signed':['Isize','0']}}),(1,'Zeroed',[],{'Scalar':{'Signed':['Isize','1']}})],'Changed allocation initialization variants')
  types=parent.layout_prefix.types
  require([(f['name'],f['ty']) for f in types[0]['kind']['Struct']]==[('buf',adt(2)),('len',USIZE)] and [(f['name'],f['ty']) for f in types[2]['kind']['Struct']]==[('inner',adt(3)),('_marker',adt(5))],'Changed Vec wrappers')
  layout=runpy.run_path(str(ROOT/'scripts/reify-hasteboots-rawvec-fields'))['layout']
  require(types[0]['layout']==layout(24,8,[0,16]) and types[2]['layout']==layout(16,8,[0,16]),'Changed Vec wrapper layout')
  vb=parent.functions[1]['body']['Structured']['body']['statements'];require(vb[-1]['kind']=='Return','Missing Vec caller return')
  self.vec_tail=self.views[1].code(vb[6:-1],'.ret')
  root=parent.functions[0];rb=root['body']['Structured']['body']['statements']
  require(parent.functions[1]['signature']==root['signature'] and set(rb[3]['kind'])=={'Call'} and rb[-1]['kind']=='Return','Changed root call shape')
  call=rb[3]['kind']['Call'];require(set(call)=={'call','on_unwind'} and call['call']=={'func':{'Regular':{'kind':{'Fun':{'Regular':1}},'generics':{'regions':[],'types':[],'const_generics':[],'trait_refs':[]}}},'args':[{'Move':{'kind':{'Local':2},'ty':USIZE}}],'dest':{'kind':{'Local':0},'ty':adt(0)}},'Changed root call')
  view=copy.copy(parent.layout_prefix);view.function=root;view.locals=root['body']['Structured']['locals']['locals'];view.count=len(view.locals)
  self.root_prefix=view.code(rb[:3],'next');self.root_tail=view.code(rb[4:-1],'.ret')
  self.raw_tail=self.tail_code(parent.functions[2]['body']['Structured']['body']['statements'][7:])
 def tail_code(self,statements,tail='.done'):
  code=tail;view=self.views[2]
  for statement in reversed(statements):
   k=statement['kind']
   if k=='Return':require(code=='.done','Nonterminal caller return');code='.ret'
   elif isinstance(k,dict) and set(k)=={'Switch'}:
    switch=k['Switch']
    if set(switch)=={'Match'}:
     place,arms,otherwise=switch['Match'];require(place=={'kind':{'Local':4},'ty':adt(8)} and len(arms)==2 and arms[0][0]==[0] and arms[1][0]==[1] and not arms[0][1]['statements'] and otherwise is None,'Changed caller Result dispatch')
     code='(.matchChoice 4 [] 8 .done error '+code+')'
    elif set(switch)=={'If'}:
     test,yes,no=switch['If'];require(test=={'Const':{'kind':{'Literal':{'Bool':False}},'ty':BOOL}} and len(yes['statements'])==1 and not no['statements'],'Changed cold assertion dispatch')
     code='(.constIf false cold .done '+code+')'
    else:
     require(set(switch)=={'SwitchInt'},'Unsupported caller switch');test,width,arms,otherwise=switch['SwitchInt']
     require(test=={'Copy':{'kind':{'Local':11},'ty':USIZE}} and width=={'UInt':'Usize'} and len(arms)==1 and arms[0][0]==[{'Scalar':{'Unsigned':['Usize','0']}}] and otherwise is not None,'Changed caller element-size dispatch')
     code='(.switchUsize (.copy 11 []) 0 '+self.tail_code(arms[0][1]['statements'])+' '+self.tail_code(otherwise['statements'])+' '+code+')'
   elif isinstance(k,dict) and set(k)=={'Assert'}:
    a=k['Assert'];require(set(a)=={'assert','on_failure','on_unwind'} and a['assert']=={'cond':{'Copy':{'kind':{'Local':5},'ty':BOOL}},'expected':True,'check_kind':None} and a['on_failure']=='UndefinedBehavior' and [s['kind'] for s in a['on_unwind']['statements']]==['UnwindResume'],'Changed caller assumption')
    code='(.switchBoolean (.copy 5 []) '+code+' .abort .done)'
   else:code=view.code([statement],code)
  return code
