class PositivePreparation:
 def __init__(self,parent):
  layout=parent.layout_prefix;source=layout.positive_size['statements']
  require(len(source)==4 and source[0]['kind']=={'StorageDead':7} and source[1]['kind']=={'StorageLive':10} and set(source[2]['kind'])=={'Switch'} and set(source[2]['kind']['Switch'])=={'Match'},'Changed positive source prefix')
  place,arms,otherwise=source[2]['kind']['Switch']['Match']
