#!/usr/bin/env python3
"""Check runtime-query specialization against explicit rustc configurations."""
import argparse
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
BASE = runpy.run_path(str(ROOT / 'scripts/check-hasteboots-inline-equivalence'))
RANGES = runpy.run_path(str(ROOT / 'scripts/probe-hasteboots-u32-ranges'))
BUILD, PARAMETERS, COMMON, digest = BASE['BUILD'], BASE['PARAMETERS'], BASE['COMMON'], BASE['digest']
DATA = ROOT / 'interop/aeneas/runtime-checks'
CASES = {
    'on': (['-C', 'debug-assertions=yes'], 'OnGenerated.lean'),
    'off': (['-C', 'debug-assertions=no'], 'OffGenerated.lean'),
    'override': (['-C', 'debug-assertions=yes', '-Z', 'ub-checks=no', '-C', 'overflow-checks=yes'], 'OverrideGenerated.lean')}
PROOFS = [case + '_' + name for case in CASES for name in ['checks', 'guarded']]


def validate_output(raw, case):
    PARAMETERS['verify_snapshot'](raw, (DATA / CASES[case][1]).read_text())
    PARAMETERS['validate_proof_source']((DATA / 'Proof.lean').read_text(), PROOFS)
    return RANGES['validate_output'](raw, 'hasteboots_runtime_checks_' + case, ['checks', 'guarded'])


def validate_ir(ir, evaluated):
    BASE['BASE']['BASE']['validate_ir'](ir)
    options = ir['translated'].get('options', {})
    if options.get('monomorphize') is not True or options.get('mir') != 'Optimized':
        raise RuntimeError('Expected monomorphic optimized MIR')
    if options.get('evaluate_runtime_checks') is not evaluated:
        raise RuntimeError('Wrong runtime-query evaluation policy')
    found = []
    def visit(value):
        if isinstance(value, dict):
            op = value.get('NullaryOp')
            if isinstance(op, list) and op and op[0] in ['UbChecks', 'OverflowChecks', 'ContractChecks']:
                found.append(op[0])
            for child in value.values(): visit(child)
        elif isinstance(value, list):
            for child in value: visit(child)
    visit(ir['translated'])
    if evaluated and found: raise RuntimeError('Unevaluated runtime query')
    if not evaluated and not {'UbChecks', 'OverflowChecks'} <= set(found):
        raise RuntimeError('Missing default-policy runtime queries')
    return found


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True)
    parser.add_argument('--backend', type=Path, required=True)
    args = parser.parse_args()
    parent = ROOT / 'build/hasteboots-extraction'; parent.mkdir(parents=True, exist_ok=True)
    out = Path(tempfile.mkdtemp(prefix='runtime-checks-', dir=parent))
    record = {'status': 'started', 'claim': 'compiler configuration regression only; compiler/native heap/work/security unproved',
              'script_sha256': digest(Path(__file__).read_bytes()), 'commands': []}
    def save(): (out / 'manifest.json').write_text(json.dumps(record, indent=2) + '\n')
    def run(command, log, required=True):
        record['commands'].append([str(x) for x in command]); save()
        with (out / log).open('w') as stream:
            status = subprocess.run([str(x) for x in command], cwd=ROOT, stdout=stream, stderr=subprocess.STDOUT).returncode
        if required and status: raise RuntimeError(log + ' exited ' + str(status))
        return status
    print('Runtime check artifacts: ' + str(out), flush=True); save()
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        record['backend_patches'] = PARAMETERS['verify_backend'](args.backend.resolve(), out)
        files = ['fixture.rs', 'Proof.lean', *[row[1] for row in CASES.values()]]
        record['inputs'] = {name: digest((DATA / name).read_bytes()) for name in files}
        options = ['-backend', 'lean', '-checks', '-sequential', '-max-heartbeats', '200000', '-max-recdepth', '1000',
                   '-abort-on-error', '-no-external-name-patterns', '-disambiguate-instantiated-names', '-monomorphic-builtin-shapes']
        runtime = 'import Aeneas.Std\n'
        names = []
        record['cases'] = {}
        def extract(case, evaluated=True):
            name = case if evaluated else case + '-default'
            llbc = out / (name + '.llbc')
            run([tools / 'charon', 'rustc', '--preset=aeneas', '--monomorphize', '--mir', 'optimized',
                 *(['--evaluate-runtime-checks'] if evaluated else []), '--dest-file', llbc,
                 '--', '--crate-type', 'lib', '--edition', '2024', '--crate-name', 'hasteboots_runtime_checks_' + case,
                 *CASES[case][0], (DATA / 'fixture.rs').relative_to(ROOT)], name + '-charon.log')
            queries = validate_ir(json.loads(llbc.read_text()), evaluated)
            return llbc, name, queries
        for case in CASES:
            llbc, name, _ = extract(case)
            run([tools / 'aeneas', *options, '-dest', out / name, llbc], name + '-frontend.log')
            BASE['BASE']['validate_frontend_log']((out / (name + '-frontend.log')).read_text())
            generated = list((out / name).glob('*.lean'))
            if len(generated) != 1: raise RuntimeError('Expected complete runtime-query module')
            raw = generated[0].read_text()
            runtime += validate_output(raw, case) + '\n'
            names += ['hasteboots_runtime_checks_' + case + '.' + n for n in ['checks', 'guarded']]
            record['cases'][case] = {'rustc_flags': CASES[case][0], 'llbc_sha256': digest(llbc.read_bytes()),
                                     'generated_sha256': digest(raw.encode()), 'residual_runtime_queries': []}
        names += ['HasteBootsRuntimeChecksProof.' + n for n in PROOFS]
        checked = out / 'Checked.lean'
        checked.write_text(runtime + '\n' + (DATA / 'Proof.lean').read_text()
                           + ''.join('\n#print axioms ' + n + '\n' for n in names))
        run([ROOT / 'scripts/in-container', 'bash', '-euc', 'cd -- "$1"; lake env lean -DwarningAsError=true "$2"', '_',
             COMMON['container_path'](args.backend.resolve() / 'backends/lean'), COMMON['container_path'](checked)], 'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out / 'lean.log').read_text(), names)
        record['checked_sha256'] = digest(checked.read_bytes())
        llbc, name, queries = extract('on', False)
        status = run([tools / 'aeneas', *options, '-dest', out / name, llbc], name + '-frontend.log', False)
        log = (out / (name + '-frontend.log')).read_text()
        if status == 0 or 'Unsupported operation: ub_checks<bool>' not in log:
            raise RuntimeError('Default query policy unexpectedly accepted')
        record['default_policy_queries'] = queries
        if record['inputs'] != {name: digest((DATA / name).read_bytes()) for name in files}:
            raise RuntimeError('Input changed during check')
        BUILD['verify_receipt'](args.build_receipt)
        record['status'] = 'passed'; print('Runtime checks passed: 12 dependency audits; default policy rejection retained')
    except (Exception, SystemExit) as error:
        record.update(status='failed', error=str(error)); raise SystemExit('Runtime check failed; inspect ' + str(out) + ': ' + str(error)) from error
    finally:
        record['logs'] = {p.name: digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__':
    main()
