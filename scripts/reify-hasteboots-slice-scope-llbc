#!/usr/bin/env python3
"""Retain original unit-returning slice scope bodies; add only the unit aggregate."""
import argparse
import json
from pathlib import Path
import runpy

BASE = runpy.run_path(str(Path(__file__).resolve().parent / 'reify-hasteboots-slice-reference-llbc'))
require = BASE['require']


class Reifier(BASE['Reifier']):
    def rvalue(self, value, fid):
        if isinstance(value, dict) and set(value) == {'Aggregate'}:
            require(value['Aggregate'] == [{'Adt': [{'id': 'Tuple', 'generics': {'regions': [], 'types': [], 'const_generics': [], 'trait_refs': []}}, None, None]}, []],
                    'Only the exact empty tuple aggregate is supported')
            return '.unit', ('unit',)
        return super().rvalue(value, fid)

    def render(self, roots=(0, 1)):
        original = super().render(roots)
        # Only the Lean namespace differs; source nodes use the parent reifier unchanged.
        return original.replace('public import FormalProof4FHE.HasteBoots.NativeSliceLLBC', 'public import FormalProof4FHE.HasteBoots.NativeReferenceCleanup').replace('namespace HasteBootsSliceReferenceBody\n', 'namespace HasteBootsSliceScopeBody\n').replace('end HasteBootsSliceReferenceBody\n', 'end HasteBootsSliceScopeBody\n')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('llbc', type=Path)
    parser.add_argument('output', type=Path)
    parser.add_argument('--retained', type=Path, required=True)
    args = parser.parse_args()
    r = Reifier(json.loads(args.llbc.read_text()))
    args.output.write_text(r.render())
    args.retained.write_text(json.dumps({'active_functions': r.records, 'inactive_unsupported': r.retained,
                                       'claim': 'unit slice source bodies plus explicit checked scope cleanup; Rust lifetime and compiler refinement unproved'}, indent=2) + '\n')


if __name__ == '__main__': main()
