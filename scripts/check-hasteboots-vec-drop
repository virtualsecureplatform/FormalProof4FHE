#!/usr/bin/env python3
"""Check original Vec drop control flow and its total source execution; native ABI/compiler and helper refinement remain open."""
import argparse
import copy
import hashlib
import json
from pathlib import Path
import re
import runpy
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT/'interop/aeneas/vec-drop'
BUILD = runpy.run_path(str(ROOT/'scripts/build-hasteboots-inline-tools'))
PARAMETERS = runpy.run_path(str(ROOT/'scripts/extract-hasteboots-parameters'))
PARENT = runpy.run_path(str(ROOT/'scripts/check-hasteboots-allocator-caller'))
REIFIER = runpy.run_path(str(ROOT/'scripts/reify-hasteboots-vec-drop'))
INCLUDES = ['alloc::raw_vec','alloc::vec','alloc::alloc','core::alloc::layout',
            'core::ptr::unique','core::ptr::non_null','core::mem::alignment','core::ptr::drop_in_place']


def digest(raw): return hashlib.sha256(raw).hexdigest()


def inventory():
    names=PARENT['inventory']()
    raw=(ROOT/'FormalProof4FHE/HasteBoots/NativeRecordDropCalls.lean').read_text()
    PARAMETERS['validate_proof_source'](raw,re.findall(r'^theorem (\w+)',raw,re.M))
    local=re.findall(r'^(?:def|theorem|structure|inductive) ([\w.]+)',raw,re.M)
    local+=['Code.'+n for n in ['scope','done','native','call','loop']]
    names+=['FormalProof4FHE.HasteBoots.NativeRecordDropCalls.'+n for n in local]
    for file in ['Generated.lean','LoopProof.lean','Execution.lean','Proof.lean']:
        raw=(DATA/file).read_text();PARAMETERS['validate_proof_source'](raw,re.findall(r'^theorem (\w+)',raw,re.M))
        namespace=''
        for line in raw.splitlines():
            if line.startswith('namespace '):namespace=line.split()[1]
            match=re.match(r'^(?:def|theorem) (\w+)',line)
            if match:names.append(namespace+'.'+match[1])
    return names


def negatives(ir):
    records=runpy.run_path(str(ROOT/'scripts/check-hasteboots-rawvec-drop'))['negatives'](ir)
    base=REIFIER['Reifier'](ir)
    def statements(c,fid):return c['fun_decls'][fid]['body']['Structured']['body']['statements']
    def assigned(c,index,fid=None):return next(s['kind']['Assign'][1] for s in statements(c,base.vec_method if fid is None else fid)
        if isinstance(s['kind'],dict) and 'Assign' in s['kind'] and s['kind']['Assign'][0]['kind']=={'Local':index})
    def parts(c):return next(s['kind']['Call'] for s in statements(c,base.vec_method) if isinstance(s['kind'],dict) and 'Call' in s['kind'])
    def check(label,mutation):
        changed=copy.deepcopy(ir);mutation(changed['translated'])
        try:REIFIER['Reifier'](changed).render()
        except (ValueError,KeyError,TypeError,IndexError) as error:records[label]=str(error)
        else:raise RuntimeError('Negative accepted: '+label)
    check('vec_receiver_shared',lambda c:c['fun_decls'][base.entry]['signature']['inputs'][0]['Untagged']['Ref'].__setitem__(2,'Shared'))
    check('vec_layout_size',lambda c:c['type_decls'][base.vector['def_id']]['layout'][0]['value'].update(size=16))
    check('vec_length_offset',lambda c:c['type_decls'][base.vector['def_id']]['layout'][0]['value']['variant_layouts'][0]['field_offsets'].__setitem__(1,8))
    check('vec_buf_type',lambda c:c['type_decls'][base.vector['def_id']]['kind']['Struct'][0].update(ty=REIFIER['SPEC']['USIZE']))
    check('vec_length_field',lambda c:assigned(c,4)['Use'][0]['Copy']['kind']['Projection'][1]['Field'].__setitem__(1,0))
    check('vec_length_owner',lambda c:assigned(c,4)['Use'][0]['Copy']['kind']['Projection'][1]['Field'][0]['Adt'].__setitem__(0,base.rawvec['def_id']))
    check('vec_read_flag',lambda c:assigned(c,4)['Use'].__setitem__(1,'No'))
    check('vec_read_dereference',lambda c:assigned(c,4)['Use'][0]['Copy']['kind']['Projection'][0].update(kind={'Local':1}))
    check('vec_pointer_cast',lambda c:assigned(c,3)['UnaryOp'][0]['Cast']['Transmute'].__setitem__(1,REIFIER['SPEC']['USIZE']))
    check('vec_slice_metadata',lambda c:assigned(c,6)['Ref'].update(ptr_metadata={'Const':{}}))
    check('vec_slice_borrow_shared',lambda c:assigned(c,6)['Ref'].update(kind='Shared'))
    check('vec_parts_kind',lambda c:parts(c)['call']['func']['Regular']['kind']['Fun']['Builtin'].update(PtrFromParts='Shared'))
    check('vec_parts_generic',lambda c:parts(c)['call']['func']['Regular']['generics']['types'].__setitem__(0,REIFIER['U8']))
    check('vec_literal_type',lambda c:parts(c)['call']['args'].__setitem__(1,{'Const':{'kind':{'Literal':{'Scalar':{'Unsigned':['Usize','0']}}},'ty':REIFIER['SPEC']['UNIT']}}))
    check('vec_literal_overflow',lambda c:parts(c)['call']['args'].__setitem__(1,{'Const':{'kind':{'Literal':{'Scalar':{'Unsigned':['Usize',str(2**64)]}}},'ty':REIFIER['SPEC']['USIZE']}}))
    check('vec_parts_arity',lambda c:parts(c)['call']['args'].pop())
    check('vec_parts_unwind',lambda c:parts(c)['on_unwind']['statements'][0].update(kind={'Abort':'UnwindTerminate'}))
    check('vec_glue_borrow_metadata',lambda c:assigned(c,2,base.vec_glue)['Ref'].update(ptr_metadata={'Const':{}}))
    check('vec_glue_rawvec_field',lambda c:assigned(c,6,base.vec_glue)['Ref']['place']['kind']['Projection'][1]['Field'].__setitem__(1,1))
    check('slice_glue_class',lambda c:c['fun_decls'][base.slice_glue]['item_meta'].update(opacity='Transparent'))
    check('slice_glue_metadata',lambda c:assigned(c,2,base.slice_glue)['Ref'].update(ptr_metadata={'Const':{}}))
    check('loop_class',lambda c:c['fun_decls'][base.loop_id]['item_meta'].update(opacity='Foreign'))
    check('loop_signature_safety',lambda c:c['fun_decls'][base.loop_id]['signature'].update(is_unsafe=False))
    check('loop_unknown_statement',lambda c:statements(c,base.loop_id)[0].update(hidden_effect='Drop'))
    check('loop_unbound_region',lambda c:c['fun_decls'][base.loop_id]['body']['Structured']['locals']['locals'][1]['ty']['Untagged']['Ref'].__setitem__(0,{'Body':99}))
    return records


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build-receipt', type=Path, required=True); args = parser.parse_args()
    out = Path(tempfile.mkdtemp(prefix='vec-drop-', dir=ROOT/'build/hasteboots-extraction'))
    record = {'status':'started','commands':[], 'deallocation_caller_interpreted':True, 'current_memory_root_interpreted':True, 'helper_bodies_interpreted':False, 'rawvec_cleanup_body_interpreted':True,'outer_vec_destruction_interpreted':True,'unbounded_byte_loop_relation':True,'total_concrete_source_executor':True,'execution_relation_deterministic':True,'explicit_call_preparation_scope_cleanup':True,
              'native_carrier_validity_proved':False, 'physical_niche_decoded':False, 'native_lifetime_refinement':False,
              'physical_work_refinement':False, 'final_security_theorem':False}
    def save(): (out/'manifest.json').write_text(json.dumps(record,indent=2)+'\n')
    def run(command, log):
        record['commands'].append([str(x) for x in command]); save()
        with (out/log).open('w') as stream:
            result = subprocess.run([str(x) for x in command],cwd=ROOT,stdout=stream,stderr=subprocess.STDOUT)
        if result.returncode: raise RuntimeError('Command failed: '+log)
    print('Vec drop artifacts: '+str(out), flush=True)
    try:
        _, tools, _ = BUILD['verify_receipt'](args.build_receipt)
        record['build_receipt_sha256'] = digest(args.build_receipt.read_bytes())
        files = [Path(__file__), ROOT/'scripts/reify-hasteboots-vec-drop',
                 ROOT/'scripts/reify-hasteboots-rawvec-drop',ROOT/'scripts/check-hasteboots-rawvec-drop',ROOT/'scripts/reify-hasteboots-byte-loop-llbc',ROOT/'scripts/reify-hasteboots-slice-reference-llbc',ROOT/'scripts/check-hasteboots-byte-drop-primitives',ROOT/'scripts/reify-hasteboots-rawvec-deallocation',ROOT/'scripts/check-hasteboots-rawvec-deallocation',ROOT/'scripts/reify-hasteboots-rawvec-current-memory',ROOT/'scripts/reify-hasteboots-rawvec-reference',ROOT/'scripts/reify-hasteboots-variant-body',
                 ROOT/'scripts/reify-hasteboots-allocator-caller',ROOT/'scripts/reify-hasteboots-rawvec-option',
                 ROOT/'scripts/reify-hasteboots-global-deallocation',ROOT/'scripts/reify-hasteboots-rawvec-fields',
                 ROOT/'scripts/check-hasteboots-allocator-caller',
                 ROOT/'scripts/specify-hasteboots-deallocation-boundary',
                 ROOT/'scripts/extract-hasteboots-parameters',ROOT/'lean-toolchain',
                 *[DATA/n for n in ['fixture.rs','Generated.lean','Retained.json','LoopProof.lean','Execution.lean','Proof.lean','Smoke.lean','ExecutionSmoke.lean']],
                 *[ROOT/('FormalProof4FHE/HasteBoots/'+n+'.lean') for n in ['NativeByteLoopLLBC','NativeByteDropTraversal','NativeReferenceCleanup','NativeVecReference','NativeRecordDropCalls','NativeRawVecFields','NativeRawVecReference','NativeRawVecBorrow','NativeRawVecMutBorrow','NativeRecordLLBC','NativeRecordValues']],
                 *[ROOT/('FormalProof4FHETest/HasteBootsRawVec'+kind+n+'.lean') for kind in ['Borrow','MutBorrow'] for n in ['Smoke','Audit']],
                 *[ROOT/('FormalProof4FHETest/HasteBoots'+kind+n+'.lean') for kind in ['VecReference','RecordDropCalls'] for n in ['Smoke','Audit']]]
        record['inputs'] = {str(p.relative_to(ROOT)):digest(p.read_bytes()) for p in files}
        run([ROOT/'scripts/in-container','lake','build','FormalProof4FHETest.HasteBootsRawVecBorrowSmoke',
             'FormalProof4FHETest.HasteBootsRawVecBorrowAudit','FormalProof4FHETest.HasteBootsRawVecMutBorrowSmoke',
             'FormalProof4FHETest.HasteBootsRawVecMutBorrowAudit','FormalProof4FHETest.HasteBootsVecReferenceSmoke','FormalProof4FHETest.HasteBootsVecReferenceAudit','FormalProof4FHETest.HasteBootsRecordDropCallsSmoke','FormalProof4FHETest.HasteBootsRecordDropCallsAudit'],'root-build.log')
        llbc = out/'source.llbc'
        command = [tools/'charon','rustc','--preset=aeneas','--sysroot','default','--monomorphize','--mir','optimized',
                   '--consts','values','--evaluate-runtime-checks','--precise-drops','--desugar-drops','--preserve-allocator','--no-dedup-serialized-ast']
        for include in INCLUDES: command += ['--include',include]
        command += ['--dest-file',llbc,'--','--crate-type','lib','--edition','2024','-Cdebug-assertions=no',
                    '--crate-name','hasteboots_rawvec_cleanup',(DATA/'fixture.rs').relative_to(ROOT)]
        run(command,'charon.log'); ir = json.loads(llbc.read_text()); reifier = REIFIER['Reifier'](ir)
        generated = reifier.render()
        if generated != (DATA/'Generated.lean').read_text() or reifier.retained() != json.loads((DATA/'Retained.json').read_text()):
            raise RuntimeError('Retained source schema/target metadata differs')
        record['negative_controls'] = negatives(ir)
        names = inventory()
        checked = out/'Checked.lean'
        checked.write_text(generated+'\n'+(DATA/'LoopProof.lean').read_text()+'\n'+(DATA/'Execution.lean').read_text()+'\n'+(DATA/'Proof.lean').read_text()+'\n'+(DATA/'Smoke.lean').read_text()+'\n'+(DATA/'ExecutionSmoke.lean').read_text()+
                           ''.join('\n#print axioms '+name+'\n' for name in names))
        run([ROOT/'scripts/in-container','lake','env','lean','-DwarningAsError=true',checked.relative_to(ROOT)],'lean.log')
        record['dependency_audit'] = PARAMETERS['audit_log']((out/'lean.log').read_text(),names)
        changed=copy.deepcopy(ir)
        block=changed['translated']['fun_decls'][reifier.vec_method]['body']['Structured']['body']['statements']
        parts=next(s['kind']['Call']['call'] for s in block if isinstance(s['kind'],dict) and 'Call' in s['kind'])
        parts['args'][1]={'Const':{'kind':{'Literal':{'Scalar':{'Unsigned':['Usize','0']}}},'ty':REIFIER['SPEC']['USIZE']}}
        changed_generated=REIFIER['Reifier'](changed).render()
        code_only=lambda raw:re.sub(r'^--.*$','',raw,flags=re.M)
        if code_only(changed_generated)==code_only(generated):raise RuntimeError('Changed slice extent ignored')
        test=out/'ZeroSlice.lean'
        smoke=(DATA/'Smoke.lean').read_text().split('syntax "run_vec_rejected"')[0].replace('nextTag = 15','nextTag = 9')+'end HasteBootsVecDrop.Smoke\n'
        test.write_text(changed_generated+'\n'+(DATA/'LoopProof.lean').read_text()+'\n'+(DATA/'Execution.lean').read_text()+'\n'+(DATA/'Proof.lean').read_text()+'\n'+smoke+'\n'+(DATA/'ExecutionSmoke.lean').read_text())
        run([ROOT/'scripts/in-container','lake','env','lean','-DwarningAsError=true',test.relative_to(ROOT)],'zero-slice.log')
        record['supported_slice_extent_mutation']='changing byte-slice extent to zero changes generated code, retains deallocation and removes six iteration loans in the three-byte example'
        record['llbc_sha256'] = digest(llbc.read_bytes()); record['checked_sha256'] = digest(checked.read_bytes())
        if record['inputs'] != {str(p.relative_to(ROOT)):digest(p.read_bytes()) for p in files}: raise RuntimeError('Inputs changed during validation')
        BUILD['verify_receipt'](args.build_receipt); record['status'] = 'passed'
        print('Vec drop passed: '+str(len(names))+' audits; '+str(len(record['negative_controls']))+' rejecting controls')
    except Exception as error:
        record.update(status='failed',error=str(error)); raise SystemExit(str(error)+'; inspect '+str(out)) from error
    finally:
        record['logs'] = {p.name:digest(p.read_bytes()) for p in out.glob('*.log')}; save()


if __name__ == '__main__': main()
